---
/**
 * 6 Bespoke Primary Pillar Hub Layouts (/travel/, /live/, /business/, /places/, /culture/, /atlas/)
 * Each pillar has its own distinctive, benchmark-modeled layout architecture:
 * - /travel/   : GOV.UK 4-Stage Chronological Arrival Matrix + High-Contrast Show-to-Local SOS Strip + 3-Card Survival Deck
 * - /live/     : Stripe Atlas 3-Track Persona Pathways + Nomad List 4-City Cost & Livability Matrix
 * - /business/ : Bloomberg/Sift 4-Desk Regulatory Bar + 7:5 Canton Fair Feature & 4-Step Sourcing Protocol
 * - /places/   : Lonely Planet 5-City Asymmetric Bento Photo Grid + Interactive Layer Map + 5 Macro-Regions Strip
 * - /culture/  : Monocle/Artikle 7:5 Magazine Feature Spread + Interactive Mandarin Audio Soundboard Strip
 * - /atlas/    : The Economist 4-KPI Macro Briefing Deck + Myths vs. Verified Reality Dual-Column Decoder + Master Index
 */
import BaseShell from './BaseShell.astro';
import Badge from '@ui/data-display/Badge.astro';
import type { PillarConfig } from '@data/paradigm-e/pillars';
import { V32_PILLAR_BY_ID, type V32PillarId } from '@data/taxonomy-v32';
import { PILLAR_VISUALS } from '@data/pillar-visuals';
import { LIVE_PULSE_REPORTS } from '@data/paradigm-e/collections';
import { getGuidesByPillar } from '@data/paradigm-e/guides';
import { ARCHETYPE_LABELS, PULSE_STATUS_LABELS, PULSE_ZH_MAP } from '@data/paradigm-e/i18n-zh';
import { getPublicPosts } from '@lib/cms';
import { postPath } from '@lib/format';
import { getLocaleFromContext, localePath } from '@i18n/ui';
import '../styles/article.css';
import '../styles/hub-v32.css';
import '../styles/pillars-bespoke.css';

interface Props {
  pillar: PillarConfig;
}

const { pillar } = Astro.props;
const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (p: string) => localePath(p, locale);

const v32Id: V32PillarId = pillar.id === 'visit' ? 'travel' : (pillar.id as V32PillarId);
const v32Pillar = V32_PILLAR_BY_ID[v32Id];
const visual = PILLAR_VISUALS[v32Id];
const navSections = v32Pillar.children.filter((c) => c.inDropdown);
const hubOnlySections = v32Pillar.children.filter((c) => !c.inDropdown);

const pillarGuides = getGuidesByPillar(pillar.id).slice(0, 5);
const recentPulse = LIVE_PULSE_REPORTS.slice(0, 3);
const cmsFeed = await getPublicPosts({ limit: 4, locale }).catch(() => ({ entries: [] as never[] }));
const cmsEntries = cmsFeed.entries ?? [];
---
<BaseShell
  title={isZh ? visual.h1Zh : visual.h1En}
  description={isZh ? visual.leadZh : visual.leadEn}
  activePillar={v32Pillar.id}
  persona={v32Pillar.persona}
>
  <div class="container">
    <div class="v32-shell">
      {/* Unified 2:1 Hero Banner */}
      <figure class="v32-hero-banner">
        <div class="v32-hero-frame">
          <img
            src={visual.heroImage}
            alt={isZh ? visual.heroAltZh : visual.heroAltEn}
            loading="eager"
            decoding="async"
          />
        </div>
      </figure>

      {/* Unboxed Editorial Header + Single Primary CTA */}
      <header class="v32-pillar-head">
        <div class="v32-pillar-copy">
          <h1>{isZh ? visual.h1Zh : visual.h1En}</h1>
          <p class="v32-lead">{isZh ? visual.leadZh : visual.leadEn}</p>
        </div>
        <div class="v32-pillar-cta">
          <a href={lp(visual.ctaHref)} class="v32-tool-cta">
            {isZh ? visual.ctaZh : visual.ctaEn}
          </a>
        </div>
      </header>

      {/* ====================================================================
          BESPOKE LAYOUT 01: /travel/ (GOV.UK 4-Stage Timeline + Dark SOS Strip)
          ==================================================================== */}
      {v32Id === 'travel' && (
        <>
          <section class="p-travel-stages" aria-labelledby="travel-stages-h">
            <div class="v32-block-head">
              <h2 id="travel-stages-h">{isZh ? '按行程阶段通关' : 'Step-by-Step by Trip Stage'}</h2>
              <a href={lp('/journeys/')} class="v32-more-link">
                {isZh ? '打开 7 步交互清单 →' : 'Interactive 7-step checklist →'}
              </a>
            </div>

            <div class="p-travel-stage-grid">
              <div class="p-travel-stage-card">
                <div>
                  <span class="p-travel-stage-num">{isZh ? '阶段 01 · 起飞前 72h' : 'STAGE 01 · 72H PRE-FLIGHT'}</span>
                  <h3 class="p-travel-stage-title">{isZh ? '免签、绑卡与联网' : 'Visa, Pay & eSIM'}</h3>
                  <p class="p-travel-stage-sub">
                    {isZh ? '出发前完成护照免签核对、支付宝/微信绑外卡与漫游 eSIM 激活。' : 'Confirm visa-free eligibility, bind foreign Visa/MC, and install roaming eSIM.'}
                  </p>
                </div>
                <ul class="p-travel-stage-links">
                  <li><a href={lp('/travel/visas-entry/')}><span>{isZh ? '签证与入境' : 'Visas & Entry'}</span><span>→</span></a></li>
                  <li><a href={lp('/travel/payments-money/')}><span>{isZh ? '支付与货币' : 'Payments & Money'}</span><span>→</span></a></li>
                  <li><a href={lp('/travel/esim-apps-fixes/')}><span>{isZh ? '联网、App 与报错' : 'eSIM, Apps & Fixes'}</span><span>→</span></a></li>
                </ul>
              </div>

              <div class="p-travel-stage-card">
                <div>
                  <span class="p-travel-stage-num">{isZh ? '阶段 02 · 落地首日' : 'STAGE 02 · DAY 1 ARRIVAL'}</span>
                  <h3 class="p-travel-stage-title">{isZh ? '通关、进城与入住' : 'Entry, Rail & Hotel'}</h3>
                  <p class="p-travel-stage-sub">
                    {isZh ? '填写数字入境卡、刷外卡进地铁，并在入住 24 小时内完成住宿登记。' : 'Fill arrival card, tap into airport metro, and complete 24h hotel registration.'}
                  </p>
                </div>
                <ul class="p-travel-stage-links">
                  <li><a href={lp('/documents/arrival-card/')}><span>{isZh ? '入境卡逐栏图解' : 'Arrival Card Guide'}</span><span>→</span></a></li>
                  <li><a href={lp('/travel/hotels-stays/')}><span>{isZh ? '酒店与 24h 住宿登记' : 'Hotels & Registration'}</span><span>→</span></a></li>
                  <li><a href={lp('/travel/getting-around/')}><span>{isZh ? '机场快轨与市内交通' : 'Airport & Metro'}</span><span>→</span></a></li>
                </ul>
              </div>

              <div class="p-travel-stage-card">
                <div>
                  <span class="p-travel-stage-num">{isZh ? '阶段 03 · 在途探索' : 'STAGE 03 · ON THE GROUND'}</span>
                  <h3 class="p-travel-stage-title">{isZh ? '高铁、抢票与餐饮' : 'HSR, Tickets & Dining'}</h3>
                  <p class="p-travel-stage-sub">
                    {isZh ? '12306 护照直刷进站、热门场馆提前 7 天预约与餐厅扫码点单防过敏。' : 'Board HSR with passport, book museums 7 days ahead, and order safely.'}
                  </p>
                </div>
                <ul class="p-travel-stage-links">
                  <li><a href={lp('/travel/tickets-bookings/')}><span>{isZh ? '门票与场馆预约' : 'Tickets & Bookings'}</span><span>→</span></a></li>
                  <li><a href={lp('/travel/eating-out-dietary/')}><span>{isZh ? '外出就餐与忌口' : 'Eating Out & Dietary'}</span><span>→</span></a></li>
                  <li><a href={lp('/travel/trip-plans-stacks/')}><span>{isZh ? '行程、清单与横评' : 'Trip Plans & Stacks'}</span><span>→</span></a></li>
                </ul>
              </div>

              <div class="p-travel-stage-card">
                <div>
                  <span class="p-travel-stage-num">{isZh ? '阶段 04 · 救急与返程' : 'STAGE 04 · RESCUE & EXIT'}</span>
                  <h3 class="p-travel-stage-title">{isZh ? '报错救火与离境退税' : 'Fixes & Tax Refund'}</h3>
                  <p class="p-travel-stage-sub">
                    {isZh ? '微信受限解封、全中文设备按键图解、满 ¥200 即买即退与跨境看牙体检。' : 'Unfreeze WeChat, decode Chinese appliances, and claim 11% VAT refunds.'}
                  </p>
                </div>
                <ul class="p-travel-stage-links">
                  <li><a href={lp('/travel/safety-forms-how-to/')}><span>{isZh ? '安全、单据与设备图解' : 'Safety & Device Guides'}</span><span>→</span></a></li>
                  <li><a href={lp('/travel/shopping-tax-refund/')}><span>{isZh ? '购物、数码与退税' : 'Shopping & Tax Refund'}</span><span>→</span></a></li>
                  <li><a href={lp('/travel/medical-dental-trips/')}><span>{isZh ? '入境医疗与体检旅游' : 'Medical & Dental Trips'}</span><span>→</span></a></li>
                </ul>
              </div>
            </div>
          </section>

          {/* 3-Card Photo Survival Deck */}
          <section class="v32-spotlight-section" aria-labelledby="travel-spot-h">
            <div class="v32-block-head">
              <h2 id="travel-spot-h">{isZh ? '行前必读三大通关剧本' : 'Essential Travel Playbooks'}</h2>
            </div>
            <div class="v32-spotlight-grid">
              {visual.spotlights.map((card) => (
                <a href={lp(card.href)} class="v32-spot-card">
                  <div class="v32-spot-media">
                    <img src={card.image} alt={isZh ? card.titleZh : card.titleEn} loading="lazy" decoding="async" />
                  </div>
                  <div class="v32-spot-body">
                    <span class="v32-spot-tag">{isZh ? card.tagZh : card.tagEn}</span>
                    <h3 class="v32-spot-title">{isZh ? card.titleZh : card.titleEn}</h3>
                    <p class="v32-spot-desc">{isZh ? card.descZh : card.descEn}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>

          {/* High-Contrast Show-to-Local Emergency Cards Strip */}
          <section class="p-travel-sos-band" aria-labelledby="travel-sos-h">
            <div class="p-travel-sos-head">
              <h2 id="travel-sos-h">{isZh ? '现场救火 · 全屏出示给司机、前台与后厨' : 'Show-to-Local Fullscreen Emergency Cards'}</h2>
              <a href={lp('/cards/')}>{isZh ? '全部亮屏字卡 →' : 'All fullscreen cards →'}</a>
            </div>
            <div class="p-travel-sos-grid">
              <a href={lp('/cards/peanut-allergy-sos/')} class="p-travel-sos-card">
                <span class="p-travel-sos-hanzi">我对花生严重过敏</span>
                <span class="p-travel-sos-en">{isZh ? '后厨防花生油亮屏卡 →' : 'Severe Peanut Allergy SOS →'}</span>
              </a>
              <a href={lp('/cards/taxi-beijing-qinghe/')} class="p-travel-sos-card">
                <span class="p-travel-sos-hanzi">请去北京清河站</span>
                <span class="p-travel-sos-en">{isZh ? '高铁站防走错打车卡 →' : 'Railway Station Taxi Card →'}</span>
              </a>
              <a href={lp('/cards/hotel-checkin-passport/')} class="p-travel-sos-card">
                <span class="p-travel-sos-hanzi">持外国护照办理入住</span>
                <span class="p-travel-sos-en">{isZh ? '酒店前台外宾登记卡 →' : 'Hotel Passport Check-In →'}</span>
              </a>
              <a href={lp('/cards/medical-emergency-120/')} class="p-travel-sos-card">
                <span class="p-travel-sos-hanzi">请送三甲医院国际部</span>
                <span class="p-travel-sos-en">{isZh ? '120 急诊就医沟通卡 →' : 'Emergency Hospital Card →'}</span>
              </a>
            </div>
          </section>
        </>
      )}

      {/* ====================================================================
          BESPOKE LAYOUT 02: /live/ (Stripe Atlas 3-Track + Nomad List City Table)
          ==================================================================== */}
      {v32Id === 'live' && (
        <>
          <section class="p-live-tracks" aria-label={isZh ? '三大长居身份路径' : 'Three Expat Pathways'}>
            <div class="p-live-track-card">
              <div>
                <span class="p-live-track-kicker">{isZh ? '路径 A · 职场与外派' : 'TRACK A · PROFESSIONALS'}</span>
                <h2 class="p-live-track-title">{isZh ? '外籍雇员与工作许可' : 'Working Expats & Permits'}</h2>
                <p class="p-live-track-desc">
                  {isZh ? '从 A/B/C 工作许可积分、Z 签证入境，到 183 天个税津贴与五险一金合规。' : 'Navigate Category A/B/C scoring, Z-visas, 183-day IIT rules, and social insurance.'}
                </p>
              </div>
              <ul class="p-live-track-list">
                <li><a href={lp('/live/work-permits-visas/')}><span>{isZh ? '工作许可与签证' : 'Work Permits & Visas'}</span><span>→</span></a></li>
                <li><a href={lp('/live/banking-personal-tax/')}><span>{isZh ? '银行开户与个人所得税' : 'Banking & Personal Tax'}</span><span>→</span></a></li>
                <li><a href={lp('/live/jobs-social-insurance/')}><span>{isZh ? '就业合同与五险一金' : 'Jobs & Social Insurance'}</span><span>→</span></a></li>
              </ul>
            </div>

            <div class="p-live-track-card">
              <div>
                <span class="p-live-track-kicker">{isZh ? '路径 B · 留学与深造' : 'TRACK B · STUDENTS'}</span>
                <h2 class="p-live-track-title">{isZh ? '来华留学与高校申请' : 'Study in China & Degrees'}</h2>
                <p class="p-live-track-desc">
                  {isZh ? '150 所英文授课高校、MBBS/CS 热门学位、CSC 奖学金与 X1/X2 居留转换。' : '150 English-taught universities, CSC scholarships, and student residence permits.'}
                </p>
              </div>
              <ul class="p-live-track-list">
                <li><a href={lp('/live/study-in-china/')}><span>{isZh ? '来华留学与名校名录' : 'Universities & Scholarships'}</span><span>→</span></a></li>
                <li><a href={lp('/live/residence-pr-nomads/')}><span>{isZh ? '居留许可与五星卡永居' : 'Residence & Five-Star PR'}</span><span>→</span></a></li>
                <li><a href={lp('/guides/study-work-residence/')}><span>{isZh ? '留学转工签全流程' : 'Study-to-Work Playbook'}</span><span>→</span></a></li>
              </ul>
            </div>

            <div class="p-live-track-card">
              <div>
                <span class="p-live-track-kicker">{isZh ? '路径 C · 旅居与家庭' : 'TRACK C · NOMADS & FAMILIES'}</span>
                <h2 class="p-live-track-title">{isZh ? '数字游民、安家与收尾' : 'Nomads, Family & Clean Exit'}</h2>
                <p class="p-live-track-desc">
                  {isZh ? '低成本宜居城市租房、三甲国际部就医、临时驾照换领、携宠检疫与离境退保。' : 'Apartment leasing, international hospitals, driver licenses, pets, and pension refunds.'}
                </p>
              </div>
              <ul class="p-live-track-list">
                <li><a href={lp('/live/housing-cost-of-living/')}><span>{isZh ? '租房、买房与生活成本' : 'Housing & Cost of Living'}</span><span>→</span></a></li>
                <li><a href={lp('/live/healthcare/')}><span>{isZh ? '涉外就医与商业医保' : 'Healthcare & Intl Clinics'}</span><span>→</span></a></li>
                <li><a href={lp('/live/leaving-china/')}><span>{isZh ? '离境退保与海牙认证清单' : 'Leaving China Closeout'}</span><span>→</span></a></li>
              </ul>
            </div>
          </section>

          {/* Nomad List Style 4-City Livability & Cost Matrix */}
          <section class="p-live-cities" aria-labelledby="live-cities-h">
            <div class="v32-block-head">
              <h2 id="live-cities-h">{isZh ? '热门长居与旅居城市生活基准对比' : 'Expat & Nomad City Livability Matrix'}</h2>
              <a href={lp('/guides/digital-nomad-china/')} class="v32-more-link">
                {isZh ? '数字游民完整报告 →' : 'Full nomad report →'}
              </a>
            </div>
            <div style="overflow-x:auto;">
              <table class="p-live-city-table">
                <thead>
                  <tr>
                    <th>{isZh ? '城市中枢' : 'City Hub'}</th>
                    <th>{isZh ? '月均生活成本锚点' : 'Monthly Cost Anchor'}</th>
                    <th>{isZh ? '代表涉外国际医疗' : 'Flagship Intl Hospital'}</th>
                    <th>{isZh ? '英文授课代表高校' : 'Top Universities'}</th>
                    <th>{isZh ? '长居定位' : 'Best For'}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><a href={lp('/cities/shanghai/')}>{isZh ? '上海 Shanghai' : 'Shanghai'}</a></td>
                    <td>¥14,000 – ¥24,000</td>
                    <td>{isZh ? '华山医院国际部 · 上海和睦家' : 'Huashan Worldwide · United Family'}</td>
                    <td>{isZh ? '复旦 · 上海交大 · 上海纽大' : 'Fudan · SJTU · NYU Shanghai'}</td>
                    <td>{isZh ? '跨国企业总部与金融外派首选' : 'Multinational HQ & finance expats'}</td>
                  </tr>
                  <tr>
                    <td><a href={lp('/cities/chengdu/')}>{isZh ? '成都 Chengdu' : 'Chengdu'}</a></td>
                    <td>¥7,500 – ¥11,500</td>
                    <td>{isZh ? '川大华西医院国际医疗中心' : 'West China Hospital Intl Wing'}</td>
                    <td>{isZh ? '四川大学 · 电子科大' : 'Sichuan Univ. · UESTC'}</td>
                    <td>{isZh ? '高性价比数字游民与慢生活之都' : 'Top value digital nomad & cafe hub'}</td>
                  </tr>
                  <tr>
                    <td><a href={lp('/cities/beijing/')}>{isZh ? '北京 Beijing' : 'Beijing'}</a></td>
                    <td>¥13,500 – ¥23,000</td>
                    <td>{isZh ? '北京协和国际部 · 北京和睦家' : 'PUMCH Intl · Beijing United Family'}</td>
                    <td>{isZh ? '清华大学 · 北京大学' : 'Tsinghua · Peking University'}</td>
                    <td>{isZh ? '高校学者、驻华机构与科技研发' : 'Academics, embassies & AI R&D'}</td>
                  </tr>
                  <tr>
                    <td><a href={lp('/cities/shenzhen/')}>{isZh ? '深圳 Shenzhen' : 'Shenzhen'}</a></td>
                    <td>¥11,000 – ¥18,500</td>
                    <td>{isZh ? '香港大学深圳医院国际医疗中心' : 'HKU-Shenzhen Hospital IMC'}</td>
                    <td>{isZh ? '南方科大 · 港中大（深圳）' : 'SUSTech · CUHK-Shenzhen'}</td>
                    <td>{isZh ? '硬件创业者与 14 分钟跨境香港' : 'Hardware founders & 14m HK rail link'}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>
        </>
      )}

      {/* ====================================================================
          BESPOKE LAYOUT 03: /business/ (Regulatory Bar + 7:5 Fair & Protocol)
          ==================================================================== */}
      {v32Id === 'business' && (
        <>
          <section class="p-biz-desks" aria-label={isZh ? '四大官方合规核验台' : 'Official Compliance Verification Desks'}>
            <a href={lp('/compliance/uscc-gsxt-lookup/')} class="p-biz-desk-item">
              <span class="p-biz-desk-code">GB 32100-2015</span>
              <strong class="p-biz-desk-title">{isZh ? '18 位信用代码与企信网尽调' : '18-Digit USCC & GSXT Lookup'}</strong>
              <span class="p-biz-desk-sub">{isZh ? '打样付款前核验工厂营业执照、实缴资本与行政处罚。' : 'Verify supplier registration, paid-in capital, and litigation.'}</span>
            </a>
            <a href={lp('/business/standards-compliance/')} class="p-biz-desk-item">
              <span class="p-biz-desk-code">CCC · GB 47372-2026</span>
              <strong class="p-biz-desk-title">{isZh ? '3C 强制认证与外文版国标' : 'CCC & 2,913 Translated GB Standards'}</strong>
              <span class="p-biz-desk-sub">{isZh ? '查询 2,913 项外文版国标目录、电池 3C 新规与 SRRC 核准码。' : 'Check compulsory product certificates and translated national standards.'}</span>
            </a>
            <a href={lp('/business/market-entry/')} class="p-biz-desk-item">
              <span class="p-biz-desk-code">MOFCOM · WFOE</span>
              <strong class="p-biz-desk-title">{isZh ? '外资准入负面清单与设企' : 'Negative List & WFOE Setup'}</strong>
              <span class="p-biz-desk-sub">{isZh ? '核对外商投资准入负面清单、鼓励目录与外资企业开户流程。' : 'Review foreign investment negative lists and WFOE incorporation.'}</span>
            </a>
            <a href={lp('/business/tax-invoicing-fx/')} class="p-biz-desk-item">
              <span class="p-biz-desk-code">STA · SAFE</span>
              <strong class="p-biz-desk-title">{isZh ? '增值税发票与跨境收结汇' : 'Fapiao Invoicing & Cross-Border FX'}</strong>
              <span class="p-biz-desk-sub">{isZh ? '数电发票合规校验、出口退税链路与跨境贸易结算规则。' : 'Digital Fapiao verification, export VAT rebates, and FX settlement.'}</span>
            </a>
          </section>

          <section class="p-biz-split" aria-label={isZh ? '旗舰展会与源头验厂流程' : 'Flagship Trade Fair & Sourcing Protocol'}>
            <a href={lp('/attractions/canton-fair/')} class="p-biz-fair-lead">
              <div class="p-biz-fair-media">
                <img src="/images/technology.webp" alt={isZh ? '广州广交会琶洲展馆' : 'Canton Fair Pazhou Complex'} loading="lazy" decoding="async" />
              </div>
              <div>
