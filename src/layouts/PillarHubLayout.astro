                      ? '从 DeepSeek、Qwen 等全球顶流开源大模型，到大疆无人机、拓竹 3D 打印机、宇树机器人及占全球过半产能的新能源智能电车，开源 AI 与敏捷硬件供应链已成为核心引擎。'
                      : 'From globally adopted open-weight models (DeepSeek, Qwen) to DJI drones, Bambu Lab 3D printers, Unitree robotics, and smart EVs, open AI meets rapid hardware iteration.'}
                  </p>
                </div>
              </div>
            </div>
          </section>

          {/* Complete Master Topic Index Slot (#topic-index) */}
          <div class="v32-slot-wrap">
            <slot />
          </div>
        </>
      )}

      {/* Shared Clean 2-Column Topic Directory (All Secondary Hubs in this Pillar) */}
      <section class="v32-topics-section" aria-labelledby="pillar-topics-h">
        <div class="v32-block-head">
          <h2 id="pillar-topics-h">
            {isZh ? `${visual.h1Zh}全部分类` : `All ${visual.h1En} Topics`}
          </h2>
        </div>

        <ul class="v32-topic-grid">
          {navSections.map((sec) => (
            <li class="v32-topic-cell">
              <a href={lp(sec.hubPath)} class="v32-topic-link">
                <div class="v32-topic-row">
                  <span class="v32-topic-title">{isZh ? sec.navZh : sec.navEn}</span>
                  <span class="v32-topic-arrow" aria-hidden="true">→</span>
                </div>
                <p class="v32-topic-desc">{isZh ? sec.scopeZh : sec.navEn}</p>
              </a>
            </li>
          ))}
        </ul>

        {hubOnlySections.length > 0 && (
          <div class="v32-extended-band">
            <span class="v32-extended-label">{isZh ? '延伸专题' : 'EXTENDED TOPICS'}</span>
            <div class="v32-extended-list">
              {hubOnlySections.map((sec) => (
                <a href={lp(sec.hubPath)} class="v32-extended-item">
                  <strong>{isZh ? sec.navZh : sec.navEn}</strong>
                  <span>{isZh ? sec.scopeZh : sec.navEn}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </section>

      {/* Bottom 8:4 Asymmetric Reading Split (Curated Playbooks + Latest Dispatches | Sticky Right Rail) */}
      <div class="v32-body-grid">
        <div class="v32-main">
          {pillarGuides.length > 0 && (
            <section class="v32-section-block" aria-labelledby="pillar-guides-h">
              <div class="v32-block-head">
                <h2 id="pillar-guides-h">
                  {isZh ? `${visual.h1Zh}深度指南` : `${visual.h1En} Deep Guides`}
                </h2>
              </div>
              <div class="v32-item-list">
                {pillarGuides.map((g) => (
                  <a href={lp(`/guides/${g.slug}/`)} class="v32-item-row">
                    <span>
                      <span class="v32-item-title">{isZh ? g.titleZh : g.title}</span>
                      <span class="v32-item-sub">{isZh ? g.leadHookZh : g.leadHook}</span>
                    </span>
                    <span class="v32-item-tag">{ARCHETYPE_LABELS[locale][g.archetype] ?? g.archetype}</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          {cmsEntries.length > 0 && (
            <section class="v32-section-block" aria-labelledby="pillar-cms-h">
              <div class="v32-block-head">
                <h2 id="pillar-cms-h">{isZh ? '编辑部最新志刊' : 'Latest Dispatches'}</h2>
                <a href={lp('/posts/')} class="v32-more-link">
                  {isZh ? '全部文章 →' : 'All articles →'}
                </a>
              </div>
              <div class="v32-item-list">
                {cmsEntries.map((entry) => (
                  <a href={lp(postPath(entry.data.slug || entry.id))} class="v32-item-row">
                    <span>
                      <span class="v32-item-title">{entry.data.title}</span>
                      {entry.data.excerpt && <span class="v32-item-sub">{entry.data.excerpt}</span>}
                    </span>
                    <span class="v32-item-tag">→</span>
                  </a>
                ))}
              </div>
            </section>
          )}
        </div>

        <aside class="v32-rail" aria-label={isZh ? '常看与现场实测' : 'Most viewed and field reports'}>
          <div class="v32-rail-group">
            <p class="v32-rail-heading">{isZh ? '常看直达' : 'MOST VIEWED'}</p>
            <ul class="v32-rail-nav">
              {pillar.mostViewedTop.slice(0, 5).map((item) => (
                <li>
                  <a href={lp(item.href)} class="v32-rail-link">
                    <span>{isZh ? item.labelZh : item.label}</span>
                    <span class="v32-rail-code">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="v32-rail-group">
            <p class="v32-rail-heading">{isZh ? '近期现场实测' : 'FIELD REPORTS'}</p>
            <ul class="pe-pulse-list">
              {recentPulse.map((p) => {
                const zhP = PULSE_ZH_MAP[p.id];
                return (
                  <li class="pe-pulse-row">
                    <Badge tone={p.status === 'worked' ? 'verified' : p.status === 'partial' ? 'standby' : 'danger'}>
                      {PULSE_STATUS_LABELS[locale][p.status]}
                    </Badge>
                    <div style="font-size:var(--text-xs);">
                      <strong>{isZh && zhP ? zhP.location : p.location}</strong>
                      <p style="color:var(--ink-secondary);margin-top:0.15rem;">
                        {isZh && zhP ? zhP.summary : p.summary}
                      </p>
                    </div>
                  </li>
                );
              })}
            </ul>
            <a href={lp('/pulse/')} class="v32-rail-link" style="margin-top:0.35rem;">
              <span>{isZh ? '查看全部实测' : 'All Field Reports'}</span>
              <span class="v32-rail-code">→</span>
            </a>
          </div>
        </aside>
      </div>

      {/* Apple-Style Bottom Breadcrumb */}
      <nav class="breadcrumb article-bottom-breadcrumb" aria-label="Breadcrumb">
        <a href={lp('/')}>{isZh ? '首页' : 'Home'}</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">{isZh ? visual.h1Zh : visual.h1En}</span>
      </nav>
    </div>
  </div>
</BaseShell>
