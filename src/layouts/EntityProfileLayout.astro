---
/**
 * Entity Dossier Layout (Attractions like Forbidden City, Trade Fairs like Canton Fair, Cities, etc.)
 * Purpose-built for 0.5s fact verification & field execution — NOT a blog article template:
 * 1. Asymmetric 7:5 Hero (Identity + Pronunciation + 1 Primary CTA + Compact 16:10 Scene Photo)
 * 2. Unboxed Horizontal Quick-Facts Strip (tabular-nums, live BJT->Local time conversion)
 * 3. Asymmetric 8:4 Body (Left: Alerts, Field Notes, Spatial/City Modules, Alternatives, Pulse | Right: Sticky Field Action Rail + Minimal AI Links + Borderless Tags)
 * 4. Quiet Provenance Strip (NO blog author card) + Apple-style Bottom Breadcrumb
 */
import BaseShell from './BaseShell.astro';
import AutoDisclaimer from '../components/compliance/AutoDisclaimer.astro';
import GroundPulsePanel from '../components/entity/GroundPulsePanel.astro';
import InteractiveHotspot from '../components/entity/InteractiveHotspot.astro';
import NearbyMesh from '../components/entity/NearbyMesh.astro';
import Button from '@ui/actions/Button.astro';
import Alert from '@ui/feedback/Alert.astro';
import type { EntityProfile } from '@data/paradigm-e/entities';
import { PILLAR_BY_ID } from '@data/paradigm-e/pillars';
import { tagPath } from '@lib/format';
import { getLocaleFromContext, localePath } from '@i18n/ui';
import { buildEntityGraphJsonLd } from '@lib/seo-geo';
import '../styles/article.css';
import '../styles/entity.css';

interface Props {
  entity: EntityProfile;
}

const { entity } = Astro.props;
const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (p: string) => localePath(p, locale);
const pillar = PILLAR_BY_ID[entity.pillar];

const mdHref = entity.collection === 'cities'
  ? `/cities/${entity.slug}.md`
  : `/entities/${entity.collection}/${entity.slug}.md`;

const canonicalUrl = `${Astro.url.origin}${lp(`/${entity.collection}/${entity.slug}/`)}`;
const displayTitle = isZh && entity.cardData ? entity.cardData.titleZh : (isZh ? entity.chineseName : entity.title);
const secondaryName = isZh ? entity.title : entity.chineseName;

const ENTITY_HERO_MAP: Record<string, { src: string; altEn: string; altZh: string }> = {
  'forbidden-city': {
    src: '/images/beijing.webp',
    altEn: 'Morning light across the historic palace roofs of Beijing',
    altZh: '晨光映照下的北京故宫古建屋脊',
  },
  'canton-fair': {
    src: '/images/shanghai.webp',
    altEn: 'Modern trade and exhibition skyline in China',
    altZh: '中国现代化国际会展与商贸枢纽天际线',
  },
  beijing: {
    src: '/images/beijing.webp',
    altEn: 'Historic imperial roofs in Beijing at sunrise',
    altZh: '北京古建天际线与晨光',
  },
  shanghai: {
    src: '/images/shanghai.webp',
    altEn: 'Huangpu River and Shanghai skyline at dusk',
    altZh: '黄浦江与上海外滩暮色天际线',
  },
  chengdu: {
    src: '/images/chengdu.webp',
    altEn: 'Giant panda resting amid bamboo in Chengdu, Sichuan',
    altZh: '四川成都竹林中休憩的大熊猫',
  },
  xian: {
    src: '/images/town.webp',
    altEn: 'Historic Chinese architecture and water courtyard',
    altZh: '古韵建筑与水景庭院',
  },
  shenzhen: {
    src: '/images/technology.webp',
    altEn: 'Modern skyline and innovation hub in Shenzhen',
    altZh: '深圳现代都市与科创地标',
  },
};
const heroMedia = !entity.cardData && !entity.hotspotData ? ENTITY_HERO_MAP[entity.slug] : undefined;

const cardExportPayload = entity.cardData
  ? JSON.stringify({
      slug: entity.slug,
      title: entity.title,
      titleZh: entity.cardData.titleZh,
      scenario: entity.cardData.scenario,
      largeHanzi: entity.cardData.largeHanzi,
      pinyinLine: entity.cardData.pinyinLine,
      gb30240En: entity.cardData.gb30240En,
      subNoteChinese: entity.cardData.subNoteChinese,
      subNoteEn: entity.cardData.subNoteEn,
      theme: entity.cardData.theme,
      href: lp(`/cards/${entity.slug}/`),
    })
  : undefined;

const COLLECTION_LABELS: Record<string, { en: string; zh: string }> = {
  cities: { en: 'Cities', zh: '城市档案' },
  attractions: { en: 'Places & Events', zh: '地标与展会' },
  'in-china': { en: 'Apps in China', zh: '应用替代' },
  errors: { en: 'Error Rescue', zh: '报错排查' },
  documents: { en: 'Official Forms', zh: '官方表格' },
  'how-to-use': { en: 'Device Guides', zh: '设备图解' },
  cards: { en: 'Show Cards', zh: '亮屏字卡' },
  compliance: { en: 'Compliance', zh: '合规核验' },
};

const collectionLabel = COLLECTION_LABELS[entity.collection]
  ? (isZh ? COLLECTION_LABELS[entity.collection].zh : COLLECTION_LABELS[entity.collection].en)
  : entity.collection;

const showMobileBar = ['attractions', 'errors', 'documents', 'how-to-use', 'cards', 'cities'].includes(entity.collection);

const aiPrompt = isZh
  ? `请基于这个 ChinaWao 实体档案页，帮我规划行前准备并解答后续问题：${canonicalUrl}`
  : `Use this ChinaWao entity dossier to help me plan logistics and answer follow-up questions: ${canonicalUrl}`;

const preferGoogleHref = 'https://www.google.com/preferences/source?q=chinawao.com';
const chatGptHref = `https://chatgpt.com/?q=${encodeURIComponent(aiPrompt)}`;
const geminiHref = `https://gemini.google.com/app?q=${encodeURIComponent(aiPrompt)}`;

const railTags = [
  { slug: entity.pillar, label: isZh ? pillar.nameZh : pillar.name },
  { slug: entity.collection, label: collectionLabel },
];

const jsonLd = buildEntityGraphJsonLd(entity, Astro.url.origin, locale, [
  { name: isZh ? '首页' : 'Home', url: lp('/') },
  { name: isZh ? pillar.nameZh : pillar.name, url: lp(`/${pillar.id}/`) },
  { name: collectionLabel, url: lp(entity.collection === 'cards' ? '/cards/' : '/explore/') },
  {
    name: displayTitle,
    url: lp(`/${entity.collection}/${entity.slug}/`),
  },
]);
---
<BaseShell
  title={`${entity.title} (${entity.chineseName})`}
  description={isZh ? entity.taglineZh : entity.tagline}
  activePillar={entity.pillar}
  persona={entity.persona}
  alternateMd={mdHref}
  jsonLd={jsonLd}
  mobileFieldBar={showMobileBar ? {
    amapChineseName: entity.primaryAmapTerm ?? entity.chineseName,
    cardHref: lp(entity.cardSlug ? `/cards/${entity.cardSlug}/` : '/cards/taxi-beijing-qinghe/'),
    pulseHref: lp('/pulse/#submit-pulse'),
  } : undefined}
>
  <div class="container">
    <div class="entity-shell">
      {/* PART 1: Asymmetric 7:5 Entity Dossier Hero */}
      <header class:list={['entity-hero', !heroMedia && 'entity-hero--no-media']}>
        <div>
          <p class="entity-eyebrow">
            {collectionLabel} · {isZh ? `核验于 ${entity.lastVerified}` : `Verified ${entity.lastVerified}`}
          </p>
          <h1>{displayTitle}</h1>

          <div class="entity-subline">
            {secondaryName && secondaryName !== displayTitle && <span>{secondaryName}</span>}
            {entity.pinyin && <span>· {entity.pinyin}</span>}
            {!entity.cardData && (
              <button
                type="button"
                class="entity-speak-btn"
                data-pe-speak={entity.chineseName}
                aria-label={isZh ? `朗读 ${entity.chineseName}` : `Pronounce ${entity.chineseName}`}
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
                  <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
                </svg>
                <span>{isZh ? '读音' : 'Listen'}</span>
              </button>
            )}
          </div>

          <p class="entity-dek">{isZh ? entity.taglineZh : entity.tagline}</p>

          <div class="entity-cta-row">
            {entity.primaryAmapTerm ? (
              <button
                type="button"
                class="entity-primary-btn"
                data-pe-copy={entity.primaryAmapTerm}
                data-pe-copy-toast={isZh ? `已复制高德中文名：${entity.primaryAmapTerm}` : `Copied Amap name: ${entity.primaryAmapTerm}`}
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <span>{isZh ? `复制高德名：${entity.primaryAmapTerm}` : `Copy Amap: ${entity.primaryAmapTerm}`}</span>
              </button>
            ) : entity.officialUrl ? (
              <a
                href={entity.officialUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="entity-primary-btn"
              >
                <span>{entity.officialLabel ?? (isZh ? '前往官方入口 ↗' : 'Official Portal ↗')}</span>
              </a>
            ) : null}

            <div class="entity-icon-actions" role="group" aria-label={isZh ? '页面操作' : 'Page actions'}>
              <button
                type="button"
                class="entity-icon-btn"
                aria-label={isZh ? '分享档案' : 'Share dossier'}
                title={isZh ? '分享' : 'Share'}
                data-article-share
                data-share-title={displayTitle}
                data-share-url={canonicalUrl}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
                  <polyline points="16 6 12 2 8 6" />
                  <line x1="12" y1="2" x2="12" y2="15" />
                </svg>
              </button>
              <button
                type="button"
                class="entity-icon-btn"
                aria-pressed="false"
                aria-label={isZh ? '收藏档案' : 'Save dossier'}
                title={isZh ? '收藏' : 'Save'}
                data-article-save
                data-save-slug={`${entity.collection}-${entity.slug}`}
                data-save-title={displayTitle}
                data-save-url={canonicalUrl}
              >
                <svg class="icon-bookmark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        {heroMedia && (
          <figure class="entity-hero-media">
            <div class="entity-hero-frame">
              <img
                src={heroMedia.src}
                alt={isZh ? heroMedia.altZh : heroMedia.altEn}
                loading="eager"
                decoding="async"
              />
            </div>
          </figure>
        )}
      </header>

      {/* INTERACTIVE SHOW CARD HERO (/cards/) */}
      {entity.cardData && (
        <section
          class={`pe-showcard-preview pe-showcard-preview--${entity.cardData.theme}`}
          aria-label="Show-to-local card"
          data-pe-track-card={cardExportPayload}
          style="margin-bottom: var(--space-7);"
        >
          <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--space-3);">
            <span style="font-family:var(--font-mono);font-size:var(--text-xs);letter-spacing:0.08em;">
              {entity.cardData.scenario}
            </span>
            <div style="display:flex;flex-wrap:wrap;gap:0.45rem;">
              <Button variant="secondary" size="sm" data-pe-speak={entity.cardData.largeHanzi}>
                🔊 {isZh ? '语音播报' : 'Speak Mandarin'}
              </Button>
              <Button variant="secondary" size="sm" data-pe-card-save-png={cardExportPayload}>
                {isZh ? '保存高清图' : 'Save PNG'}
              </Button>
              <Button variant="primary" size="sm" commandfor="pe-fullscreen-card-dialog" command="show-modal">
                {isZh ? '全屏亮屏出示' : 'Fullscreen Mode'}
              </Button>
            </div>
          </div>
          <p class="pe-showcard-hanzi">{entity.cardData.largeHanzi}</p>
          <p style="font-family:var(--font-mono);font-size:var(--text-sm);opacity:0.9;">{entity.cardData.pinyinLine}</p>
          <p style="margin-top:var(--space-3);font-size:var(--text-sm);opacity:0.95;border-top:1px solid rgb(255 255 255 / 0.2);padding-top:var(--space-3);">
            <strong>GB/T 30240 EN:</strong> {entity.cardData.gb30240En}
          </p>
          <p style="margin-top:0.35rem;font-size:var(--text-xs);opacity:0.85;">
            {entity.cardData.subNoteChinese} · {entity.cardData.subNoteEn}
          </p>

          <dialog
            id="pe-fullscreen-card-dialog"
            closedby="any"
            class={`pe-showcard-fullscreen-dialog pe-showcard-preview--${entity.cardData.theme}`}
            aria-label="Fullscreen Show-to-Local Card"
          >
            <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;">
              <span style="font-family:var(--font-mono);font-size:var(--text-xs);letter-spacing:0.1em;">
                CHINAWAO · {entity.cardData.scenario}
              </span>
              <button
                type="button"
                class="btn btn--sm"
                commandfor="pe-fullscreen-card-dialog"
                command="close"
                autofocus
              >
                {isZh ? '退出全屏 (Esc)' : 'Exit Fullscreen (Esc)'}
              </button>
            </div>
            <div>
              <p style="font-size:clamp(2.1rem, 4.5vw, 4.2rem);line-height:1.3;font-weight:800;">
                {entity.cardData.largeHanzi}
              </p>
              <p style="margin-top:var(--space-4);font-family:var(--font-mono);font-size:clamp(1rem, 1.8vw, 1.35rem);">
                {entity.cardData.pinyinLine}
              </p>
              <p style="margin-top:var(--space-3);font-size:var(--text-base);opacity:0.9;">
                {entity.cardData.subNoteChinese}
              </p>
            </div>
            <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1rem;border-top:1px solid rgb(255 255 255 / 0.25);padding-top:var(--space-3);">
              <span style="font-size:var(--text-sm);">{entity.cardData.gb30240En}</span>
              <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
                <button type="button" class="btn btn--secondary btn--sm" data-pe-card-save-png={cardExportPayload}>
                  {isZh ? '存高清图' : 'Save PNG'}
                </button>
                <button type="button" class="btn btn--primary btn--sm" data-pe-speak={entity.cardData.largeHanzi}>
                  🔊 {isZh ? '朗读中文' : 'Play Audio'}
                </button>
              </div>
            </div>
          </dialog>
        </section>
      )}

      {/* INTERACTIVE HOTSPOT (/errors/ /documents/ /how-to-use/) */}
      {entity.hotspotData && (
        <div style="margin-bottom: var(--space-7);">
          <InteractiveHotspot
            canvasTitle={entity.hotspotData.canvasTitle}
            screenHeaderChinese={entity.hotspotData.screenHeaderChinese}
            screenLines={entity.hotspotData.screenLines}
            hotspots={entity.hotspotData.hotspots}
            locale={locale}
          />
        </div>
      )}

      {/* PART 2: Unboxed Horizontal Quick-Facts Strip */}
      {(entity.quickSpecs.length > 0 || entity.attractionData) && (
        <section class="entity-facts-strip" aria-label={isZh ? '核心硬参数' : 'Quick Facts'}>
          {entity.quickSpecs.map((spec) => (
            <div class="entity-fact-item">
              <span class="entity-fact-label">{spec.label}</span>
              <span class:list={['entity-fact-value', spec.mono && 'is-mono']}>{spec.value}</span>
            </div>
          ))}
          {entity.attractionData && (
            <div class="entity-fact-item">
              <span class="entity-fact-label">
                {isZh ? '本地时间换算' : 'Local Drop Time'}
              </span>
              <span class="entity-fact-value is-mono">
                <span
                  data-pe-bjt-hour={entity.attractionData.releaseBjtHour}
                  data-pe-bjt-minute={entity.attractionData.releaseBjtMinute}
                >
                  {isZh ? '换算中…' : 'Calculating…'}
                </span>
                {' · '}
                {entity.attractionData.mondayClosed
                  ? (isZh ? '周一闭馆' : 'Closed Mon')
                  : (isZh ? '周一开放' : 'Open Mon')}
              </span>
            </div>
          )}
        </section>
      )}

      {/* PART 3: Asymmetric 8:4 Body (Left Task Flow + Right Sticky Field Action Rail) */}
      <div class="entity-body-grid">
        <div class="entity-main-col">
          {entity.attractionData && (
            <Alert tone="danger" title={isZh ? '入场与落客红线' : 'Gate & Drop-Off Alert'}>
              {entity.attractionData.wrongStationAlert}
            </Alert>
          )}

          {/* Field Notes & Action Checklist */}
          <section class="entity-block" aria-labelledby="entity-notes-h">
            <h2 id="entity-notes-h">{isZh ? '实测避坑与行前清单' : 'Field Notes & Checklist'}</h2>
            <p class="entity-callout">{entity.whatNobodyTellsYou}</p>
            <ul class="entity-checklist">
              {entity.checklist.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </section>

          {/* Compliance Desk */}
          {entity.complianceData && (
            <section class="entity-block" aria-labelledby="entity-compliance-h" data-pe-uscc-root>
              <h2 id="entity-compliance-h">{isZh ? '官方核验台' : 'Official Verification Desk'}</h2>
              {entity.complianceData.sampleUscc && (
                <div>
                  <label for="compliance-uscc" class="t-label" style="display:block;margin-bottom:0.35rem;">
                    {isZh ? '输入 18 位统一社会信用代码（GB 32100-2015）' : '18-Digit USCC (GB 32100-2015)'}
                  </label>
                  <input
                    id="compliance-uscc"
                    type="text"
                    class="cw-input"
                    maxlength="18"
                    value={entity.complianceData.sampleUscc}
                    style="font-family:var(--font-mono);width:100%;"
                    data-pe-uscc-input
                  />
                  <div data-pe-uscc-output style="margin-top:0.5rem;font-size:var(--text-sm);"></div>
                </div>
              )}

              <h3>{isZh ? '标准中文监管检索词' : 'Standard Chinese Regulatory Terms'}</h3>
              <ul class="entity-clean-list">
                {entity.complianceData.termPresets.map((t) => (
                  <li class="entity-clean-row">
                    <span>
                      <strong>{isZh ? t.zhQuery : t.en}</strong>
                      {!isZh && <> → <code>{t.zhQuery}</code></>}
                      {' '}
                      <span class="entity-row-muted">({t.gbCode})</span>
                    </span>
                    <button type="button" class="entity-copy-inline" data-pe-copy={t.zhQuery}>
                      {isZh ? '复制' : 'Copy'}
                    </button>
                  </li>
                ))}
              </ul>

              <h3>{entity.complianceData.portalName}</h3>
              <ol class="entity-checklist">
                {entity.complianceData.walkthroughSteps.map((s) => (
                  <li><strong>{s.title}</strong>：{s.detail}</li>
                ))}
              </ol>
            </section>
          )}

          {/* City Local Directory (Unboxed) */}
          {entity.cityData && (
            <section class="entity-block" aria-labelledby="entity-city-h">
              <h2 id="entity-city-h">{isZh ? '本地速览与配套' : 'Local Directory'}</h2>
              {entity.cityData.mashup.map((sec) => (
                <div>
                  <h3>{sec.categoryLabel}</h3>
                  <ul class="entity-clean-list">
                    {sec.items.map((item) => (
                      <li class="entity-clean-row">
                        <div>
                          {item.href ? (
                            <a href={lp(item.href)}>{isZh ? item.chineseName : item.name}</a>
                          ) : (
                            <strong>{isZh ? item.chineseName : item.name}</strong>
                          )}
                          <span class="entity-row-muted">
                            {' '}— {isZh ? item.meta : `${item.chineseName} · ${item.meta}`}
                          </span>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}

              <div>
                <h3 id="universities">{isZh ? `${entity.chineseName}留学高校` : `${entity.title} Top Universities`}</h3>
                <ul class="entity-clean-list">
                  {entity.cityData.universities.map((u) => (
                    <li class="entity-clean-row">
                      <div>
                        <strong>{isZh ? u.chineseName : u.name}</strong>
                        {!isZh && <span class="entity-row-muted"> ({u.chineseName})</span>}
                        <span class="entity-row-muted"> — {u.focus}</span>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h3 id="hospitals">{isZh ? `${entity.chineseName}涉外国际医院` : `${entity.title} International Hospitals`}</h3>
                <ul class="entity-clean-list">
                  {entity.cityData.intlHospitals.map((h) => (
                    <li class="entity-clean-row">
                      <div>
                        <strong>{isZh ? h.chineseName : h.name}</strong>
                        {!isZh && <span class="entity-row-muted"> ({h.chineseName})</span>}
                        <span class="entity-row-muted"> — {h.dept} · </span>
                        <code>{h.phone}</code>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          )}

          {/* Nearby Mesh (Attractions & Trade Fairs) */}
          {entity.attractionData && (
            <section class="entity-block" aria-labelledby="entity-nearby-h">
              <h2 id="entity-nearby-h">{isZh ? '周边动线与 1–3 公里联动' : 'Nearby Access & 1–3km Mesh'}</h2>
              <NearbyMesh
                nearbyMesh={entity.attractionData.nearbyMesh}
                amapSearchChips={entity.attractionData.amapSearchChips}
                locale={locale}
              />
            </section>
          )}

          {/* Alternatives & Related */}
          {entity.alternatives.length > 0 && (
            <section class="entity-block" aria-labelledby="entity-alt-h">
              <h2 id="entity-alt-h">{isZh ? '延伸路线与替代方案' : 'Alternatives & Related'}</h2>
              <ul class="entity-clean-list">
                {entity.alternatives.map((alt) => (
                  <li class="entity-clean-row">
                    <div>
                      {alt.href ? <a href={lp(alt.href)}>{alt.name}</a> : <strong>{alt.name}</strong>}
                      <span class="entity-row-muted"> — {alt.verdict}</span>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {/* Ground Pulse & Statutory Disclaimers */}
          {entity.pulseFeed.length > 0 && (
            <section class="entity-block" aria-labelledby="entity-pulse-h">
              <h2 id="entity-pulse-h">{isZh ? '实地状态反馈' : 'Ground Pulse'}</h2>
              <GroundPulsePanel stats={entity.pulseStats} items={entity.pulseFeed} locale={locale} />
            </section>
          )}

          <AutoDisclaimer kinds={entity.disclaimers} locale={locale} />
        </div>

        {/* Right Sticky Field Action Rail (Purpose-Built for Entities) */}
        <aside class="entity-rail" aria-label={isZh ? '现场行动栏' : 'Field Action Rail'}>
          <div class="entity-action-panel">
            <p class="entity-action-heading">{isZh ? '现场快捷操作' : 'Field Actions'}</p>

            {entity.primaryAmapTerm && (
              <button
                type="button"
                class="entity-rail-action"
                data-pe-copy={entity.primaryAmapTerm}
                data-pe-copy-toast={isZh ? `已复制高德中文名：${entity.primaryAmapTerm}` : `Copied Amap name: ${entity.primaryAmapTerm}`}
              >
                <span>{isZh ? '复制高德中文名' : 'Copy Amap Name'}</span>
                <span class="entity-rail-action-sub">{entity.primaryAmapTerm}</span>
              </button>
            )}

            {entity.cardSlug && !entity.cardData && (
              <a href={lp(`/cards/${entity.cardSlug}/`)} class="entity-rail-action">
                <span>{isZh ? '全屏出示司机字卡' : 'Fullscreen Show Card'}</span>
                <span class="entity-rail-action-sub">→</span>
              </a>
            )}

            {entity.officialUrl && (
              <a href={entity.officialUrl} target="_blank" rel="noopener noreferrer" class="entity-rail-action">
                <span>{isZh ? '官方预约 / 核验入口' : 'Official Portal'}</span>
                <span class="entity-rail-action-sub">↗</span>
              </a>
            )}

            {entity.attractionData && (
              <a href={lp('/tools/ticket-calendar/')} class="entity-rail-action">
                <span>{isZh ? '放票 / 展期日历换算' : 'Drop & Date Calendar'}</span>
                <span class="entity-rail-action-sub">→</span>
              </a>
            )}

            {entity.attractionData && (
              <p class="entity-rail-meta">
                {isZh ? `体力强度：${entity.attractionData.staminaRating}` : entity.attractionData.staminaRating}
              </p>
            )}
          </div>

          {/* Streamlined AI Quick Links (Google -> ChatGPT -> Gemini) */}
          <ul class="rail-ai-list">
            <li>
              <a href={preferGoogleHref} target="_blank" rel="noopener noreferrer" class="rail-ai-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M21.35 11.1h-9.18v2.92h5.27c-.23 1.24-.93 2.29-1.98 2.99v2.48h3.2c1.87-1.72 2.95-4.26 2.95-7.27 0-.38-.03-.76-.09-1.12h-.17ZM12.17 22c2.67 0 4.91-.88 6.55-2.4l-3.2-2.48c-.89.6-2.02.95-3.35.95-2.58 0-4.76-1.74-5.54-4.08H3.32v2.56A9.89 9.89 0 0 0 12.17 22ZM6.63 13.99a5.95 5.95 0 0 1 0-3.98V7.45H3.32a9.9 9.9 0 0 0 0 9.1l3.31-2.56ZM12.17 5.93c1.45 0 2.75.5 3.78 1.48l2.83-2.83C17.07 2.99 14.84 2 12.17 2a9.89 9.89 0 0 0-8.85 5.45l3.31 2.56c.78-2.34 2.96-4.08 5.54-4.08Z" />
                </svg>
                <span>{isZh ? '设为 Google 优先来源' : 'Prefer on Google'}</span>
              </a>
            </li>
            <li>
              <a href={chatGptHref} target="_blank" rel="noopener noreferrer" class="rail-ai-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.896zm16.597 3.855-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365 2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z" />
                </svg>
                <span>{isZh ? '向 ChatGPT 提问' : 'Ask ChatGPT'}</span>
              </a>
            </li>
            <li>
              <a href={geminiHref} target="_blank" rel="noopener noreferrer" class="rail-ai-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2c.4 4.8 4.2 8.6 9 9-4.8.4-8.6 4.2-9 9-.4-4.8-4.2-8.6-9-9 4.8-.4 8.6-4.2 9-9Z" />
                </svg>
                <span>{isZh ? '向 Gemini 提问' : 'Ask Gemini'}</span>
              </a>
            </li>
          </ul>

          <div class="rail-tags" aria-label={isZh ? '档案标签' : 'Dossier tags'}>
            {railTags.map((term) => (
              <a href={lp(tagPath(term.slug))} class="rail-tag-pill">
                #{term.label}
              </a>
            ))}
          </div>
        </aside>
      </div>

      {/* PART 4: Quiet Provenance Strip (NO blog author card) + Apple-Style Bottom Breadcrumb */}
      <div class="entity-provenance">
        <span>
          {isZh ? `${entity.tier} · 最后核验于 ${entity.lastVerified}` : `${entity.tier} · Last verified ${entity.lastVerified}`}
        </span>
        {entity.officialUrl && (
          <a href={entity.officialUrl} target="_blank" rel="noopener noreferrer">
            {isZh ? '一手官方信源 ↗' : 'Primary Official Source ↗'}
          </a>
        )}
      </div>

      <nav class="breadcrumb article-bottom-breadcrumb" aria-label="Breadcrumb">
        <a href={lp('/')}>{isZh ? '首页' : 'Home'}</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href={lp(`/${pillar.id}/`)}>{isZh ? pillar.nameZh : pillar.name}</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href={lp(entity.collection === 'cards' ? '/cards/' : '/explore/')}>{collectionLabel}</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">{displayTitle}</span>
      </nav>
    </div>
  </div>
</BaseShell>
