---
/**
 * ChinaWao Paradigm E — Unified Global App Shell (Layout / BaseShell)
 * - EmDash 1.5 Head/BodyStart/BodyEnd & publicContext() preserved
 * - Locked 58px opaque high-contrast header (6 Pillars + 3-Col Mega Menu + Utility Dock + ⌘K)
 * - Clean dual-track head metadata: JSON-LD, <link rel="alternate" type="text/markdown">, hreflang
 * - Conditional MobileFieldBar on practical field-action pages
 */
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-400-italic.css';
import '@fontsource/newsreader/latin-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';

import {
  getEmDashCollection,
  getHreflangAlternates,
  getSiteSettingsWithCacheHint,
  getTaxonomyTermsWithCacheHint,
} from 'emdash';
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';
import { publicContext } from '@lib/cms';
import { getLocaleFromContext, getStrings, localePath } from '@i18n/ui';
import GlobalHeader from '../components/nav/GlobalHeader.astro';
import CommandPalette from '../components/nav/CommandPalette.astro';
import MobileFieldBar from '../components/nav/MobileFieldBar.astro';
import SiteFooter from '@site/SiteFooter.astro';
import type { PersonaType } from '@data/paradigm-e/pillars';
import '../styles/index.css';

export interface Props {
  title?: string;
  description?: string;
  pageTitle?: string | null;
  image?: string | null;
  canonical?: string | null;
  robots?: string | null;
  type?: 'website' | 'article';
  publishedTime?: string | null;
  modifiedTime?: string | null;
  author?: string | null;
  content?: { collection: string; id: string; slug?: string | null };
  activePillar?: string;
  persona?: PersonaType;
  alternateMd?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  mobileFieldBar?: {
    amapChineseName?: string;
    cardHref?: string;
    pulseHref?: string;
  };
}

const props = Astro.props;
const locale = getLocaleFromContext(Astro);
const originalPathname = Astro.locals.originalPathname ?? Astro.url.pathname;
const strings = getStrings(locale);

const [settings, taxonomyPrimary, pagesPrimary] = await Promise.all([
  getSiteSettingsWithCacheHint(),
  publicContext(() => getTaxonomyTermsWithCacheHint('category', { includeCounts: false, locale })),
  publicContext(() => getEmDashCollection('pages', { status: 'published', limit: 20, locale })),
]);

const pages =
  pagesPrimary.entries.length > 0 || locale === 'en'
    ? pagesPrimary
    : await publicContext(() => getEmDashCollection('pages', { status: 'published', limit: 20, locale: 'en' }));

const taxonomy =
  taxonomyPrimary.data.length > 0 || locale === 'en'
    ? taxonomyPrimary
    : await publicContext(() => getTaxonomyTermsWithCacheHint('category', { includeCounts: false, locale: 'en' }));

if (Astro.cache?.enabled) {
  Astro.cache.set(settings.cacheHint);
  Astro.cache.set(taxonomy.cacheHint);
  Astro.cache.set(pages.cacheHint);
}

const site = settings.data;
const siteTitle = site.title || 'ChinaWao';
const roots = taxonomy.data.filter((term) => !term.parentId);
const fullTitle = props.title ? `${props.title} — ${siteTitle}` : siteTitle;

let hreflangLinks: { hreflang: string; href: string }[] = [];
if (props.content) {
  hreflangLinks = await getHreflangAlternates(props.content.collection, props.content.id, {
    siteUrl: Astro.url.origin,
  }).catch(() => []);
}
if (hreflangLinks.length === 0) {
  const origin = Astro.url.origin;
  const enHref = `${origin}${localePath(originalPathname, 'en')}`;
  const zhHref = `${origin}${localePath(originalPathname, 'zh')}`;
  hreflangLinks = [
    { hreflang: 'en', href: enHref },
    { hreflang: 'zh-CN', href: zhHref },
    { hreflang: 'x-default', href: enHref },
  ];
}

const page = createPublicPageContext({
  Astro,
  kind: props.content ? 'content' : 'custom',
  title: fullTitle,
  pageTitle: props.pageTitle ?? props.title ?? siteTitle,
  description: props.description ?? site.tagline,
  siteName: siteTitle,
  image: props.image,
  canonical: props.canonical,
  content: props.content,
  pageType: props.type ?? 'website',
  seo: { robots: props.robots, ogImage: props.image },
  articleMeta: {
    publishedTime: props.publishedTime,
    modifiedTime: props.modifiedTime,
    author: props.author,
  },
});

const jsonLdList = props.jsonLd
  ? (Array.isArray(props.jsonLd) ? props.jsonLd : [props.jsonLd])
  : [];
---
<!doctype html>
<html lang={strings.htmlLang} data-persona={props.persona}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        var s = localStorage.getItem('color-scheme');
        if (s === 'light' || s === 'dark') {
          document.querySelector('meta[name="color-scheme"]').content = s;
        }
        var isDark = s === 'dark' || (s !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);

        var pq = new URLSearchParams(window.location.search).get('palette');
        if (pq === 'purple' || pq === 'han-purple') {
          sessionStorage.setItem('cw-palette', 'han-purple');
        } else if (pq === 'vermilion' || pq === 'red' || pq === 'default') {
          sessionStorage.removeItem('cw-palette');
        }
        var activePalette = sessionStorage.getItem('cw-palette');
        if (activePalette) {
          document.documentElement.dataset.palette = activePalette;
        }
      } catch (e) {}
    </script>
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <EmDashHead page={page} />
    {hreflangLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {props.alternateMd && (
      <link rel="alternate" type="text/markdown" href={props.alternateMd} />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteTitle} RSS Feed`}
      href="/rss.xml"
    />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {jsonLdList.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class:list={['relative font-sans', props.mobileFieldBar && 'has-mobile-field-bar']}>
    <EmDashBodyStart page={page} />
    <div class="isolate relative flex min-h-svh flex-col">
      <a class="skip-link" href="#main-content">{strings.skipToContent}</a>

      <GlobalHeader
        siteTitle={siteTitle}
        roots={roots}
        terms={taxonomy.data}
        locale={locale}
        originalPathname={originalPathname}
        activePillar={props.activePillar}
      />

      <main id="main-content" class="flex-1" tabindex="-1">
        <slot />
      </main>

      <SiteFooter
        siteTitle={siteTitle}
        tagline={locale === 'zh' ? strings.home.editionTagline : (site.tagline || 'Everything about China, decoded & source-verified.')}
        roots={roots}
        pages={pages.entries}
        locale={locale}
        originalPathname={originalPathname}
      />
    </div>

    <CommandPalette />

    {props.mobileFieldBar && (
      <MobileFieldBar
        amapChineseName={props.mobileFieldBar.amapChineseName}
        cardHref={props.mobileFieldBar.cardHref}
        pulseHref={props.mobileFieldBar.pulseHref}
        locale={locale}
      />
    )}

    {/* Sitewide Persistent Toast Stack (popover="manual" + live region) */}
    <div
      id="cw-toast-region"
      class="cw-toast-region"
      popover="manual"
      role="region"
      aria-label="Site notifications"
      data-cw-toast-region
    ></div>
    <div class="visually-hidden" aria-live="polite" aria-atomic="true" data-cw-toast-live></div>

    <script src="../scripts/site.ts"></script>
    <script src="../scripts/paradigm-e.ts"></script>
    <EmDashBodyEnd page={page} />
  </body>
</html>
