---
/**
 * Redesigned Editorial Decision Guide Layout (/guides/[slug]/)
 * Inspired by NYT Wirecutter (Visual Pick Cards + Bottom Line KPIs)
 * × Stripe Docs (Clean 8:4 Reading Flow) × Michelin Guide (Hero + Whitespace)
 */
import BaseShell from './BaseShell.astro';
import AutoDisclaimer from '../components/compliance/AutoDisclaimer.astro';
import Badge from '@ui/data-display/Badge.astro';
import Button from '@ui/actions/Button.astro';
import DataTable from '@ui/data-display/DataTable.astro';
import { getGuidesByPillar, type GuideDefinition } from '@data/paradigm-e/guides';
import { localizeGuide } from '@data/paradigm-e/guides-zh';
import { PILLAR_BY_ID } from '@data/paradigm-e/pillars';
import { PULSE_STATUS_LABELS, RESCUE_FILTER_ZH } from '@data/paradigm-e/i18n-zh';
import { getLocaleFromContext, localePath } from '@i18n/ui';
import { buildGuideJsonLd } from '@lib/seo-geo';
import '../styles/article.css';
import '../styles/entity.css';
import '../styles/guide.css';

interface Props {
  guide: GuideDefinition;
}

const { guide: rawGuide } = Astro.props;
const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const guide = localizeGuide(rawGuide, locale);
const lp = (p: string) => localePath(p, locale);
const pillar = PILLAR_BY_ID[guide.pillar];
const siblingGuides = getGuidesByPillar(guide.pillar).filter((g) => g.slug !== guide.slug).slice(0, 4);
const mdHref = `/guides/${guide.slug}.md`;
const canonicalUrl = `${Astro.url.origin}${lp(`/guides/${guide.slug}/`)}`;

// Visual Hero Photo selection (breaks wall of text cleanly on every guide)
const GUIDE_HERO_MAP: Record<string, string> = {
  'cashless-super-apps': '/images/technology.webp',
  'rail-budget-tax-refund': '/images/rail.webp',
  'overland-rail-crossings': '/images/rail.webp',
  '240h-visa-free-transit': '/images/shanghai.webp',
  '72h-pre-departure': '/images/beijing.webp',
  'chinese-tea-6-types': '/images/tea.webp',
  'dining-etiquette-old-brands': '/images/food.webp',
  'digital-nomad-china': '/images/chengdu.webp',
  'factory-sourcing-due-diligence': '/images/shanghai.webp',
  'modern-china-24h': '/images/shanghai.webp',
};

const PILLAR_HERO_FALLBACK: Record<string, string> = {
  travel: '/images/beijing.webp',
  visit: '/images/beijing.webp',
  live: '/images/chengdu.webp',
  business: '/images/shanghai.webp',
  places: '/images/hero.webp',
  culture: '/images/tea.webp',
  atlas: '/images/rail.webp',
};

const heroSrc = guide.heroImage || GUIDE_HERO_MAP[guide.slug] || PILLAR_HERO_FALLBACK[guide.pillar] || '/images/shanghai.webp';

// Pulse ratio bar computation
const pulseTotal = Math.max(1, guide.pulse.length);
const workedCount = guide.pulse.filter((p) => p.status === 'worked').length;
const partialCount = guide.pulse.filter((p) => p.status === 'partial').length;
const failedCount = guide.pulse.filter((p) => p.status === 'failed').length;

const tocItems = guide.archetype === 'playbook' && guide.steps
  ? guide.steps.map((s) => ({ id: `step-${s.number}`, label: s.title }))
  : [
      { id: 'key-facts', label: isZh ? '核心参数' : 'Key Numbers' },
      { id: 'core-module', label: isZh ? (guide.archetype === 'matrix' ? '实测方案对比' : '实操详情') : (guide.archetype === 'matrix' ? 'Top Picks' : 'Playbook') },
      ...(guide.relatedEntities.length > 0 ? [{ id: 'related-mesh', label: isZh ? '延伸对比' : 'Related Guides' }] : []),
      ...(guide.pulse.length > 0 ? [{ id: 'ground-pulse', label: isZh ? '近期现场实测' : 'Field Reports' }] : []),
    ];

const aiPrompt = isZh
  ? `请结合这篇 ChinaWao 指南，帮我制定可执行方案并回答后续问题：${canonicalUrl}`
  : `Use this ChinaWao guide to help me build an actionable plan and answer follow-up questions: ${canonicalUrl}`;

const preferGoogleHref = 'https://www.google.com/preferences/source?q=chinawao.com';
const chatGptHref = `https://chatgpt.com/?q=${encodeURIComponent(aiPrompt)}`;
const geminiHref = `https://gemini.google.com/app?q=${encodeURIComponent(aiPrompt)}`;

const jsonLd = buildGuideJsonLd(guide, Astro.url.origin, locale, [
  { name: isZh ? '首页' : 'Home', url: lp('/') },
  { name: isZh ? pillar.nameZh : pillar.name, url: lp(`/${pillar.id}/`) },
  { name: isZh ? guide.titleZh : guide.title, url: lp(`/guides/${guide.slug}/`) },
]);
---
<BaseShell
  title={isZh ? guide.titleZh : guide.title}
  description={isZh ? guide.leadHookZh : guide.leadHook}
  activePillar={guide.pillar}
  persona={guide.persona}
  alternateMd={mdHref}
  jsonLd={jsonLd}
  type="article"
>
  <div class="container">
    <div class="guide-shell">
      {/* 1. Full Inner-Width Visual Hero Banner */}
      <figure class="guide-hero-banner">
        <div class="guide-hero-frame">
          <img
            src={heroSrc}
            alt={isZh ? guide.titleZh : guide.title}
            loading="eager"
            decoding="async"
          />
        </div>
      </figure>

      {/* 2. Unboxed Editorial Header + Single Primary CTA */}
      <header class="guide-header">
        <div class="guide-header-copy">
          <h1>{isZh ? guide.titleZh : guide.title}</h1>
          <p class="guide-dek">{isZh ? guide.leadHookZh : guide.leadHook}</p>
          <p class="guide-meta-line">
            <span>{isZh ? `更新于 ${guide.lastVerified}` : `Updated ${guide.lastVerified}`}</span>
            <span aria-hidden="true">·</span>
            <a href={lp('/pulse/#submit-pulse')} style="color:inherit;text-decoration:none;">
              {isZh ? '反馈政策变动' : 'Report rule change'}
            </a>
          </p>
        </div>

        <div class="guide-header-actions">
          <a href={lp(guide.stackLink.href)} class="guide-primary-btn">
            <span>{guide.stackLink.label} →</span>
          </a>
          <button
            type="button"
            class="entity-icon-btn"
            aria-label={isZh ? '分享指南' : 'Share guide'}
            title={isZh ? '分享' : 'Share'}
            data-article-share
            data-share-title={isZh ? guide.titleZh : guide.title}
            data-share-url={canonicalUrl}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
              <polyline points="16 6 12 2 8 6" />
              <line x1="12" y1="2" x2="12" y2="15" />
            </svg>
          </button>
          <button
            type="button"
            class="entity-icon-btn"
            aria-pressed="false"
            aria-label={isZh ? '收藏指南' : 'Save guide'}
            title={isZh ? '收藏' : 'Save'}
            data-article-save
            data-save-slug={`guide-${guide.slug}`}
            data-save-title={isZh ? guide.titleZh : guide.title}
            data-save-url={canonicalUrl}
          >
            <svg class="icon-bookmark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
            </svg>
          </button>
        </div>
      </header>

      {/* 3. Wirecutter / Stripe Horizontal KPI Strip (Scannable at a glance) */}
      {guide.hardFacts.length > 0 && (
        <section id="key-facts" class="guide-kpi-strip" aria-label={isZh ? '核心参数速览' : 'Key Numbers'}>
          {guide.hardFacts.map((fact) => (
            <div class="guide-kpi-item">
              <span class="guide-kpi-label">{fact.label}</span>
              <strong class="guide-kpi-value">{fact.value}</strong>
              <span class="guide-kpi-src">{fact.source}</span>
            </div>
          ))}
        </section>
      )}

      {/* 4. Asymmetric 8:4 Body (Visual Scannable Modules + Weightless Sticky Rail) */}
      <div class="guide-body-grid">
        <article class="guide-main">
          <section id="core-module" class="guide-section">
            {/* VARIANT A: Matrix -> Wirecutter Visual Pick Cards + Optional Compact Table */}
            {guide.archetype === 'matrix' && guide.matrixRows && (
              <>
                <div class="guide-section-head">
                  <h2>{isZh ? '实测方案与推荐组合' : 'Tested Picks & Comparison'}</h2>
                </div>

                <div class="guide-picks-grid">
                  {guide.matrixRows.map((row) => (
                    <div class="guide-pick-card">
                      <div class="guide-pick-top">
                        <div class="guide-pick-head">
                          <h3 class="guide-pick-title">{row.option}</h3>
                          <span class="guide-pick-cost">{row.costRange}</span>
                        </div>

                        <ul class="guide-pick-points">
                          <li class="guide-pick-point">
                            <span class="guide-pick-icon guide-pick-icon--pro" aria-hidden="true">✓</span>
                            <div>
                              <strong>{isZh ? '最适合：' : 'Best for: '}</strong>
                              <span>{row.bestFor}</span>
                            </div>
                          </li>
                          <li class="guide-pick-point">
                            <span class="guide-pick-icon guide-pick-icon--warn" aria-hidden="true">!</span>
                            <div>
                              <strong>{isZh ? '避坑：' : 'Watch out: '}</strong>
                              <span>{row.hiddenTrap}</span>
                            </div>
                          </li>
                          <li class="guide-pick-point">
                            <span class="guide-pick-icon guide-pick-icon--skip" aria-hidden="true">–</span>
                            <div>
                              <strong>{isZh ? '慎用：' : 'Skip if: '}</strong>
                              <span>{row.avoidIf}</span>
                            </div>
                          </li>
                        </ul>
                      </div>

                      {row.href && (
                        <div class="guide-pick-foot">
                          <a href={lp(row.href)} class="guide-pick-link">
                            {isZh ? '查看完整横评与实操 →' : 'Read full breakdown →'}
                          </a>
                        </div>
                      )}
                    </div>
                  ))}
                </div>

                <details class="guide-matrix-details">
                  <summary>{isZh ? '展开完整对照简表' : 'View compact side-by-side table'}</summary>
                  <div style="margin-top: var(--space-3);">
                    <DataTable
                      id={`matrix-${guide.slug}`}
                      caption={isZh ? `${guide.titleZh}对照表` : `${guide.title} Comparison`}
                      columns={[
                        { key: 'option', label: isZh ? '方案' : 'Option', rowHeader: true },
                        { key: 'bestFor', label: isZh ? '最适合' : 'Best For' },
                        { key: 'costRange', label: isZh ? '费用门槛' : 'Cost' },
                        { key: 'hiddenTrap', label: isZh ? '避坑提醒' : 'Watch Out' },
                      ]}
                      rows={guide.matrixRows.map((r) => ({
                        option: r.href ? { text: r.option, href: lp(r.href) } : r.option,
                        bestFor: r.bestFor,
                        costRange: r.costRange,
                        hiddenTrap: r.hiddenTrap,
                      }))}
                    />
                  </div>
                </details>
              </>
            )}

            {/* VARIANT B: Playbook -> Visual Editorial Stepper */}
            {guide.archetype === 'playbook' && guide.steps && (
              <div class="guide-stepper">
                {guide.steps.map((step) => (
                  <section id={`step-${step.number}`} class="guide-step-row">
                    <span class="guide-step-num" aria-hidden="true">{step.number}</span>
                    <div class="guide-step-body">
                      <h3>{step.title}</h3>
                      <div class="guide-step-callout" role="note">{step.stopCheck}</div>
                      <p class="guide-step-summary">{step.summary}</p>
                      <ul class="guide-step-list">
                        {step.checklist.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                      {step.linkedRoute && (
                        <div>
                          <a href={lp(step.linkedRoute.href)} class="guide-pick-link">
                            {step.linkedRoute.label} →
                          </a>
                        </div>
                      )}
                    </div>
                  </section>
                ))}
              </div>
            )}

            {/* VARIANT C: Rescue -> Filterable 2-Column Visual Issue Cards */}
            {guide.archetype === 'rescue' && guide.rescueItems && (
              <div data-pe-rescue-root class="guide-section">
                {guide.rescueFilters && (
                  <div class="pe-facet-group" role="group" aria-label={isZh ? '按分类筛选' : 'Filter by category'}>
                    {guide.rescueFilters.map((f, idx) => (
                      <button
                        type="button"
                        class="pe-facet-chip"
                        aria-pressed={idx === 0 ? 'true' : 'false'}
                        data-pe-rescue-filter={f}
                      >
                        {isZh ? (RESCUE_FILTER_ZH[f] ?? f) : f}
                      </button>
                    ))}
                  </div>
                )}

                <div class="guide-visual-grid">
                  {guide.rescueItems.map((item) => (
                    <div class="guide-visual-card" data-pe-rescue-card={item.appOrGroup}>
                      <div style="display:grid;gap:0.55rem;">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
                          <Badge tone="danger">{isZh ? (RESCUE_FILTER_ZH[item.appOrGroup] ?? item.appOrGroup) : item.appOrGroup}</Badge>
                          {item.effectiveDate && <Badge tone="verified">{item.effectiveDate}</Badge>}
                        </div>
                        <h3><a href={lp(item.href)}>{item.title}</a></h3>
                        <p class="guide-signal-quote">{item.chineseSignal}</p>
                        <p style="margin:0;font-size:var(--text-sm);color:var(--ink-secondary);line-height:1.55;">
                          {item.actionSummary}
                        </p>
                      </div>
                      <div class="guide-pick-foot">
                        <a href={lp(item.href)} class="guide-pick-link">
                          {isZh ? '查看排查步骤 →' : 'View rescue steps →'}
                        </a>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* VARIANT D: Editorial -> 2-Column Magazine Photo Cards */}
            {guide.archetype === 'editorial' && guide.galleryItems && (
              <div class="guide-visual-grid">
                {guide.galleryItems.map((card, idx) => {
                  const fallbackGalleryImgs = ['/images/tea.webp', '/images/food.webp', '/images/craft.webp', '/images/town.webp'];
                  const cardImg = card.image || fallbackGalleryImgs[idx % fallbackGalleryImgs.length];
                  return (
                    <article class="guide-visual-card guide-visual-card--photo">
                      <div class="guide-card-media">
                        <img
                          src={cardImg}
                          alt={card.title}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="guide-card-body">
                        <div style="display:grid;gap:0.35rem;">
                          <h3>{card.title}</h3>
                          <span style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--ink-tertiary);">
                            {card.chineseName}
                          </span>
                          <p style="margin:0.25rem 0 0;font-size:var(--text-sm);color:var(--ink-secondary);line-height:1.6;">
                            {card.summary}
                          </p>
                        </div>
                        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:var(--space-3);">
                          <Button
                            variant="secondary"
                            size="sm"
                            data-pe-copy={card.copyTerm}
                            data-pe-copy-toast={isZh ? `已复制中文名：${card.copyTerm}` : `Copied Chinese name: ${card.copyTerm}`}
                          >
                            {isZh ? `复制：${card.copyTerm}` : `Copy: ${card.copyTerm}`}
                          </Button>
                          {card.href && (
                            <a href={lp(card.href)} class="guide-pick-link" style="align-self:center;">
                              {isZh ? '详情 →' : 'Details →'}
                            </a>
                          )}
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            )}
          </section>

          {/* Visual Related Links Grid */}
          {guide.relatedEntities.length > 0 && (
            <section id="related-mesh" class="guide-section" aria-labelledby="guide-related-h">
              <h2 id="guide-related-h">{isZh ? '延伸对比与专题' : 'Related Comparisons & Guides'}</h2>
              <div class="guide-related-grid">
                {guide.relatedEntities.map((ent) => (
                  <a href={lp(ent.href)} class="guide-related-card">
                    <span>{ent.label}</span>
                    <span aria-hidden="true" style="color:var(--ink-tertiary);">→</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          {/* Visual Field Pulse Strip (#ground-pulse) */}
          {guide.pulse.length > 0 && (
            <section id="ground-pulse" class="guide-section" aria-labelledby="guide-pulse-h">
              <div class="guide-section-head">
                <h2 id="guide-pulse-h">{isZh ? '近期现场实测' : 'Recent Field Reports'}</h2>
                <a href={lp('/pulse/#submit-pulse')} class="guide-pick-link">
                  {isZh ? '提交我的实测 →' : 'Submit a report →'}
                </a>
              </div>

              <div class="guide-pulse-bar" aria-hidden="true">
                {workedCount > 0 && <span class="guide-pulse-seg--worked" style={`flex:${workedCount / pulseTotal}`} />}
                {partialCount > 0 && <span class="guide-pulse-seg--partial" style={`flex:${partialCount / pulseTotal}`} />}
                {failedCount > 0 && <span class="guide-pulse-seg--failed" style={`flex:${failedCount / pulseTotal}`} />}
              </div>

              <div class="guide-pulse-grid">
                {guide.pulse.map((item) => (
                  <div class="guide-pulse-card">
                    <div class="guide-pulse-card-head">
                      <Badge tone={item.status === 'worked' ? 'verified' : item.status === 'partial' ? 'standby' : 'danger'}>
                        {PULSE_STATUS_LABELS[locale][item.status]}
                      </Badge>
                      <span>{item.ago}</span>
                    </div>
                    <div class="guide-pulse-card-ctx">{item.context}</div>
                    <p class="guide-pulse-card-detail">{item.detail}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          <AutoDisclaimer kinds={guide.disclaimers} locale={locale} />
        </article>

        {/* Weightless Sticky Right Rail */}
        <aside class="guide-rail" aria-label={isZh ? '本页目录与快捷工具' : 'On this page and tools'}>
          {tocItems.length > 0 && (
            <nav class="rail-section" aria-label={isZh ? '本页目录' : 'On this page'}>
              <p class="rail-heading">{isZh ? '本页目录' : 'ON THIS PAGE'}</p>
              <ol class="toc-list">
                {tocItems.map((item) => (
                  <li>
                    <a href={`#${item.id}`} class="toc-link">{item.label}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          {guide.directTools.length > 0 && (
            <div class="entity-rail-group">
              <p class="entity-rail-title">{isZh ? '配套工具' : 'TOOLS'}</p>
              {guide.directTools.map((tool) => (
                <a href={lp(tool.href)} class="entity-rail-link">
                  <span>{tool.label}</span>
                  <span class="entity-rail-link-code">→</span>
                </a>
              ))}
            </div>
          )}

          <ul class="rail-ai-list">
            <li>
              <a href={preferGoogleHref} target="_blank" rel="noopener noreferrer" class="rail-ai-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M21.35 11.1h-9.18v2.92h5.27c-.23 1.24-.93 2.29-1.98 2.99v2.48h3.2c1.87-1.72 2.95-4.26 2.95-7.27 0-.38-.03-.76-.09-1.12h-.17ZM12.17 22c2.67 0 4.91-.88 6.55-2.4l-3.2-2.48c-.89.6-2.02.95-3.35.95-2.58 0-4.76-1.74-5.54-4.08H3.32v2.56A9.89 9.89 0 0 0 12.17 22ZM6.63 13.99a5.95 5.95 0 0 1 0-3.98V7.45H3.32a9.9 9.9 0 0 0 0 9.1l3.31-2.56ZM12.17 5.93c1.45 0 2.75.5 3.78 1.48l2.83-2.83C17.07 2.99 14.84 2 12.17 2a9.89 9.89 0 0 0-8.85 5.45l3.31 2.56c.78-2.34 2.96-4.08 5.54-4.08Z" />
                </svg>
                <span>{isZh ? '设为 Google 优先来源' : 'Prefer on Google'}</span>
              </a>
            </li>
            <li>
              <a href={chatGptHref} target="_blank" rel="noopener noreferrer" class="rail-ai-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.896zm16.597 3.855-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365 2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z" />
                </svg>
                <span>{isZh ? '向 ChatGPT 提问' : 'Ask ChatGPT'}</span>
              </a>
            </li>
            <li>
              <a href={geminiHref} target="_blank" rel="noopener noreferrer" class="rail-ai-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2c.4 4.8 4.2 8.6 9 9-4.8.4-8.6 4.2-9 9-.4-4.8-4.2-8.6-9-9 4.8-.4 8.6-4.2 9-9Z" />
                </svg>
                <span>{isZh ? '向 Gemini 提问' : 'Ask Gemini'}</span>
              </a>
            </li>
          </ul>

          {siblingGuides.length > 0 && (
            <div class="entity-rail-group">
              <p class="entity-rail-title">{isZh ? `更多${pillar.nameZh}指南` : `MORE IN ${pillar.name.toUpperCase()}`}</p>
              {siblingGuides.map((sib) => (
                <a href={lp(`/guides/${sib.slug}/`)} class="entity-rail-link">
                  <span>{isZh ? sib.titleZh : sib.title}</span>
                </a>
              ))}
            </div>
          )}
        </aside>
      </div>

      {/* Apple-Style Bottom Breadcrumb */}
      <nav class="breadcrumb article-bottom-breadcrumb" aria-label="Breadcrumb">
        <a href={lp('/')}>{isZh ? '首页' : 'Home'}</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href={lp(`/${pillar.id}/`)}>{isZh ? pillar.nameZh : pillar.name}</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">{isZh ? guide.titleZh : guide.title}</span>
      </nav>
    </div>
  </div>
</BaseShell>
