---
/**
 * Mother Template 3: 32 Deep Feature Guides (/guides/[slug]/)
 * Unified 3-Column Reading Frame (Left Sticky LocalNav 220px | Center 720-760px | Right Companion 280px)
 * Routes internal body across 4 Archetype Variants:
 *   A: playbook (Steps + STOP & CHECK + embedded tools)
 *   B: matrix   (Anti-hedging Decision Comparison Table + cards)
 *   C: rescue   (Filterable Visual Rescue Gallery / Chronological Effective-Date Feed)
 *   D: editorial (16:9 Visual Hero + 3-line Lead Hook <=10% + 90% gallery & copyable Chinese names)
 */
import BaseShell from './BaseShell.astro';
import ResponsiveBreadcrumb from '../components/nav/ResponsiveBreadcrumb.astro';
import VerifyMetaBar from '../components/compliance/VerifyMetaBar.astro';
import AutoDisclaimer from '../components/compliance/AutoDisclaimer.astro';
import GroundPulsePanel from '../components/entity/GroundPulsePanel.astro';
import Badge from '@ui/data-display/Badge.astro';
import Button from '@ui/actions/Button.astro';
import DataTable from '@ui/data-display/DataTable.astro';
import { getGuidesByPillar, type GuideDefinition } from '@data/paradigm-e/guides';
import { PILLAR_BY_ID } from '@data/paradigm-e/pillars';
import { RESCUE_FILTER_ZH } from '@data/paradigm-e/i18n-zh';
import { getLocaleFromContext, localePath } from '@i18n/ui';

interface Props {
  guide: GuideDefinition;
}

const { guide } = Astro.props;
const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (p: string) => localePath(p, locale);
const pillar = PILLAR_BY_ID[guide.pillar];
const siblingGuides = getGuidesByPillar(guide.pillar);
const mdHref = `/guides/${guide.slug}.md`;

const tocItems = guide.archetype === 'playbook' && guide.steps
  ? guide.steps.map((s) => ({ id: `step-${s.number}`, label: s.title }))
  : [
      { id: 'hard-facts', label: isZh ? '关键事实' : 'Key Facts' },
      { id: 'core-module', label: isZh ? '核心内容' : 'Details' },
      { id: 'related-mesh', label: isZh ? '相关页面' : 'Related Pages' },
      { id: 'ground-pulse', label: isZh ? '现场实测' : 'Field Reports' },
    ];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.leadHook,
  dateModified: guide.lastVerified,
  publisher: { '@type': 'Organization', name: 'ChinaWao' },
};
---
<BaseShell
  title={isZh ? guide.titleZh : guide.title}
  description={isZh ? guide.leadHookZh : guide.leadHook}
  activePillar={guide.pillar}
  persona={guide.persona}
  alternateMd={mdHref}
  jsonLd={jsonLd}
  type="article"
>
  <div class="container" style="padding-bottom: var(--space-8);">
    <ResponsiveBreadcrumb
      items={[
        { label: isZh ? '首页' : 'Home', href: lp('/') },
        { label: isZh ? pillar.nameZh : pillar.name, href: lp(`/${pillar.id}/`) },
        { label: isZh ? '深度主题' : 'Guides', href: lp('/guides/') },
        { label: isZh ? guide.titleZh : guide.title },
      ]}
      mobileBackHref={lp(`/${pillar.id}/`)}
      mobileBackLabel={isZh ? pillar.nameZh : pillar.name}
    />

    <div class="pe-guide-grid">
      {/* Left Rail (Sticky 220px): Page TOC + Sibling Pillar Guides */}
      <aside class="pe-local-nav" aria-label={isZh ? '本页目录与同栏目指南' : 'Page Navigation'}>
        <div>
          <span class="pe-mega-col-title">{isZh ? '本页目录' : 'On This Page'}</span>
          <ul class="pe-local-nav-list">
            {tocItems.map((t) => (
              <li><a href={`#${t.id}`}>{t.label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <span class="pe-mega-col-title">
            {isZh ? `${pillar.nameZh}更多指南` : `More in ${pillar.name}`}
          </span>
          <ul class="pe-local-nav-list">
            {siblingGuides.map((sib) => (
              <li>
                <a
                  href={lp(`/guides/${sib.slug}/`)}
                  aria-current={sib.slug === guide.slug ? 'page' : undefined}
                >
                  {isZh ? sib.titleZh : sib.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>

      {/* Center Column: Structured Guide Content */}
      <article class="pe-guide-main">
        {guide.archetype === 'editorial' && guide.heroImage && (
          <div class="pe-editorial-hero">
            <img src={guide.heroImage} alt={isZh ? guide.titleZh : guide.title} loading="eager" />
          </div>
        )}

        <header style="margin-bottom: var(--space-5);">
          <h1>{isZh ? guide.titleZh : guide.title}</h1>
          {guide.archetype === 'editorial' ? (
            <blockquote class="pe-editorial-quote">
              {isZh ? guide.leadHookZh : guide.leadHook}
            </blockquote>
          ) : (
            <p class="archive-lead" style="margin-top:var(--space-3);">
              {isZh ? guide.leadHookZh : guide.leadHook}
            </p>
          )}
        </header>

        {/* Key Facts Strip */}
        <section id="hard-facts" aria-label={isZh ? '关键事实参数' : 'Key Facts'}>
          <div class="pe-hard-facts">
            {guide.hardFacts.map((fact) => (
              <div class="pe-fact-slot">
                <span class="pe-fact-slot-label">{fact.label}</span>
                <strong class="pe-fact-slot-val">{fact.value}</strong>
                <span class="pe-fact-slot-src">{fact.source} · {fact.verifiedDate}</span>
              </div>
            ))}
          </div>
        </section>

        {/* Core Guide Body */}
        <section id="core-module" style="margin-top: var(--space-5);">
          {guide.archetype === 'playbook' && guide.steps && (
            <div>
              <ol class="cw-stepper-list" style="display:flex;flex-wrap:wrap;gap:0.5rem;list-style:none;padding:0;margin-bottom:var(--space-5);">
                {guide.steps.map((s) => (
                  <li>
                    <a href={`#step-${s.number}`} class="pe-mega-chip">
                      {s.title.length > 28 ? `${s.title.slice(0, 28)}…` : s.title}
                    </a>
                  </li>
                ))}
              </ol>

              {guide.steps.map((step) => (
                <section id={`step-${step.number}`} class="pe-step-card">
                  <h2 style="font-size:1.35rem;">{step.title}</h2>
                  <div class="pe-stop-check" role="note">
                    {step.stopCheck}
                  </div>
                  <p style="font-size:var(--text-base);line-height:1.7;color:var(--ink-primary);">
                    {step.summary}
                  </p>
                  <ul style="margin-top:var(--space-3);padding-inline-start:1.25rem;display:grid;gap:0.4rem;font-size:var(--text-sm);color:var(--ink-secondary);">
                    {step.checklist.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  {step.linkedRoute && (
                    <div style="margin-top:var(--space-4);">
                      <Button href={lp(step.linkedRoute.href)} variant="secondary" size="sm">
                        {step.linkedRoute.label}
                      </Button>
                    </div>
                  )}
                </section>
              ))}
            </div>
          )}

          {guide.archetype === 'matrix' && guide.matrixRows && (
            <div>
              <h2 style="font-size:1.35rem;margin-bottom:var(--space-3);">
                {isZh ? '方案对比' : 'Scenario Comparison'}
              </h2>
              <DataTable
                id={`matrix-${guide.slug}`}
                caption={isZh ? `${guide.titleZh}对比表` : `${guide.title} Comparison`}
                columns={[
                  { key: 'option', label: isZh ? '选项' : 'Option', rowHeader: true },
                  { key: 'bestFor', label: isZh ? '适合情况' : 'Best For' },
                  { key: 'avoidIf', label: isZh ? '不建议情况' : 'Skip / Avoid If' },
                  { key: 'costRange', label: isZh ? '参考费用' : 'Typical Cost' },
                  { key: 'hiddenTrap', label: isZh ? '注意事项' : 'Watch Out For' },
                ]}
                rows={guide.matrixRows.map((r) => ({
                  option: r.href ? { text: r.option, href: lp(r.href) } : r.option,
                  bestFor: r.bestFor,
                  avoidIf: r.avoidIf,
                  costRange: r.costRange,
                  hiddenTrap: r.hiddenTrap,
                }))}
              />
            </div>
          )}

          {guide.archetype === 'rescue' && guide.rescueItems && (
            <div data-pe-rescue-root>
              {guide.rescueFilters && (
                <div class="pe-facet-group" role="group" aria-label={isZh ? '按分类筛选' : 'Filter by category'}>
                  {guide.rescueFilters.map((f, idx) => (
                    <button
                      type="button"
                      class="pe-facet-chip"
                      aria-pressed={idx === 0 ? 'true' : 'false'}
                      data-pe-rescue-filter={f}
                    >
                      {isZh ? (RESCUE_FILTER_ZH[f] ?? f) : f}
                    </button>
                  ))}
                </div>
              )}

              <div style="display:grid;gap:var(--space-3);margin-top:var(--space-4);">
                {guide.rescueItems.map((item) => (
                  <article class="pe-side-card" data-pe-rescue-card={item.appOrGroup}>
                    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:0.4rem;margin-bottom:0.4rem;">
                      <Badge tone="danger">{isZh ? (RESCUE_FILTER_ZH[item.appOrGroup] ?? item.appOrGroup) : item.appOrGroup}</Badge>
                      {item.effectiveDate && (
                        <Badge tone="verified">{item.effectiveDate}</Badge>
                      )}
                    </div>
                    <h2 style="font-size:1.15rem;">
                      <a href={lp(item.href)} class="text-link">{item.title}</a>
                    </h2>
                    <p style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--accent-seal-text);margin-top:0.25rem;">
                      {item.chineseSignal}
                    </p>
                    <p style="margin-top:0.4rem;font-size:var(--text-sm);color:var(--ink-secondary);line-height:1.55;">
                      {item.actionSummary}
                    </p>
                    <div style="margin-top:var(--space-3);display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);">
                      {item.sourceAnchor ? (
                        <span style="font-family:var(--font-mono);font-size:var(--text-2xs);color:var(--ink-tertiary);">
                          {isZh ? `来源：${item.sourceAnchor}` : `Source: ${item.sourceAnchor}`}
                        </span>
                      ) : <span />}
                      <a href={lp(item.href)} class="editorial-link" style="font-size:var(--text-xs);">
                        {isZh ? '查看详情 →' : 'View Details →'}
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )}

          {guide.archetype === 'editorial' && guide.galleryItems && (
            <div style="display:grid;gap:var(--space-5);">
              {guide.galleryItems.map((card) => (
                <article class="pe-step-card">
                  <h2 style="font-size:1.35rem;">{card.title}</h2>
                  <p style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--ink-secondary);margin-top:0.2rem;">
                    {card.chineseName}
                  </p>
                  <p style="margin-top:var(--space-3);font-size:var(--text-base);line-height:1.7;">
                    {card.summary}
                  </p>
                  <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);margin-top:var(--space-4);">
                    <Button
                      variant="secondary"
                      size="sm"
                      data-pe-copy={card.copyTerm}
                      data-pe-copy-toast={isZh ? `已复制中文名：${card.copyTerm}` : `Copied Chinese name: ${card.copyTerm}`}
                    >
                      {isZh ? `复制高德中文名：${card.copyTerm}` : `Copy Amap Name: ${card.copyTerm}`}
                    </Button>
                    {card.href && (
                      <Button href={lp(card.href)} variant="ghost" size="sm">
                        {isZh ? '查看详情 →' : 'Open Details →'}
                      </Button>
                    )}
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>

        {/* Related Pages */}
        <section id="related-mesh" style="margin-top:var(--space-6);padding-top:var(--space-5);border-top:1px solid var(--rule-subtle);">
          <h2 style="font-size:var(--text-sm);font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;color:var(--ink-secondary);">
            {isZh ? '相关页面' : 'Related Pages'}
          </h2>
          <div class="pe-mega-chips" style="margin-top:var(--space-3);">
            {guide.relatedEntities.map((ent) => (
              <a href={lp(ent.href)} class="pe-mega-chip">
                {ent.label}
              </a>
            ))}
          </div>
        </section>

        <div id="ground-pulse">
          <GroundPulsePanel items={guide.pulse} locale={locale} />
        </div>

        <AutoDisclaimer kinds={guide.disclaimers} locale={locale} />
      </article>

      {/* Right Companion Rail */}
      <aside class="pe-guide-companion" aria-label={isZh ? '核验信息与快捷工具' : 'Verification & Tools'}>
        <div class="pe-side-card">
          <span class="pe-mega-col-title">{isZh ? '更新记录' : 'Verification'}</span>
          <VerifyMetaBar
            lastVerified={guide.lastVerified}
            tier={guide.tier}
            mdHref={mdHref}
            locale={locale}
          />
        </div>

        <div class="pe-side-card">
          <span class="pe-mega-col-title">{isZh ? '配套清单' : 'Checklist Kit'}</span>
          <Button href={lp(guide.stackLink.href)} variant="primary" size="sm">
            {guide.stackLink.label} →
          </Button>
        </div>

        <div class="pe-side-card">
          <span class="pe-mega-col-title">{isZh ? '配套工具' : 'Related Tools'}</span>
          <ul class="pe-mega-links">
            {guide.directTools.map((tool) => (
              <li>
                <a href={lp(tool.href)}>
                  <span>{tool.label}</span>
                  <span>→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="pe-side-card">
          <span class="pe-mega-col-title">{isZh ? '数据与接口' : 'Markdown & API'}</span>
          <div style="display:flex;flex-wrap:wrap;gap:0.4rem;">
            <a href={mdHref} class="pe-mega-chip">{isZh ? '查看 Markdown' : 'View .md'}</a>
            <a href={lp('/portals/#mcp-setup')} class="pe-mega-chip">{isZh ? 'MCP 接入' : 'MCP Setup'}</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseShell>
