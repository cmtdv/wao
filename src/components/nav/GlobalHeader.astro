---
/**
 * Global Single-Row Header (Wise-Inspired Merged Navigation)
 * - Non-sticky (scrolls naturally away so long-form articles get 100% viewport height)
 * - Desktop: Brand (left) + EmDash Categories with hover/focus subtopic dropdowns + Search/Lang/Theme (right)
 * - Mobile (< 960px): Single 56px bar; categories & subtopics live inside the slide-out drawer as accordions
 */
import type { getTaxonomyTermsWithCacheHint } from 'emdash';
import BrandSeal from '@site/BrandSeal.astro';
import Icon from '@site/Icon.astro';
import { HeaderUtilityMenus } from '../coss-islands/HeaderUtilityMenus';
import { categoryPath } from '@lib/format';
import { localePath, stripLocalePrefix, switchLocaleHref, type Locale } from '@i18n/ui';

type Term = Awaited<ReturnType<typeof getTaxonomyTermsWithCacheHint>>['data'][number];

interface Props {
  siteTitle?: string;
  roots?: Term[];
  terms?: Term[];
  locale?: Locale;
  originalPathname?: string;
  activePillar?: string;
}

const {
  siteTitle = 'ChinaWao',
  roots = [],
  terms = [],
  locale = 'en',
  originalPathname,
} = Astro.props;

const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);
const pathname = stripLocalePrefix(originalPathname ?? Astro.url.pathname);
const enHref = switchLocaleHref(Astro.url, 'en', originalPathname);
const zhHref = switchLocaleHref(Astro.url, 'zh', originalPathname);

const flatten = (items: Term[]): Term[] =>
  items.flatMap((item) => [item, ...flatten(item.children ?? [])]);
const allTerms = flatten(terms.length > 0 ? terms : roots);

function getChildren(root: Term): Term[] {
  return root.children?.length
    ? root.children
    : allTerms.filter((t) => t.parentId === root.id);
}

const navCategories = roots.slice(0, 6);
const extraCategories = roots.slice(6);
---
<header class="pe-header cw-header-single" data-pe-header>
  <div class="container cw-nav-inner">
    <a href={lp('/')} class="pe-brand" aria-label={`${siteTitle} ${isZh ? '首页' : 'Home'}`}>
      <BrandSeal />
      <span>{siteTitle}<span class="brand-period">.</span></span>
    </a>

    <button
      type="button"
      class="pe-mobile-search-bar"
      commandfor="pe-cmd-dialog"
      command="show-modal"
      aria-label={isZh ? '打开全站搜索' : 'Open search'}
    >
      <Icon name="search" size={15} />
      <span>{isZh ? '搜索文章、高铁、免签…' : 'Search articles, rail, visa…'}</span>
    </button>

    <nav class="cw-main-nav" aria-label={isZh ? '文章分类导航' : 'Primary navigation'}>
      <ul class="cw-sub-list">
        {navCategories.map((cat) => {
          const children = getChildren(cat);
          const catPath = categoryPath(cat.slug);
          const catHref = lp(catPath);
          const isSelfActive = pathname === catPath || pathname === `${catPath}/`;
          const isChildActive = children.some((c) => {
            const cp = categoryPath(c.slug);
            return pathname === cp || pathname === `${cp}/`;
          });
          const isActive = isSelfActive || isChildActive;

          return (
            <li class:list={['cw-sub-item', children.length > 0 && 'cw-sub-item--has-menu']}>
              <a
                href={catHref}
                class="cw-sub-link"
                aria-current={isActive ? 'true' : undefined}
              >
                <span>{cat.label}</span>
                {children.length > 0 && <Icon name="down" size={12} />}
              </a>

              {children.length > 0 && (
                <div class="cw-sub-dropdown" role="region" aria-label={cat.label}>
                  <a href={catHref} class="cw-sub-dropdown-all">
                    <span>{isZh ? `全部「${cat.label}」` : `All ${cat.label}`}</span>
                    <Icon name="arrow" size={13} />
                  </a>
                  <ul class="cw-sub-dropdown-list">
                    {children.map((sub) => {
                      const subPath = categoryPath(sub.slug);
                      const isSubCurrent = pathname === subPath || pathname === `${subPath}/`;
                      return (
                        <li>
                          <a
                            href={lp(subPath)}
                            class="cw-sub-dropdown-link"
                            aria-current={isSubCurrent ? 'page' : undefined}
                          >
                            {sub.label}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              )}
            </li>
          );
        })}

        {extraCategories.length > 0 && (
          <li class="cw-sub-item cw-sub-item--has-menu">
            <a
              href={lp('/topics/')}
              class="cw-sub-link"
              aria-current={pathname.startsWith('/topics') || pathname.startsWith('/tags') ? 'true' : undefined}
            >
              <span>{isZh ? '更多' : 'More'}</span>
              <Icon name="down" size={12} />
            </a>
            <div class="cw-sub-dropdown" role="region" aria-label={isZh ? '更多栏目与索引' : 'More topics and indexes'}>
              <ul class="cw-sub-dropdown-list">
                {extraCategories.map((cat) => (
                  <li>
                    <a href={lp(categoryPath(cat.slug))} class="cw-sub-dropdown-link">
                      {cat.label}
                    </a>
                  </li>
                ))}
                <li>
                  <a href={lp('/posts/')} class="cw-sub-dropdown-link">
                    {isZh ? '全部文章' : 'All Articles'}
                  </a>
                </li>
                <li>
                  <a href={lp('/topics/')} class="cw-sub-dropdown-link">
                    {isZh ? '全部栏目索引' : 'All Topics'}
                  </a>
                </li>
                <li>
                  <a href={lp('/tags/')} class="cw-sub-dropdown-link">
                    {isZh ? '主题标签' : 'Tags'}
                  </a>
                </li>
              </ul>
            </div>
          </li>
        )}
      </ul>
    </nav>

    <div class="pe-dock">
      <div class="cw-media-links" aria-label={isZh ? '视听频道' : 'Watch and Listen'}>
        <a
          href={lp('/watch/')}
          class="cw-media-link"
          aria-current={pathname.startsWith('/watch') ? 'page' : undefined}
        >
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2.5" y="4" width="19" height="16" rx="3" />
            <polygon points="10.2 8.75 15.8 12 10.2 15.25 10.2 8.75" fill="currentColor" stroke="none" />
          </svg>
          <span>{isZh ? '看' : 'Watch'}</span>
        </a>
        <a
          href={lp('/listen/')}
          class="cw-media-link"
          aria-current={pathname.startsWith('/listen') ? 'page' : undefined}
        >
          <svg
            aria-hidden="true"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3" />
          </svg>
          <span>{isZh ? '听' : 'Listen'}</span>
        </a>
      </div>

      <span class="cw-dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="pe-cmd-trigger"
        commandfor="pe-cmd-dialog"
        command="show-modal"
        aria-label={isZh ? '打开全站搜索' : 'Open search'}
        title={isZh ? '搜索 (Ctrl+K)' : 'Search (Ctrl+K)'}
      >
        <Icon name="search" size={16} />
      </button>

      <HeaderUtilityMenus
        client:load
        locale={locale}
        enHref={enHref}
        zhHref={zhHref}
      />

      <button
        type="button"
        class="icon-btn pe-mobile-menu-btn"
        commandfor="mobile-drawer"
        command="show-modal"
        aria-label={isZh ? '打开菜单' : 'Open menu'}
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-drawer" closedby="any" class="mobile-drawer" aria-label={isZh ? '导航菜单' : 'Navigation menu'}>
  <div class="drawer-head">
    <a href={lp('/')} class="pe-brand">
      <BrandSeal />
      <span>{siteTitle}<span class="brand-period">.</span></span>
    </a>
    <button
      type="button"
      class="icon-btn"
      commandfor="mobile-drawer"
      command="close"
      aria-label={isZh ? '关闭菜单' : 'Close menu'}
    >
      <Icon name="close" size={20} />
    </button>
  </div>

  <div class="drawer-lang-row">
    <span class="t-label">{isZh ? '语言' : 'Language'}</span>
    <nav class="lang-switch" aria-label={isZh ? '切换语言' : 'Switch language'}>
      <a href={enHref} hreflang="en" class="lang-switch-link" aria-current={locale === 'en' ? 'true' : undefined}>English</a>
      <a href={zhHref} hreflang="zh-CN" class="lang-switch-link" aria-current={locale === 'zh' ? 'true' : undefined}>简体中文</a>
    </nav>
  </div>

  {/* Wise-style mobile drawer: Watch/Listen + Category accordions on top */}
  <nav aria-label={isZh ? '文章分类' : 'Categories'}>
    <ul class="drawer-links">
      <li>
        <a href={lp('/watch/')} class="cw-drawer-media-link" aria-current={pathname.startsWith('/watch') ? 'page' : undefined}>
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2.5" y="4" width="19" height="16" rx="3" />
            <polygon points="10.2 8.75 15.8 12 10.2 15.25 10.2 8.75" fill="currentColor" stroke="none" />
          </svg>
          <span>{isZh ? '看' : 'Watch'}</span>
        </a>
      </li>
      <li>
        <a href={lp('/listen/')} class="cw-drawer-media-link" aria-current={pathname.startsWith('/listen') ? 'page' : undefined}>
          <svg
            aria-hidden="true"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3" />
          </svg>
          <span>{isZh ? '听' : 'Listen'}</span>
        </a>
      </li>
      <li>
        <a href={lp('/posts/')} aria-current={pathname === '/posts/' ? 'page' : undefined}>
          {isZh ? '全部文章' : 'All Articles'}
        </a>
      </li>
      {roots.map((cat) => {
        const children = getChildren(cat);
        return (
          <li>
            {children.length > 0 ? (
              <details class="cw-drawer-accordion">
                <summary>
                  <span>{cat.label}</span>
                  <Icon name="down" size={14} />
                </summary>
                <ul class="cw-drawer-sublist">
                  <li>
                    <a href={lp(categoryPath(cat.slug))}>
                      {isZh ? `全部「${cat.label}」` : `All ${cat.label}`}
                    </a>
                  </li>
                  {children.map((sub) => (
                    <li>
                      <a href={lp(categoryPath(sub.slug))}>{sub.label}</a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={lp(categoryPath(cat.slug))}>{cat.label}</a>
            )}
          </li>
        );
      })}
    </ul>
  </nav>

  <nav aria-label={isZh ? '站内索引' : 'Site links'}>
    <ul class="drawer-links">
      <li><a href={lp('/topics/')}>{isZh ? '栏目总索引' : 'Topics Index'}</a></li>
      <li><a href={lp('/tags/')}>{isZh ? '主题标签' : 'Tags'}</a></li>
      <li><a href={lp('/search/')}>{isZh ? '全文检索' : 'Search'}</a></li>
      <li><a href={lp('/pages/editorial-standards')}>{isZh ? '核验规范' : 'Standards'}</a></li>
      <li><a href={lp('/pages/about-chinawao')}>{isZh ? '关于 ChinaWao' : 'About'}</a></li>
    </ul>
  </nav>
</dialog>
