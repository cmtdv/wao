---
/**
 * Global Single-Row Header — ChinaWao IA Spec v3.2 (6 Pillars × 9 Dropdowns + Utility Dock)
 * - Smart-reveal sticky 64px header (hides on scroll down, reveals smoothly on scroll up)
 * - Exact v3.2 pillar order: Travel → Live & Work → Business → Places → Culture & Life → China Atlas
 * - Each dropdown strictly capped at 9 items (54 dropdown + 5 hub-only on pillar pages = 59 total)
 * - Supports ?nav=phase1 preview for v3.2 Chapter 3 single-pillar flat fallback
 * - Right Utility Dock (D1 Tools/Cards, D2 Data/MCP, D3 Pulse, D4 ⌘K Search) + 1-click US/中文 toggle
 */
import type { getTaxonomyTermsWithCacheHint } from 'emdash';
import BrandSeal from '@site/BrandSeal.astro';
import Icon from '@site/Icon.astro';
import cnFlagUrl from 'circle-flags/flags/cn.svg?url';
import usFlagUrl from 'circle-flags/flags/us.svg?url';
import { V32_PILLARS, getPhase1FlatSections } from '@data/taxonomy-v32';
import { localePath, stripLocalePrefix, switchLocaleHref, type Locale } from '@i18n/ui';

type Term = Awaited<ReturnType<typeof getTaxonomyTermsWithCacheHint>>['data'][number];

interface Props {
  siteTitle?: string;
  roots?: Term[];
  terms?: Term[];
  locale?: Locale;
  originalPathname?: string;
  activePillar?: string;
}

const {
  siteTitle = 'ChinaWao',
  locale = 'en',
  originalPathname,
  activePillar,
} = Astro.props;

const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);
const pathname = stripLocalePrefix(originalPathname ?? Astro.url.pathname);
const enHref = switchLocaleHref(Astro.url, 'en', originalPathname);
const zhHref = switchLocaleHref(Astro.url, 'zh', originalPathname);

// v3.2 Chapter 3: support ?nav=phase1 flat-fallback preview
const isPhase1Mode = Astro.url.searchParams.get('nav') === 'phase1';
const phase1Sections = isPhase1Mode ? getPhase1FlatSections() : [];

// Compact top-bar labels so 6 pillars + Utility Dock fit on a single spacious row
const COMPACT_NAV_LABELS: Record<string, { zh: string; en: string }> = {
  travel: { zh: '旅行', en: 'Travel' },
  live: { zh: '长居', en: 'Live' },
  business: { zh: '商务', en: 'Business' },
  places: { zh: '地点', en: 'Places' },
  culture: { zh: '文化', en: 'Culture' },
  atlas: { zh: '读懂中国', en: 'Atlas' },
};

const normalizedActive = activePillar === 'visit' ? 'travel' : activePillar;
---
<header class="pe-header cw-header-single" data-pe-header>
  <div class="container cw-nav-inner">
    <a href={lp('/')} class="pe-brand" aria-label={`${siteTitle} ${isZh ? '首页' : 'Home'}`}>
      <BrandSeal />
      <span>{siteTitle}<span class="brand-period">.</span></span>
    </a>

    <button
      type="button"
      class="pe-mobile-search-bar"
      commandfor="pe-cmd-dialog"
      command="show-modal"
      aria-label={isZh ? '打开全站搜索' : 'Open search'}
    >
      <Icon name="search" size={15} />
      <span>{isZh ? '搜索栏目、城市、免签、工具…' : 'Search hubs, cities, visa, tools…'}</span>
    </button>

    <nav class="cw-main-nav" aria-label={isZh ? '主导航' : 'Primary navigation'}>
      <ul class="cw-sub-list">
        {isPhase1Mode ? (
          phase1Sections.map((sec) => {
            const isSecActive = pathname === sec.hubPath || pathname === sec.hubPath.replace(/\/$/, '');
            return (
              <li class="cw-sub-item">
                <a
                  href={lp(sec.hubPath)}
                  class="cw-sub-link"
                  aria-current={isSecActive ? 'page' : undefined}
                >
                  <span>{isZh ? sec.navZh : sec.navEn}</span>
                </a>
              </li>
            );
          })
        ) : (
          V32_PILLARS.map((pillar) => {
            const dropdownChildren = pillar.children.filter((c) => c.inDropdown).slice(0, 9);
            const pillarHref = lp(pillar.path);
            const isActive =
              normalizedActive === pillar.id ||
              pathname === pillar.path ||
              pathname.startsWith(`/${pillar.id}/`);
            const compactLabel = COMPACT_NAV_LABELS[pillar.id] ?? { zh: pillar.navZh, en: pillar.navEn };

            return (
              <li class="cw-sub-item cw-sub-item--has-menu">
                <a
                  href={pillarHref}
                  class="cw-sub-link"
                  aria-current={isActive ? 'true' : undefined}
                  title={isZh ? `${pillar.navZh} · ${pillar.intentZh}` : pillar.navEn}
                >
                  <span>{isZh ? compactLabel.zh : compactLabel.en}</span>
                  <Icon name="down" size={12} />
                </a>

                <div
                  class="cw-sub-dropdown cw-sub-dropdown--v32"
                  role="region"
                  aria-label={isZh ? pillar.navZh : pillar.navEn}
                >
                  <a href={pillarHref} class="cw-sub-dropdown-all">
                    <span>{isZh ? `全部「${pillar.navZh}」` : `All ${pillar.navEn}`}</span>
                    <Icon name="arrow" size={13} />
                  </a>
                  <ul class="cw-sub-dropdown-list">
                    {dropdownChildren.map((sec) => {
                      const isSecCurrent =
                        pathname === sec.hubPath || pathname === sec.hubPath.replace(/\/$/, '');
                      return (
                        <li>
                          <a
                            href={lp(sec.hubPath)}
                            class="cw-sub-dropdown-link"
                            aria-current={isSecCurrent ? 'page' : undefined}
                          >
                            <span>{isZh ? sec.navZh : sec.navEn}</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </li>
            );
          })
        )}
      </ul>
    </nav>

    {/* Right Utility Dock (v3.2 D1 Tools/Cards · D2 Data/MCP · D3 Pulse · D4 Search) */}
    <div class="pe-dock">
      <div class="cw-utility-links" aria-label={isZh ? '实用工具坞' : 'Utility Dock'}>
        <div class="cw-sub-item cw-sub-item--has-menu">
          <a
            href={lp('/tools/')}
            class="cw-dock-link"
            aria-current={pathname.startsWith('/tools') || pathname.startsWith('/cards') ? 'page' : undefined}
          >
            <span>{isZh ? '工具' : 'Tools'}</span>
            <Icon name="down" size={11} />
          </a>
          <div class="cw-sub-dropdown cw-sub-dropdown--right" role="region" aria-label={isZh ? '工具与字卡' : 'Tools and Cards'}>
            <a href={lp('/tools/visa-checker/')} class="cw-sub-dropdown-all">
              <span>{isZh ? '240h 免签判定器' : 'Visa-Free Check'}</span>
              <Icon name="arrow" size={13} />
            </a>
            <ul class="cw-sub-dropdown-list">
              <li><a href={lp('/cards/')} class="cw-sub-dropdown-link">{isZh ? '离线亮屏字卡库' : 'Show-to-Local Cards'}</a></li>
              <li><a href={lp('/tools/ticket-calendar/')} class="cw-sub-dropdown-link">{isZh ? '跨时区放票日历' : 'Ticket Drop Calendar'}</a></li>
              <li><a href={lp('/tools/tax-points-calc/')} class="cw-sub-dropdown-link">{isZh ? '工签积分与个税算' : 'Work Points & IIT Calc'}</a></li>
              <li><a href={lp('/tools/')} class="cw-sub-dropdown-link">{isZh ? '全部实用工具 →' : 'All Tools →'}</a></li>
            </ul>
          </div>
        </div>

        <a
          href={lp('/portals/')}
          class="cw-dock-link"
          aria-current={pathname.startsWith('/portals') ? 'page' : undefined}
        >
          <span>{isZh ? '数据' : 'Data'}</span>
        </a>

        <a
          href={lp('/pulse/')}
          class="cw-dock-link"
          aria-current={pathname.startsWith('/pulse') ? 'page' : undefined}
        >
          <span>{isZh ? '实测' : 'Pulse'}</span>
        </a>
      </div>

      <span class="cw-dock-sep" aria-hidden="true"></span>

      <div class="cw-media-links" aria-label={isZh ? '视听频道' : 'Watch and Listen'}>
        <a
          href={lp('/watch/')}
          class="cw-media-link"
          aria-current={pathname.startsWith('/watch') ? 'page' : undefined}
        >
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2.5" y="4" width="19" height="16" rx="3" />
            <polygon points="10.2 8.75 15.8 12 10.2 15.25 10.2 8.75" fill="currentColor" stroke="none" />
          </svg>
          <span>{isZh ? '看' : 'Watch'}</span>
        </a>
        <a
          href={lp('/listen/')}
          class="cw-media-link"
          aria-current={pathname.startsWith('/listen') ? 'page' : undefined}
        >
          <svg
            aria-hidden="true"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3" />
          </svg>
          <span>{isZh ? '听' : 'Listen'}</span>
        </a>
      </div>

      <span class="cw-dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="pe-cmd-trigger"
        commandfor="pe-cmd-dialog"
        command="show-modal"
        aria-label={isZh ? '打开全站搜索' : 'Open search'}
        title={isZh ? '全站检索 (Ctrl+K)' : 'Search (Ctrl+K)'}
      >
        <Icon name="search" size={16} />
      </button>

      <a
        href={isZh ? enHref : zhHref}
        hreflang={isZh ? 'en' : 'zh-CN'}
        class="cw-lang-toggle"
        aria-label={isZh ? 'Switch to English' : '切换为简体中文'}
        title={isZh ? 'Switch to English' : '切换为简体中文'}
      >
        <img
          src={isZh ? usFlagUrl : cnFlagUrl}
          alt=""
          aria-hidden="true"
          width="16"
          height="16"
          decoding="async"
          class="cw-lang-flag"
        />
        <span>{isZh ? 'US' : '中文'}</span>
      </a>

      <button
        type="button"
        class="icon-btn pe-mobile-menu-btn"
        commandfor="mobile-drawer"
        command="show-modal"
        aria-label={isZh ? '打开菜单' : 'Open menu'}
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-drawer" closedby="any" class="mobile-drawer" aria-label={isZh ? '导航菜单' : 'Navigation menu'}>
  <div class="drawer-head">
    <a href={lp('/')} class="pe-brand">
      <BrandSeal />
      <span>{siteTitle}<span class="brand-period">.</span></span>
    </a>
    <button
      type="button"
      class="icon-btn"
      commandfor="mobile-drawer"
      command="close"
      aria-label={isZh ? '关闭菜单' : 'Close menu'}
    >
      <Icon name="close" size={20} />
    </button>
  </div>

  <div class="drawer-lang-row">
    <span class="t-label">{isZh ? '语言' : 'Language'}</span>
    <nav class="lang-switch" aria-label={isZh ? '切换语言' : 'Switch language'}>
      <a href={enHref} hreflang="en" class="lang-switch-link" aria-current={locale === 'en' ? 'true' : undefined}>English</a>
      <a href={zhHref} hreflang="zh-CN" class="lang-switch-link" aria-current={locale === 'zh' ? 'true' : undefined}>简体中文</a>
    </nav>
  </div>

  {/* v3.2 6 Pillars Accordion */}
  <nav aria-label={isZh ? '六大主柱' : '6 Content Pillars'}>
    <ul class="drawer-links">
      {V32_PILLARS.map((pillar) => (
        <li>
          <details class="cw-drawer-accordion" open={normalizedActive === pillar.id}>
            <summary>
              <span>{isZh ? pillar.navZh : pillar.navEn}</span>
              <Icon name="down" size={14} />
            </summary>
            <ul class="cw-drawer-sublist">
              <li>
                <a href={lp(pillar.path)}>
                  {isZh ? `全部「${pillar.navZh}」枢纽 →` : `All ${pillar.navEn} Hub →`}
                </a>
              </li>
              {pillar.children.map((sec) => (
                <li>
                  <a href={lp(sec.hubPath)}>{isZh ? sec.navZh : sec.navEn}</a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      ))}
    </ul>
  </nav>

  {/* Utility Dock + Media + Archive */}
  <nav aria-label={isZh ? '实用工具坞与频道' : 'Utility Dock & Channels'}>
    <ul class="drawer-links">
      <li><a href={lp('/tools/visa-checker/')}>{isZh ? '240h 免签判定器' : 'Visa-Free Check'}</a></li>
      <li><a href={lp('/tools/')}>{isZh ? '工具与字卡' : 'Tools & Cards'}</a></li>
      <li><a href={lp('/cards/')}>{isZh ? '离线亮屏字卡' : 'Show-to-Local Cards'}</a></li>
      <li><a href={lp('/portals/')}>{isZh ? '开放数据 / MCP' : 'Open Data / MCP'}</a></li>
      <li><a href={lp('/pulse/')}>{isZh ? '现场实测 Pulse' : 'Field Reports (Pulse)'}</a></li>
      <li><a href={lp('/posts/')}>{isZh ? '深度文章' : 'All Articles'}</a></li>
      <li><a href={lp('/watch/')}>{isZh ? '看（视频）' : 'Watch'}</a></li>
      <li><a href={lp('/listen/')}>{isZh ? '听（播客）' : 'Listen'}</a></li>
    </ul>
  </nav>
</dialog>
