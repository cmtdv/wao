---
/**
 * Global Two-Tier Sticky Header (Wise Blog Architecture)
 * - Row 1 (.cw-nav-top): Brand on left; global destinations (Articles / Topics / Tags) + Search + Language/Theme on right
 * - Row 2 (.cw-nav-sub): Editorial channel anchor ("志刊 / Blog") + dynamic EmDash categories with subtopic dropdowns
 */
import type { getTaxonomyTermsWithCacheHint } from 'emdash';
import BrandSeal from '@site/BrandSeal.astro';
import Icon from '@site/Icon.astro';
import { HeaderUtilityMenus } from '../coss-islands/HeaderUtilityMenus';
import { categoryPath } from '@lib/format';
import { localePath, stripLocalePrefix, switchLocaleHref, type Locale } from '@i18n/ui';

type Term = Awaited<ReturnType<typeof getTaxonomyTermsWithCacheHint>>['data'][number];

interface Props {
  siteTitle?: string;
  roots?: Term[];
  terms?: Term[];
  locale?: Locale;
  originalPathname?: string;
  activePillar?: string;
}

const {
  siteTitle = 'ChinaWao',
  roots = [],
  terms = [],
  locale = 'en',
  originalPathname,
} = Astro.props;

const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);
const pathname = stripLocalePrefix(originalPathname ?? Astro.url.pathname);
const enHref = switchLocaleHref(Astro.url, 'en', originalPathname);
const zhHref = switchLocaleHref(Astro.url, 'zh', originalPathname);

const flatten = (items: Term[]): Term[] =>
  items.flatMap((item) => [item, ...flatten(item.children ?? [])]);
const allTerms = flatten(terms.length > 0 ? terms : roots);

function getChildren(root: Term): Term[] {
  return root.children?.length
    ? root.children
    : allTerms.filter((t) => t.parentId === root.id);
}

const channelCategories = roots.slice(0, 7);
---
<header class="pe-header cw-header-two-tier" data-pe-header>
  {/* ROW 1: Global Site & Utility Bar */}
  <div class="cw-nav-top">
    <div class="container cw-nav-top-inner">
      <a href={lp('/')} class="pe-brand" aria-label={`${siteTitle} ${isZh ? '首页' : 'Home'}`}>
        <BrandSeal />
        <span>{siteTitle}<span class="brand-period">.</span></span>
      </a>

      <button
        type="button"
        class="pe-mobile-search-bar"
        commandfor="pe-cmd-dialog"
        command="show-modal"
        aria-label={isZh ? '打开全站搜索' : 'Open search'}
      >
        <Icon name="search" size={15} />
        <span>{isZh ? '搜索文章、高铁、免签…' : 'Search articles, rail, visa…'}</span>
      </button>

      <div class="cw-nav-top-right">
        <nav class="cw-top-links" aria-label={isZh ? '站点导航' : 'Site navigation'}>
          <a
            href={lp('/tags/')}
            class="cw-top-link"
            aria-current={pathname.startsWith('/tags') || pathname.startsWith('/tag/') ? 'page' : undefined}
          >
            {isZh ? '标签' : 'Tags'}
          </a>
          <a
            href={lp('/pages/editorial-standards')}
            class="cw-top-link"
            aria-current={pathname.startsWith('/pages/editorial-standards') ? 'page' : undefined}
          >
            {isZh ? '核验规范' : 'Standards'}
          </a>
          <a
            href={lp('/pages/about-chinawao')}
            class="cw-top-link"
            aria-current={pathname.startsWith('/pages/about-chinawao') ? 'page' : undefined}
          >
            {isZh ? '关于' : 'About'}
          </a>
        </nav>

        <div class="pe-dock">
          <button
            type="button"
            class="pe-cmd-trigger"
            commandfor="pe-cmd-dialog"
            command="show-modal"
            aria-label={isZh ? '打开全站搜索' : 'Open search'}
          >
            <Icon name="search" size={14} />
            <span class="cw-search-label">{isZh ? '搜索' : 'Search'}</span>
            <kbd class="cw-kbd" data-pe-shortcut-label>⌘K</kbd>
          </button>

          <HeaderUtilityMenus
            client:load
            locale={locale}
            enHref={enHref}
            zhHref={zhHref}
          />

          <button
            type="button"
            class="icon-btn pe-mobile-menu-btn"
            commandfor="mobile-drawer"
            command="show-modal"
            aria-label={isZh ? '打开菜单' : 'Open menu'}
          >
            <Icon name="menu" size={20} />
          </button>
        </div>
      </div>
    </div>
  </div>

  {/* ROW 2: Editorial Channel & Category Sub-Navigation Bar */}
  {channelCategories.length > 0 && (
    <div class="cw-nav-sub">
      <div class="container cw-nav-sub-inner">
        <a
          href={lp('/posts/')}
          class="cw-sub-brand"
          aria-current={pathname === '/posts/' ? 'page' : undefined}
        >
          {isZh ? '志刊' : 'Blog'}
        </a>

        <nav class="cw-sub-nav" aria-label={isZh ? '文章分类导航' : 'Editorial categories'}>
          <ul class="cw-sub-list">
            {channelCategories.map((cat) => {
              const children = getChildren(cat);
              const catPath = categoryPath(cat.slug);
              const catHref = lp(catPath);
              const isSelfActive = pathname === catPath || pathname === `${catPath}/`;
              const isChildActive = children.some((c) => {
                const cp = categoryPath(c.slug);
                return pathname === cp || pathname === `${cp}/`;
              });
              const isActive = isSelfActive || isChildActive;

              return (
                <li class:list={['cw-sub-item', children.length > 0 && 'cw-sub-item--has-menu']}>
                  <a
                    href={catHref}
                    class="cw-sub-link"
                    aria-current={isActive ? 'true' : undefined}
                  >
                    <span>{cat.label}</span>
                    {children.length > 0 && <Icon name="down" size={12} />}
                  </a>

                  {children.length > 0 && (
                    <div class="cw-sub-dropdown" role="region" aria-label={cat.label}>
                      <a href={catHref} class="cw-sub-dropdown-all">
                        <span>{isZh ? `全部「${cat.label}」` : `All ${cat.label}`}</span>
                        <Icon name="arrow" size={13} />
                      </a>
                      <ul class="cw-sub-dropdown-list">
                        {children.map((sub) => {
                          const subPath = categoryPath(sub.slug);
                          const isSubCurrent = pathname === subPath || pathname === `${subPath}/`;
                          return (
                            <li>
                              <a
                                href={lp(subPath)}
                                class="cw-sub-dropdown-link"
                                aria-current={isSubCurrent ? 'page' : undefined}
                              >
                                {sub.label}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    </div>
  )}
</header>

<dialog id="mobile-drawer" closedby="any" class="mobile-drawer" aria-label={isZh ? '导航菜单' : 'Navigation menu'}>
  <div class="drawer-head">
    <a href={lp('/')} class="pe-brand">
      <BrandSeal />
      <span>{siteTitle}<span class="brand-period">.</span></span>
    </a>
    <button
      type="button"
      class="icon-btn"
      commandfor="mobile-drawer"
      command="close"
      aria-label={isZh ? '关闭菜单' : 'Close menu'}
    >
      <Icon name="close" size={20} />
    </button>
  </div>

  <div class="drawer-lang-row">
    <span class="t-label">{isZh ? '语言' : 'Language'}</span>
    <nav class="lang-switch" aria-label={isZh ? '切换语言' : 'Switch language'}>
      <a href={enHref} hreflang="en" class="lang-switch-link" aria-current={locale === 'en' ? 'true' : undefined}>English</a>
      <a href={zhHref} hreflang="zh-CN" class="lang-switch-link" aria-current={locale === 'zh' ? 'true' : undefined}>简体中文</a>
    </nav>
  </div>

  <nav aria-label={isZh ? '内容导航' : 'Editorial navigation'}>
    <ul class="drawer-links">
      <li><a href={lp('/')} aria-current={pathname === '/' ? 'page' : undefined}>{isZh ? '首页' : 'Home'}</a></li>
      <li><a href={lp('/posts/')} aria-current={pathname.startsWith('/posts') ? 'page' : undefined}>{isZh ? '全部文章' : 'All Articles'}</a></li>
      <li><a href={lp('/topics/')} aria-current={pathname.startsWith('/topics') ? 'page' : undefined}>{isZh ? '栏目索引' : 'Topics'}</a></li>
      <li><a href={lp('/tags/')} aria-current={pathname.startsWith('/tags') ? 'page' : undefined}>{isZh ? '标签索引' : 'Tags'}</a></li>
      <li><a href={lp('/search/')} aria-current={pathname.startsWith('/search') ? 'page' : undefined}>{isZh ? '全站检索' : 'Search'}</a></li>
    </ul>
  </nav>

  {roots.length > 0 && (
    <nav aria-label={isZh ? '主要栏目' : 'Categories'}>
      <ul class="drawer-links">
        {roots.map((cat) => (
          <li>
            <a href={lp(categoryPath(cat.slug))} aria-current={pathname === categoryPath(cat.slug) ? 'page' : undefined}>
              {cat.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</dialog>
