---
/**
 * Global Command Palette (⌘K / Ctrl+K) — v3.2 6 Pillars + 59 Hubs + Utility Dock + Live EmDash Articles
 */
import Icon from '@site/Icon.astro';
import Badge from '@ui/data-display/Badge.astro';
import { V32_PILLARS, V32_ALL_SECTIONS, V32_UTILITY_DOCK } from '@data/taxonomy-v32';
import { getPublicPosts } from '@lib/cms';
import { postPath } from '@lib/format';
import { getLocaleFromContext, localePath } from '@i18n/ui';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);

const postsRes = await getPublicPosts({ limit: 12, locale }).catch(() => ({ entries: [] as never[] }));
const posts = postsRes.entries ?? [];
---
<dialog
  id="pe-cmd-dialog"
  class="pe-cmd-dialog"
  closedby="any"
  aria-labelledby="pe-cmd-title"
  data-pe-cmd-dialog
>
  <div class="pe-cmd-top">
    <Icon name="search" size={18} />
    <label id="pe-cmd-title" for="pe-cmd-input" class="visually-hidden">
      {isZh ? '输入关键词检索 6 大主柱、59 个二级栏目、工具或文章' : 'Search ChinaWao pillars, 59 hubs, tools, and articles'}
    </label>
    <input
      id="pe-cmd-input"
      type="search"
      class="pe-cmd-input"
      placeholder={isZh ? '搜索栏目、工具或文章，如："免签"、"支付"、"广交会"、"故宫"、"USCC"…' : 'Search hubs, tools, or articles, e.g. "visa", "Alipay", "Canton Fair", "USCC"…'}
      autocomplete="off"
      autocorrect="off"
      autocapitalize="none"
      spellcheck="false"
      autofocus
      data-pe-cmd-input
    />
    <button
      type="button"
      class="icon-btn"
      commandfor="pe-cmd-dialog"
      command="close"
      aria-label={isZh ? '关闭搜索面板' : 'Close search palette'}
    >
      <Icon name="close" size={18} />
    </button>
  </div>

  {/* Quick 6 Pillars + Utility Dock Strip */}
  <div
    style="padding:var(--space-3) var(--space-4);border-bottom:1px solid var(--border);background:var(--surface-sunken);"
    data-pe-cmd-quick-cards
  >
    <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.45rem;">
      <span style="font-family:var(--font-mono);font-size:var(--text-2xs);font-weight:500;color:var(--muted-foreground);text-transform:uppercase;letter-spacing:0.06em;">
        {isZh ? '核心频道与工具' : 'Topics & Tools'}
      </span>
      <a href={lp('/atlas/#topic-index')} class="text-link" style="font-size:var(--text-2xs);font-family:var(--font-mono);">
        {isZh ? '全部主题 →' : 'All Topics →'}
      </a>
    </div>
    <div class="pe-mega-chips">
      {V32_PILLARS.map((p) => (
        <a href={lp(p.path)} class="pe-mega-chip">
          {isZh ? p.navZh : p.navEn}
        </a>
      ))}
      <a href={lp('/tools/visa-checker/')} class="pe-mega-chip">
        {isZh ? '240h 免签判定' : 'Visa-Free Check'}
      </a>
      <a href={lp('/cards/')} class="pe-mega-chip">
        {isZh ? '亮屏字卡' : 'Show Cards'}
      </a>
    </div>
  </div>

  <div class="pe-cmd-results" role="region" aria-label={isZh ? '检索匹配结果' : 'Search matches'} data-pe-cmd-results>
    {/* Utility Dock Direct Hits */}
    {V32_UTILITY_DOCK.filter((d) => d.code !== 'D4').map((d) => (
      <a
        href={lp(d.href)}
        class="pe-cmd-row"
        data-pe-cmd-item
        data-search={`${d.code} ${d.nameZh} ${d.nameEn} ${d.routes}`.toLowerCase()}
      >
        <div>
          <span class="pe-cmd-row-title">{isZh ? d.nameZh : d.nameEn}</span>
        </div>
        <Badge tone="verified">{isZh ? '工具' : 'Tool'}</Badge>
      </a>
    ))}

    {/* Live EmDash Dispatches */}
    {posts.map((post) => {
      const slug = post.data.slug || post.id;
      const href = lp(postPath(slug));
      const primaryCat = post.data.terms?.category?.[0];
      const tagLabels = (post.data.terms?.tag ?? []).map((t) => t.label).join(' ');
      const searchStr = `${post.data.title} ${post.data.excerpt ?? ''} ${primaryCat?.label ?? ''} ${tagLabels}`.toLowerCase();
      return (
        <a
          href={href}
          class="pe-cmd-row"
          data-pe-cmd-item
          data-search={searchStr}
        >
          <div>
            <span class="pe-cmd-row-title">{post.data.title}</span>
            {post.data.excerpt && <span class="pe-cmd-row-sub">{post.data.excerpt}</span>}
          </div>
          <Badge tone="editorial">
            {primaryCat ? primaryCat.label : (isZh ? '文章' : 'Article')}
          </Badge>
        </a>
      );
    })}

    {/* All 59 v3.2 Secondary Hubs */}
    {V32_ALL_SECTIONS.map((sec) => {
      const searchStr = `${sec.code} ${sec.navZh} ${sec.navEn} ${sec.slug} ${sec.scopeZh} ${sec.ssotRoutes.join(' ')}`.toLowerCase();
      return (
        <a
          href={lp(sec.hubPath)}
          class="pe-cmd-row"
          data-pe-cmd-item
          data-search={searchStr}
        >
          <div>
            <span class="pe-cmd-row-title">{isZh ? sec.navZh : sec.navEn}</span>
            <span class="pe-cmd-row-sub">{isZh ? sec.scopeZh : sec.navEn}</span>
          </div>
          <Badge tone="neutral">{isZh ? '主题' : 'Topic'}</Badge>
        </a>
      );
    })}

    <p class="cw-hint" data-pe-cmd-empty hidden style="padding: var(--space-4); text-align: center;">
      {isZh ? '未找到直接匹配，按回车执行全文检索。' : 'No direct match—press Enter to run a full archive search.'}
    </p>
  </div>

  <form action={lp('/search/')} method="get" class="pe-cmd-foot" data-pe-cmd-fallback-form>
    <input type="hidden" name="q" value="" data-pe-cmd-hidden-q />
    <span class="cw-hint" style="font-size:var(--text-2xs);">
      {isZh ? '支持检索全站主题、实用工具与深度文章' : 'Search topics, tools, and editorial dispatches'}
    </span>
    <button type="submit" class="text-link" style="border:0;background:transparent;font-size:var(--text-xs);cursor:pointer;">
      {isZh ? '全文检索 →' : 'Full Search →'}
    </button>
  </form>
</dialog>
