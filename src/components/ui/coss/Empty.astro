---
/**
 * Empty — Native Astro port of coss ui Empty
 * Centered empty state with raised icon badge, heading, description, and optional CTA slot.
 */
interface Props {
  title: string;
  description?: string;
  class?: string;
}

const { title, description, class: className = '' } = Astro.props;
---
<div data-slot="empty" class={className}>
  {Astro.slots.has('icon') && (
    <div data-slot="empty-media">
      <slot name="icon" />
    </div>
  )}
  <div style="display:flex;flex-direction:column;align-items:center;gap:0.35rem;">
    <h3 data-slot="empty-title">{title}</h3>
    {description && <p data-slot="empty-description">{description}</p>}
  </div>
  {Astro.slots.has('default') && (
    <div style="display:flex;align-items:center;gap:var(--space-2);">
      <slot />
    </div>
  )}
</div>
