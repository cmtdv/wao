---
/**
 * Collapsible — Native Astro port of coss ui Collapsible (<details>)
 */
import Icon from '@site/Icon.astro';

interface Props {
  title: string;
  open?: boolean;
  class?: string;
}

const { title, open = false, class: className = '' } = Astro.props;
---
<details data-slot="collapsible" open={open} class={className}>
  <summary>
    <span>{title}</span>
    <Icon name="down" size={14} />
  </summary>
  <div data-slot="collapsible-panel">
    <slot />
  </div>
</details>
