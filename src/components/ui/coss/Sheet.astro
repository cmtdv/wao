---
/**
 * Sheet — Native Astro port of coss ui Sheet (Side / Inset Flyout Dialog)
 */
import Icon from '@site/Icon.astro';
import { getLocaleFromContext } from '@i18n/ui';

interface Props {
  id: string;
  title: string;
  description?: string;
  triggerLabel?: string;
  side?: 'right' | 'left';
  variant?: 'default' | 'inset';
  class?: string;
}

const {
  id,
  title,
  description,
  triggerLabel,
  side = 'right',
  variant = 'default',
  class: className = '',
} = Astro.props;

const isZh = getLocaleFromContext(Astro) === 'zh';
const titleId = `${id}-title`;
---
{triggerLabel && (
  <button
    type="button"
    data-slot="button"
    data-variant="outline"
    class="btn"
    {...({ commandfor: id, command: 'show-modal' } as Record<string, string>)}
  >
    {triggerLabel}
  </button>
)}

<dialog
  id={id}
  data-slot="sheet"
  data-side={side}
  data-variant={variant}
  aria-labelledby={titleId}
  class={className}
  {...({ closedby: 'any' } as Record<string, string>)}
>
  <div style="display:flex;flex-direction:column;height:100%;">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-3);padding:1.25rem 1.35rem;border-bottom:1px solid var(--border);">
      <div>
        <h3 id={titleId} style="font-size:var(--text-base);font-weight:600;">{title}</h3>
        {description && <p class="cw-hint" style="margin-top:0.2rem;">{description}</p>}
      </div>
      <form method="dialog">
        <button type="submit" class="btn btn--ghost btn--icon-sm" aria-label={isZh ? `关闭 ${title}` : `Close ${title}`}>
          <Icon name="close" size={15} />
        </button>
      </form>
    </div>
    <div style="flex:1 1 auto;overflow-y:auto;padding:1.25rem 1.35rem;">
      <slot />
    </div>
    {Astro.slots.has('footer') && (
      <div style="padding:0.9rem 1.35rem;border-top:1px solid var(--border);background:var(--surface-sunken);display:flex;justify-content:flex-end;gap:var(--space-2);">
        <slot name="footer" />
      </div>
    )}
  </div>
</dialog>
