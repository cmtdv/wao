---
/**
 * VerticalTabs — Side-rail tab navigation for long reference guides & tool groups
 */
export interface VerticalTabItem {
  id: string;
  label: string;
  meta?: string;
  heading: string;
  body: string;
  points?: string[];
}

interface Props {
  id: string;
  label: string;
  items: VerticalTabItem[];
  class?: string;
}

const { id, label, items, class: className = '' } = Astro.props;
---
<div class:list={['cw-vtabs', className]} data-cw-vtabs>
  <div class="cw-vtabs-list" role="tablist" aria-label={label} aria-orientation="vertical">
    {items.map((item, idx) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${item.id}`}
        aria-controls={`${id}-panel-${item.id}`}
        aria-selected={idx === 0 ? 'true' : 'false'}
        tabindex={idx === 0 ? 0 : -1}
        class="cw-vtabs-btn"
      >
        <span class="cw-vtabs-label">{item.label}</span>
        {item.meta && <span class="cw-vtabs-meta">{item.meta}</span>}
      </button>
    ))}
  </div>

  <div class="cw-vtabs-panels">
    {items.map((item, idx) => (
      <div
        role="tabpanel"
        id={`${id}-panel-${item.id}`}
        aria-labelledby={`${id}-tab-${item.id}`}
        hidden={idx !== 0}
        class="cw-vtabs-panel"
      >
        <h4 class="cw-vtabs-heading">{item.heading}</h4>
        <p class="cw-vtabs-body">{item.body}</p>
        {item.points && item.points.length > 0 && (
          <ul class="cw-vtabs-points">
            {item.points.map((pt) => (
              <li>{pt}</li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</div>
