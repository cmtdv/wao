---
/**
 * Tabs — Native Astro port of coss ui Tabs (Segmented Pill Indicator & Underline variants)
 * Preserves full WCAG keyboard arrow navigation + hidden="until-found" find-in-page support.
 */
export interface TabItem {
  id: string;
  label: string;
  heading?: string;
  body: string;
  meta?: string;
}

interface Props {
  label: string;
  tabs: TabItem[];
  variant?: 'default' | 'underline';
  class?: string;
}

const { label, tabs, variant = 'default', class: className = '' } = Astro.props;
const focusgroupAttr = { focusgroup: 'tablist nomemory' } as Record<string, string>;
---
<div class:list={['cw-tabs', className]} data-slot="tabs" data-variant={variant} data-cw-tabs>
  <div class="cw-tablist" data-slot="tabs-list" role="tablist" aria-label={label} {...focusgroupAttr}>
    {tabs.map((tab, idx) => {
      const startAttr = idx === 0 ? ({ focusgroupstart: '' } as Record<string, string>) : {};
      return (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          class="cw-tab"
          data-slot="tabs-tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          tabindex={idx === 0 ? 0 : -1}
          data-cw-tab={tab.id}
          {...startAttr}
        >
          {tab.label}
        </button>
      );
    })}
  </div>

  <div class="cw-tabpanels">
    {tabs.map((tab, idx) => {
      const hiddenAttr = idx === 0 ? {} : ({ hidden: 'until-found' } as Record<string, string>);
      return (
        <div
          role="tabpanel"
          id={`panel-${tab.id}`}
          class="cw-tabpanel"
          data-slot="tabs-panel"
          aria-labelledby={`tab-${tab.id}`}
          tabindex={idx === 0 ? 0 : undefined}
          data-cw-tabpanel={tab.id}
          {...hiddenAttr}
        >
          <div class="cw-tabpanel-inner">
            {tab.meta && <p class="t-subheading" style="margin-bottom: var(--space-2);">{tab.meta}</p>}
            {tab.heading && <h3 style="margin-bottom: var(--space-2);">{tab.heading}</h3>}
            <p class="t-paragraph">{tab.body}</p>
          </div>
        </div>
      );
    })}
  </div>
</div>
