---
/**
 * Stepper — Multi-step process indicator (horizontal, vertical, or compact dot)
 */
import Icon from '@site/Icon.astro';

export interface StepItem {
  title: string;
  description?: string;
  status?: 'complete' | 'current' | 'upcoming';
}

interface Props {
  steps: StepItem[];
  orientation?: 'horizontal' | 'vertical' | 'dot';
  label?: string;
  class?: string;
}

const {
  steps,
  orientation = 'horizontal',
  label = 'Process steps',
  class: className = '',
} = Astro.props;
---
<nav class:list={['cw-stepper', `cw-stepper--${orientation}`, className]} aria-label={label}>
  <ol class="cw-stepper-list">
    {steps.map((step, idx) => {
      const state = step.status ?? (idx === 0 ? 'current' : 'upcoming');
      return (
        <li
          class:list={['cw-step', `cw-step--${state}`]}
          aria-current={state === 'current' ? 'step' : undefined}
        >
          <span class="cw-step-marker" aria-hidden="true">
            {orientation === 'dot' ? (
              <span class="cw-step-dot"></span>
            ) : state === 'complete' ? (
              <Icon name="check" size={13} />
            ) : (
              <span>{String(idx + 1).padStart(2, '0')}</span>
            )}
          </span>
          {orientation !== 'dot' && (
            <div class="cw-step-copy">
              <strong class="cw-step-title">{step.title}</strong>
              {step.description && <p class="cw-step-desc">{step.description}</p>}
            </div>
          )}
          {orientation === 'dot' && <span class="visually-hidden">{step.title} ({state})</span>}
        </li>
      );
    })}
  </ol>
</nav>
