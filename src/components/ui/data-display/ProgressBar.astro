---
/**
 * ProgressBar — Semantic linear progress bar with tabular readout
 */
interface Props {
  value: number;
  max?: number;
  label?: string;
  valueLabel?: string;
  tone?: 'seal' | 'palace' | 'gold' | 'verified';
  size?: 'sm' | 'md';
  id?: string;
  class?: string;
}

const {
  value,
  max = 100,
  label,
  valueLabel,
  tone = 'seal',
  size = 'md',
  id,
  class: className = '',
} = Astro.props;

const pct = Math.max(0, Math.min(100, (value / max) * 100));
const displayValue = valueLabel ?? `${Math.round(pct)}%`;
---
<div class:list={['cw-progress', `cw-progress--${size}`, className]}>
  {(label || valueLabel !== '') && (
    <div class="cw-progress-head">
      {label && <span class="cw-progress-label" id={id ? `${id}-label` : undefined}>{label}</span>}
      <span class="cw-progress-val">{displayValue}</span>
    </div>
  )}
  <div
    class="cw-progress-track"
    role="progressbar"
    aria-valuenow={value}
    aria-valuemin={0}
    aria-valuemax={max}
    aria-labelledby={label && id ? `${id}-label` : undefined}
    aria-label={!label ? 'Progress' : undefined}
  >
    <span class:list={['cw-progress-fill', `cw-progress-fill--${tone}`]} style={`width: ${pct}%`}></span>
  </div>
</div>
