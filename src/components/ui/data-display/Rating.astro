---
/**
 * Rating — Accessible 1–5 star rating (readonly display or interactive radio fieldset)
 */
interface Props {
  name?: string;
  legend?: string;
  value?: number;
  count?: number;
  readonly?: boolean;
  class?: string;
}

const {
  name = 'rating',
  legend = 'Field reliability rating',
  value = 4,
  count,
  readonly = false,
  class: className = '',
} = Astro.props;

const stars = [1, 2, 3, 4, 5];
---
{readonly ? (
  <div class:list={['cw-rating cw-rating--readonly', className]} aria-label={`Rated ${value} out of 5${count ? ` from ${count} field checks` : ''}`}>
    <span class="cw-rating-stars" aria-hidden="true">
      {stars.map((n) => (
        <svg class:list={['cw-star', n <= Math.round(value) && 'is-filled']} width="16" height="16" viewBox="0 0 24 24">
          <path d="M12 3.5 14.6 8.8l5.9.8-4.3 4.2 1 5.9L12 16.9 6.8 19.7l1-5.9-4.3-4.2 5.9-.8L12 3.5Z" />
        </svg>
      ))}
    </span>
    <span class="cw-rating-meta">
      <strong>{value.toFixed(1)}</strong>
      {count !== undefined && <span>({count} checks)</span>}
    </span>
  </div>
) : (
  <fieldset class:list={['cw-rating cw-rating--interactive', className]} data-cw-rating>
    <legend class="cw-label">{legend}</legend>
    <div class="cw-rating-row">
      <div class="cw-rating-inputs">
        {stars.map((n) => (
          <label class:list={['cw-rating-star-btn', n <= value && 'is-filled']} data-star-val={n}>
            <input
              type="radio"
              name={name}
              value={String(n)}
              checked={n === value}
              class="visually-hidden"
            />
            <svg class="cw-star" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3.5 14.6 8.8l5.9.8-4.3 4.2 1 5.9L12 16.9 6.8 19.7l1-5.9-4.3-4.2 5.9-.8L12 3.5Z" />
            </svg>
            <span class="visually-hidden">{n} out of 5 stars</span>
          </label>
        ))}
      </div>
      <span class="cw-rating-readout" data-cw-rating-readout>{value} / 5</span>
    </div>
  </fieldset>
)}
