---
/**
 * Modal — Native Astro port of coss ui Dialog (<dialog closedby="any"> + Invoker Commands)
 */
import Icon from '@site/Icon.astro';

interface Props {
  id: string;
  title: string;
  description?: string;
  eyebrow?: string;
  triggerLabel?: string;
  triggerVariant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  id,
  title,
  description,
  eyebrow,
  triggerLabel,
  triggerVariant = 'secondary',
  size = 'md',
  class: className = '',
} = Astro.props;

const titleId = `${id}-title`;
const descId = description ? `${id}-desc` : undefined;
---
{triggerLabel && (
  <button
    type="button"
    data-slot="button"
    data-variant={triggerVariant === 'primary' ? 'primary' : triggerVariant === 'ghost' ? 'ghost' : 'outline'}
    class:list={[
      'btn',
      triggerVariant === 'primary' && 'btn--primary',
      triggerVariant === 'ghost' && 'btn--ghost',
    ]}
    data-cw-modal-open={id}
    {...({ commandfor: id, command: 'show-modal' } as Record<string, string>)}
  >
    {triggerLabel}
  </button>
)}

<dialog
  id={id}
  data-slot="dialog"
  class:list={['cw-modal', `cw-modal--${size}`, className]}
  aria-labelledby={titleId}
  aria-describedby={descId}
  data-cw-modal
  {...({ closedby: 'any' } as Record<string, string>)}
>
  <div class="cw-modal-shell" data-slot="dialog-popup">
    <div class="cw-modal-head" data-slot="dialog-header">
      <div>
        {eyebrow && <span class="kicker">{eyebrow}</span>}
        <h3 id={titleId} class="cw-modal-title" data-slot="dialog-title">{title}</h3>
        {description && <p id={descId} class="cw-hint" style="margin-top:0.25rem;" data-slot="dialog-description">{description}</p>}
      </div>
      <form method="dialog">
        <button
          type="submit"
          class="btn btn--ghost btn--icon-sm"
          aria-label={`Close ${title}`}
        >
          <Icon name="close" size={15} />
        </button>
      </form>
    </div>

    <div class="cw-modal-body" data-slot="dialog-panel">
      <slot />
    </div>

    {Astro.slots.has('footer') && (
      <div class="cw-modal-foot" data-slot="dialog-footer">
        <slot name="footer" />
      </div>
    )}
  </div>
</dialog>
