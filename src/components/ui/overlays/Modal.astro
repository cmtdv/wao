---
/**
 * Modal — Declarative native <dialog closedby="any"> modal primitive
 */
import Icon from '@site/Icon.astro';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  triggerLabel?: string;
  triggerVariant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  id,
  title,
  eyebrow,
  triggerLabel,
  triggerVariant = 'secondary',
  size = 'md',
  class: className = '',
} = Astro.props;

const titleId = `${id}-title`;
---
{triggerLabel && (
  <button
    type="button"
    class={`btn btn--${triggerVariant}`}
    data-cw-modal-open={id}
    {...({ commandfor: id, command: 'show-modal' } as Record<string, string>)}
  >
    {triggerLabel}
  </button>
)}

<dialog
  id={id}
  class:list={['cw-modal', `cw-modal--${size}`, className]}
  aria-labelledby={titleId}
  data-cw-modal
  {...({ closedby: 'any' } as Record<string, string>)}
>
  <div class="cw-modal-shell">
    <div class="cw-modal-head">
      <div>
        {eyebrow && <span class="kicker">{eyebrow}</span>}
        <h3 id={titleId} class="cw-modal-title">{title}</h3>
      </div>
      <form method="dialog">
        <button
          type="submit"
          class="cw-compact-btn cw-compact-btn--stroke cw-compact-btn--sm"
          aria-label={`Close ${title}`}
        >
          <Icon name="close" size={14} />
        </button>
      </form>
    </div>

    <div class="cw-modal-body">
      <slot />
    </div>

    {Astro.slots.has('footer') && (
      <div class="cw-modal-foot">
        <slot name="footer" />
      </div>
    )}
  </div>
</dialog>
