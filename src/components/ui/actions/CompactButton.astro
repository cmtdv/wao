---
/**
 * CompactButton — Architectural icon-only micro-square control with mandatory aria-label
 */
import Icon from '@site/Icon.astro';

interface Props {
  icon: string;
  label: string;
  variant?: 'stroke' | 'ghost' | 'filled';
  size?: 'sm' | 'md';
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  icon,
  label,
  variant = 'stroke',
  size = 'md',
  type = 'button',
  id,
  disabled = false,
  class: className = '',
  ...rest
} = Astro.props;
---
<button
  type={type}
  id={id}
  disabled={disabled}
  aria-label={label}
  title={label}
  class:list={['cw-compact-btn', `cw-compact-btn--${variant}`, `cw-compact-btn--${size}`, className]}
  {...rest}
>
  <Icon name={icon} size={size === 'sm' ? 14 : 16} />
</button>
