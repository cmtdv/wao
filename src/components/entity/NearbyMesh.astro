---
/**
 * Layer 4 Spatial Enhancement: Zero-Maintenance 1–3km Nearby Mesh
 * 80% static heritage/museum/walk library + 20% Amap/Dianping Chinese search chips (zero dead restaurant links)
 */
import Badge from '@ui/data-display/Badge.astro';
import type { NearbyMeshItem } from '@data/paradigm-e/entities';
import { NEARBY_CAT_ZH } from '@data/paradigm-e/i18n-zh';

interface Props {
  nearbyMesh: NearbyMeshItem[];
  amapSearchChips: { label: string; chineseQuery: string }[];
  locale?: 'en' | 'zh';
}

const { nearbyMesh, amapSearchChips, locale = 'en' } = Astro.props;
const isZh = locale === 'zh';
---
<section aria-labelledby="nearby-mesh-heading" style="margin-top:var(--space-6);">
  <h2 id="nearby-mesh-heading" style="margin-bottom:var(--space-3);">
    {isZh ? '周边步行与常用搜词' : 'Nearby Walks & Amap Search Terms'}
  </h2>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:var(--space-3);">
    {nearbyMesh.map((item) => (
      <article class="pe-side-card">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.4rem;margin-bottom:0.45rem;">
          <Badge tone="editorial">{isZh ? (NEARBY_CAT_ZH[item.category] ?? item.category) : item.category}</Badge>
          <span style="font-family:var(--font-mono);font-size:var(--text-2xs);color:var(--ink-secondary);">
            {item.distance}
          </span>
        </div>
        <h3 style="font-size:1rem;margin-bottom:0.15rem;">{isZh ? item.chineseName : item.name}</h3>
        <p style="font-size:var(--text-xs);color:var(--ink-secondary);margin-bottom:0.5rem;">{isZh ? item.note : `${item.chineseName} · ${item.note}`}</p>
        <button
          type="button"
          class="pe-mega-chip"
          data-pe-copy={item.amapQuery}
          data-pe-copy-toast={isZh ? `已复制搜索词：${item.amapQuery}` : `Copied Amap query: ${item.amapQuery}`}
        >
          {isZh ? `复制：${item.amapQuery}` : `Copy Amap: ${item.amapQuery}`}
        </button>
      </article>
    ))}
  </div>

  {amapSearchChips.length > 0 && (
    <div style="margin-top:var(--space-4);padding:var(--space-4);border:1px solid var(--rule-subtle);background:var(--surface-raised);border-radius:var(--control-radius);">
      <span class="pe-mega-col-title" style="margin-bottom:var(--space-2);">
        {isZh ? '高德 / 大众点评中文搜索词' : 'Amap / Dianping Chinese Search Terms'}
      </span>
      <div class="pe-mega-chips">
        {amapSearchChips.map((chip) => (
          <button
            type="button"
            class="pe-mega-chip"
            data-pe-copy={chip.chineseQuery}
            data-pe-copy-toast={isZh ? `已复制「${chip.chineseQuery}」，可直接粘贴到高德或大众点评` : `Copied "${chip.chineseQuery}" — paste directly into Amap or Dianping`}
          >
            {isZh ? chip.chineseQuery : `${chip.label} · ${chip.chineseQuery}`}
          </button>
        ))}
      </div>
    </div>
  )}
</section>
