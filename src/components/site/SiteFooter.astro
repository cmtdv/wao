---
import type { getEmDashCollection, getTaxonomyTermsWithCacheHint } from 'emdash';
import BrandSeal from '@site/BrandSeal.astro';
import { categoryPath, pagePath } from '@lib/format';
import { localePath, type Locale } from '@i18n/ui';

type Term = Awaited<ReturnType<typeof getTaxonomyTermsWithCacheHint>>['data'][number];
type PageEntry = Awaited<ReturnType<typeof getEmDashCollection<'pages'>>>['entries'][number];

interface Props {
  siteTitle: string;
  tagline: string;
  roots: Term[];
  pages: PageEntry[];
  locale?: Locale;
  originalPathname?: string;
}

const { siteTitle, tagline, roots = [], pages = [], locale = 'en' } = Astro.props;
const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={lp('/')} class="brand">
        <BrandSeal />
        <span>{siteTitle}<span class="brand-period">.</span></span>
      </a>
      <p>{tagline}</p>
    </div>

    <div class="footer-col">
      <h2>{isZh ? '栏目分类' : 'Categories'}</h2>
      <ul class="footer-links">
        {roots.map((cat) => (
          <li><a href={lp(categoryPath(cat.slug))}>{cat.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h2>{isZh ? '文章与索引' : 'Archive'}</h2>
      <ul class="footer-links">
        <li><a href={lp('/posts/')}>{isZh ? '全部文章' : 'All Articles'}</a></li>
        <li><a href={lp('/topics/')}>{isZh ? '栏目目录' : 'Topics Directory'}</a></li>
        <li><a href={lp('/tags/')}>{isZh ? '主题标签' : 'Tags Index'}</a></li>
        <li><a href={lp('/search/')}>{isZh ? '全文检索' : 'Full-Text Search'}</a></li>
        <li><a href="/rss.xml">{isZh ? 'RSS 订阅' : 'RSS Feed'}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>{isZh ? '关于与编辑部' : 'Editorial'}</h2>
      <ul class="footer-links">
        {pages.slice(0, 4).map((entry) => (
          <li><a href={lp(pagePath(entry.data.slug || entry.id))}>{entry.data.title}</a></li>
        ))}
        <li>
          <a href={import.meta.env.DEV ? '/_emdash/api/setup/dev-bypass?content=0&redirect=/_emdash/admin' : '/_emdash/admin'}>
            {isZh ? '文章发布后台' : 'CMS Admin'}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <div class="footer-colophon">
      <span>© {year} {siteTitle}</span>
      <span>{isZh ? '经一手信源核验的中国实用指南与深度志刊' : 'Source-verified practical guides and dispatches on China'}</span>
    </div>

    <button
      type="button"
      class="footer-theme-toggle"
      data-footer-theme-toggle
      aria-label={isZh ? '切换深浅色模式' : 'Toggle color theme'}
      title={isZh ? '切换深浅色模式' : 'Toggle color theme'}
    >
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
      </svg>
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
      </svg>
    </button>
  </div>
</footer>

<style>
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .footer-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--ink-secondary);
    cursor: pointer;
    transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease, transform 120ms ease-out;
  }

  .footer-theme-toggle:hover {
    background: var(--surface-sunken);
    color: var(--ink-primary);
  }

  .footer-theme-toggle:active {
    transform: scale(0.97);
  }

  .footer-theme-toggle .icon-sun {
    display: none;
  }

  :global(html.dark) .footer-theme-toggle .icon-moon {
    display: none;
  }

  :global(html.dark) .footer-theme-toggle .icon-sun {
    display: block;
  }
</style>
