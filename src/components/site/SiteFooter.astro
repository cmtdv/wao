---
import type { getEmDashCollection, getTaxonomyTermsWithCacheHint } from 'emdash';
import BrandSeal from '@site/BrandSeal.astro';
import ThemeToggle from '@site/ThemeToggle.astro';
import { PILLARS } from '@data/paradigm-e/pillars';
import { pagePath } from '@lib/format';
import { getStrings, localePath, switchLocaleHref, type Locale } from '@i18n/ui';

type Term = Awaited<ReturnType<typeof getTaxonomyTermsWithCacheHint>>['data'][number];
type PageEntry = Awaited<ReturnType<typeof getEmDashCollection<'pages'>>>['entries'][number];

interface Props {
  siteTitle: string;
  tagline: string;
  roots: Term[];
  pages: PageEntry[];
  locale?: Locale;
  originalPathname?: string;
}

const { siteTitle, tagline, pages, locale = 'en', originalPathname } = Astro.props;
const strings = getStrings(locale);
const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);
const enHref = switchLocaleHref(Astro.url, 'en', originalPathname);
const zhHref = switchLocaleHref(Astro.url, 'zh', originalPathname);
const year = new Date().getFullYear();
---
<footer class="site-footer" data-ink-surface>
  {/* Organic Irregular Ink Deckle Top Edge (feTurbulence + feDisplacementMap) */}
  <svg
    class="footer-ink-deckle-svg"
    viewBox="0 0 1440 84"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <filter id="cw-ink-deckle-filter" x="-8%" y="-60%" width="116%" height="240%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.02 0.048"
          numOctaves="4"
          seed="7"
          result="deckleNoise"
          data-ink-deckle-turbulence
        />
        <feDisplacementMap
          in="SourceGraphic"
          in2="deckleNoise"
          scale="28"
          xChannelSelector="R"
          yChannelSelector="G"
          data-ink-deckle-displacement
        />
      </filter>
    </defs>
    {/* Feathered pale ink bleed Halo along top seam */}
    <path
      class="footer-ink-deckle-bleed"
      filter="url(#cw-ink-deckle-filter)"
      d="M-120,44 C160,34 320,52 520,40 C720,28 910,50 1120,38 C1280,29 1410,46 1560,40 L1560,84 L-120,84 Z"
    />
    {/* Main irregular vermilion top deckle edge */}
    <path
      class="footer-ink-deckle-vermilion"
      filter="url(#cw-ink-deckle-filter)"
      d="M-120,48 C180,42 350,55 560,46 C770,38 960,54 1160,44 C1310,37 1430,50 1560,45 L1560,84 L-120,84 Z"
    />
    {/* Brushed dry-ink irregular hairline ribbon on the seam */}
    <path
      class="footer-ink-deckle-stroke"
      filter="url(#cw-ink-deckle-filter)"
      d="M-120,48 C180,41 360,55 560,45 C770,37 960,54 1160,44 C1310,36 1430,50 1560,45 L1560,56 C1410,58 1280,47 1130,54 C930,62 740,46 530,54 C330,62 150,50 -120,56 Z"
    />
  </svg>

  {/* Right-Side Organic Irregular Sumi-Ink Wash Silhouette */}
  <div class="footer-ink-wash-wrap" aria-hidden="true">
    <svg
      class="footer-ink-wash-svg"
      viewBox="0 0 680 460"
      preserveAspectRatio="xMaxYMax slice"
    >
      <defs>
        <filter id="cw-ink-wash-filter" x="-22%" y="-22%" width="144%" height="144%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.018 0.028"
            numOctaves="4"
            seed="7"
            result="washNoise"
            data-ink-wash-turbulence
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="washNoise"
            scale="34"
            xChannelSelector="R"
            yChannelSelector="G"
            result="displaced"
            data-ink-wash-displacement
          />
          <feGaussianBlur in="displaced" stdDeviation="0.9" />
        </filter>
      </defs>
      {/* Layer 1: Pale outer Xuan-paper ink halo (清墨晕) */}
      <path
        class="footer-ink-wash-pale"
        filter="url(#cw-ink-wash-filter)"
        d="M320,460 C355,390 405,342 452,302 C486,272 480,218 518,176 C552,138 608,118 680,76 L680,460 Z"
      />
      {/* Layer 2: Mid-tone irregular brushed ink ridge (重墨山影) */}
      <path
        class="footer-ink-wash-mid"
        filter="url(#cw-ink-wash-filter)"
        d="M412,460 C442,396 472,354 510,318 C542,288 536,240 570,202 C602,166 638,150 680,122 L680,460 Z"
      />
      {/* Layer 3: Concentrated charred-ink irregular core (浓焦墨主笔) */}
      <path
        class="footer-ink-wash-deep"
        filter="url(#cw-ink-wash-filter)"
        d="M498,460 C524,412 544,378 574,344 C600,315 604,274 632,240 C650,218 664,205 680,192 L680,460 Z"
      />
      {/* Organic stray ink droplets (飞白墨点) */}
      <circle class="footer-ink-wash-mid" filter="url(#cw-ink-wash-filter)" cx="436" cy="238" r="14" />
      <ellipse class="footer-ink-wash-pale" filter="url(#cw-ink-wash-filter)" cx="384" cy="316" rx="22" ry="12" />
    </svg>
  </div>

  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={lp('/')} class="brand">
        <BrandSeal />
        <span>{siteTitle}<span class="brand-period">.</span></span>
      </a>
      <p>{tagline}</p>
      <nav class="lang-switch" aria-label={strings.langLabel} style="margin-top: var(--space-3);">
        <a href={enHref} hreflang="en" class="lang-switch-link" aria-current={locale === 'en' ? 'true' : undefined}>English</a>
        <a href={zhHref} hreflang="zh-CN" class="lang-switch-link" aria-current={locale === 'zh' ? 'true' : undefined}>简体中文</a>
      </nav>
    </div>

    <div class="footer-col">
      <h2>{isZh ? '栏目频道' : 'Sections'}</h2>
      <ul class="footer-links">
        {PILLARS.map((p) => (
          <li><a href={lp(`/${p.id}/`)}>{isZh ? p.nameZh : p.name}</a></li>
        ))}
        <li><a href={lp('/guides/')}>{isZh ? '深度指南' : 'Guides'}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>{isZh ? '工具与数据' : 'Tools & Data'}</h2>
      <ul class="footer-links">
        <li><a href={lp('/tools/')}>{isZh ? '实用工具' : 'Tools'}</a></li>
        <li><a href={lp('/cards/')}>{isZh ? '亮屏字卡' : 'Show Cards'}</a></li>
        <li><a href={lp('/portals/')}>{isZh ? '政务公开数据' : 'Gov Data Portals'}</a></li>
        <li><a href={lp('/pulse/')}>{isZh ? '现场实测' : 'Field Reports'}</a></li>
        <li><a href={lp('/explore/')}>{isZh ? '条件筛选' : 'Explore'}</a></li>
        <li><a href="/llms.txt">{isZh ? 'AI 索引文档' : 'llms.txt'}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>{isZh ? '志刊与说明' : 'Journal & About'}</h2>
      <ul class="footer-links">
        <li><a href={lp('/posts/')}>{isZh ? '深度志刊' : 'Dispatches'}</a></li>
        {pages.slice(0, 4).map((entry) => (
          <li><a href={lp(pagePath(entry.data.slug || entry.id))}>{entry.data.title}</a></li>
        ))}
        <li><a href="/rss.xml">{isZh ? 'RSS 订阅' : 'RSS Feed'}</a></li>
      </ul>
    </div>
  </div>

  {/* Live Draggable Ink Tuner: Ink Depth (淡墨 → 焦墨) + Irregular Ink Edge (齐边 → 飞白) */}
  <section
    class="container footer-ink-tuner"
    aria-label={isZh ? '调墨台：实时调节墨色深浅与墨缘不规则度' : 'Ink Tuner: adjust ink concentration and irregular brush edge'}
    data-ink-tuner
  >
    <div class="footer-ink-tuner-head">
      <span class="footer-ink-tuner-title">{isZh ? '调墨台' : 'Ink Tuner'}</span>
      <div class="footer-ink-tuner-actions">
        <button type="button" class="footer-ink-btn" data-ink-seed-btn>
          {isZh ? '换笔触' : 'New Stroke'}
        </button>
        <button type="button" class="footer-ink-btn" data-ink-reset-btn>
          {isZh ? '重置' : 'Reset'}
        </button>
      </div>
    </div>

    <div class="footer-ink-tuner-controls">
      <div class="footer-ink-control">
        <div class="footer-ink-control-row">
          <label for="cw-ink-depth">{isZh ? '墨色深浅' : 'Ink Depth'}</label>
          <output for="cw-ink-depth" class="cw-ink-readout" data-ink-depth-out>
            {isZh ? '浓墨 · #160E0C' : 'Rich Ink · #160E0C'}
          </output>
        </div>
        <div class="footer-ink-range-wrap">
          <span class="footer-ink-scale-hint" aria-hidden="true">{isZh ? '淡墨' : 'Pale'}</span>
          <input
            id="cw-ink-depth"
            type="range"
            min="0"
            max="100"
            step="1"
            value="82"
            class="cw-ink-slider cw-ink-slider--depth"
            aria-valuetext={isZh ? '浓墨 82%' : 'Rich ink 82%'}
            data-ink-depth
          />
          <span class="footer-ink-scale-hint" aria-hidden="true">{isZh ? '焦墨' : 'Charred'}</span>
        </div>
      </div>

      <div class="footer-ink-control">
        <div class="footer-ink-control-row">
          <label for="cw-ink-edge">{isZh ? '边缘不规则度' : 'Irregular Edge'}</label>
          <output for="cw-ink-edge" class="cw-ink-readout" data-ink-edge-out>
            {isZh ? '毛边 · 58%' : 'Deckled · 58%'}
          </output>
        </div>
        <div class="footer-ink-range-wrap">
          <span class="footer-ink-scale-hint" aria-hidden="true">{isZh ? '齐边' : 'Clean'}</span>
          <input
            id="cw-ink-edge"
            type="range"
            min="0"
            max="100"
            step="1"
            value="58"
            class="cw-ink-slider cw-ink-slider--edge"
            aria-valuetext={isZh ? '毛边不规则度 58%' : 'Edge roughness 58%'}
            data-ink-edge
          />
          <span class="footer-ink-scale-hint" aria-hidden="true">{isZh ? '飞白' : 'Ragged'}</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container footer-bottom">
    <div class="footer-colophon">
      <span>© {year} {siteTitle}</span>
      <span>{isZh ? '经核验的中国实用指南与开放数据门户' : 'Verified practical guides and open data on China'}</span>
    </div>
    <ThemeToggle variant="segmented" />
  </div>
</footer>
