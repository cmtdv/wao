---
import type { getEmDashCollection, getTaxonomyTermsWithCacheHint } from 'emdash';
import BrandSeal from '@site/BrandSeal.astro';
import ThemeToggle from '@site/ThemeToggle.astro';
import { PILLARS } from '@data/paradigm-e/pillars';
import { pagePath } from '@lib/format';
import { getStrings, localePath, switchLocaleHref, type Locale } from '@i18n/ui';

type Term = Awaited<ReturnType<typeof getTaxonomyTermsWithCacheHint>>['data'][number];
type PageEntry = Awaited<ReturnType<typeof getEmDashCollection<'pages'>>>['entries'][number];

interface Props {
  siteTitle: string;
  tagline: string;
  roots: Term[];
  pages: PageEntry[];
  locale?: Locale;
  originalPathname?: string;
}

const { siteTitle, tagline, pages, locale = 'en', originalPathname } = Astro.props;
const strings = getStrings(locale);
const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);
const enHref = switchLocaleHref(Astro.url, 'en', originalPathname);
const zhHref = switchLocaleHref(Astro.url, 'zh', originalPathname);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={lp('/')} class="brand">
        <BrandSeal />
        <span>{siteTitle}<span class="brand-period">.</span></span>
      </a>
      <p>{tagline}</p>
      <nav class="lang-switch" aria-label={strings.langLabel} style="margin-top: var(--space-3);">
        <a href={enHref} hreflang="en" class="lang-switch-link" aria-current={locale === 'en' ? 'true' : undefined}>English</a>
        <a href={zhHref} hreflang="zh-CN" class="lang-switch-link" aria-current={locale === 'zh' ? 'true' : undefined}>简体中文</a>
      </nav>
    </div>

    <div class="footer-col">
      <h2>{isZh ? '六大主柱' : '6 Core Pillars'}</h2>
      <ul class="footer-links">
        {PILLARS.map((p) => (
          <li><a href={lp(`/${p.id}/`)}>{isZh ? `${p.nameZh} (${p.name})` : p.name}</a></li>
        ))}
        <li><a href={lp('/guides/')}>{isZh ? '32 个深度主题页' : 'All 32 Feature Guides'}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>{isZh ? '工具 · 数据 · AI' : 'Tools, Data & AI'}</h2>
      <ul class="footer-links">
        <li><a href={lp('/tools/')}>{isZh ? '11 个交互工具工作台' : 'Tools Workbench (11)'}</a></li>
        <li><a href={lp('/portals/')}>{isZh ? '848 政务数据源与 MCP' : '848 Gov Portals & MCP'}</a></li>
        <li><a href={lp('/pulse/')}>{isZh ? '现场实测流 Ground Pulse' : 'Live Ground Pulse'}</a></li>
        <li><a href={lp('/explore/')}>{isZh ? '多维分面探索器' : 'Multi-Facet Explorer'}</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
        <li><a href="/.well-known/mcp/server-card.json">MCP Server Card</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>{isZh ? '志刊与系统' : 'Journal & System'}</h2>
      <ul class="footer-links">
        <li><a href={lp('/posts/')}>{isZh ? 'EmDash 志刊归档' : 'CMS Dispatches'}</a></li>
        <li><a href={lp('/design-system/')}>{strings.footer.links.dsKit}</a></li>
        <li><a href={lp('/design-system/blocks/')}>{strings.footer.links.dsBlocks}</a></li>
        {pages.slice(0, 3).map((entry) => (
          <li><a href={lp(pagePath(entry.data.slug || entry.id))}>{entry.data.title}</a></li>
        ))}
        <li><a href="/rss.xml">{strings.footer.links.rss}</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <div class="footer-colophon">
      <span>© {year} {siteTitle}</span>
      <span>Paradigm E · Astro + EmDash Live Collections + Route A</span>
    </div>
    <ThemeToggle variant="segmented" />
  </div>

  <div class="container footer-watermark" aria-hidden="true">
    <span>{siteTitle}.</span>
  </div>
</footer>
