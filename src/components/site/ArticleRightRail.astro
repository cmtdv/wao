---
import type { TocItem } from '@lib/portable-text';
import { tagPath } from '@lib/format';
import { localePath, type Locale } from '@i18n/ui';

interface TagItem {
  slug: string;
  label: string;
}

interface Props {
  locale: Locale;
  tags: TagItem[];
  tocItems: TocItem[];
  canonicalUrl: string;
}

const { locale, tags, tocItems, canonicalUrl } = Astro.props;
const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);

const aiPrompt = isZh
  ? `请阅读并总结这篇文章的关键实操步骤，并回答我接下来的问题：${canonicalUrl}`
  : `Read and summarize the key practical steps from this article, then help me with follow-up questions: ${canonicalUrl}`;

const preferGoogleHref = 'https://www.google.com/preferences/source?q=chinawao.com';
const chatGptHref = `https://chatgpt.com/?q=${encodeURIComponent(aiPrompt)}`;
const geminiHref = `https://gemini.google.com/app?q=${encodeURIComponent(aiPrompt)}`;
---
<aside class="toc-rail supabase-rail" aria-label={isZh ? '文章导览与 AI 入口' : 'Article navigation and AI links'}>
  <div class="toc-sticky supabase-rail-inner">
    {tags.length > 0 && (
      <div class="rail-tags" aria-label={isZh ? '文章标签' : 'Article tags'}>
        {tags.map((term) => (
          <a href={lp(tagPath(term.slug))} class="rail-tag-pill">
            #{term.label}
          </a>
        ))}
      </div>
    )}

    {tocItems.length > 0 && (
      <nav class="rail-section" aria-label={isZh ? '本页目录' : 'On this page'}>
        <p class="rail-heading">{isZh ? '本页目录' : 'ON THIS PAGE'}</p>
        <ol class="toc-list">
          {tocItems.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                data-toc-link
                class:list={['toc-link', item.level === 3 && 'toc-link--sub']}
              >
                {item.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <section class="rail-section" aria-label={isZh ? '快捷入口' : 'Quick actions'}>
      <ul class="rail-ai-list">
        <li>
          <a href={preferGoogleHref} target="_blank" rel="noopener noreferrer" class="rail-ai-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M21.35 11.1h-9.18v2.92h5.27c-.23 1.24-.93 2.29-1.98 2.99v2.48h3.2c1.87-1.72 2.95-4.26 2.95-7.27 0-.38-.03-.76-.09-1.12h-.17ZM12.17 22c2.67 0 4.91-.88 6.55-2.4l-3.2-2.48c-.89.6-2.02.95-3.35.95-2.58 0-4.76-1.74-5.54-4.08H3.32v2.56A9.89 9.89 0 0 0 12.17 22ZM6.63 13.99a5.95 5.95 0 0 1 0-3.98V7.45H3.32a9.9 9.9 0 0 0 0 9.1l3.31-2.56ZM12.17 5.93c1.45 0 2.75.5 3.78 1.48l2.83-2.83C17.07 2.99 14.84 2 12.17 2a9.89 9.89 0 0 0-8.85 5.45l3.31 2.56c.78-2.34 2.96-4.08 5.54-4.08Z" />
            </svg>
            <span>{isZh ? '设为 Google 优先来源' : 'Prefer on Google'}</span>
          </a>
        </li>
        <li>
          <a href={chatGptHref} target="_blank" rel="noopener noreferrer" class="rail-ai-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2.75a4.25 4.25 0 0 1 3.7 2.18 4.25 4.25 0 0 1 5.05 5.45 4.25 4.25 0 0 1-1.38 6.45 4.25 4.25 0 0 1-5.62 3.92A4.25 4.25 0 0 1 8.3 19.07a4.25 4.25 0 0 1-5.05-5.45 4.25 4.25 0 0 1 1.38-6.45A4.25 4.25 0 0 1 10.25 3.25 4.2 4.2 0 0 1 12 2.75Z" />
              <circle cx="12" cy="12" r="2.75" />
            </svg>
            <span>{isZh ? '向 ChatGPT 提问' : 'Ask ChatGPT'}</span>
          </a>
        </li>
        <li>
          <a href={geminiHref} target="_blank" rel="noopener noreferrer" class="rail-ai-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2c.4 4.8 4.2 8.6 9 9-4.8.4-8.6 4.2-9 9-.4-4.8-4.2-8.6-9-9 4.8-.4 8.6-4.2 9-9Z" />
            </svg>
            <span>{isZh ? '向 Gemini 提问' : 'Ask Gemini'}</span>
          </a>
        </li>
      </ul>
    </section>
  </div>
</aside>
