---
import type { TocItem } from '@lib/portable-text';
import { tagPath } from '@lib/format';
import { localePath, type Locale } from '@i18n/ui';

interface TagItem {
  slug: string;
  label: string;
}

interface Props {
  locale: Locale;
  tags: TagItem[];
  tocItems: TocItem[];
  title: string;
  canonicalUrl: string;
}

const { locale, tags, tocItems, title, canonicalUrl } = Astro.props;
const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);

const aiPrompt = isZh
  ? `请阅读并总结这篇文章的关键实操步骤，并回答我接下来的问题：${canonicalUrl}`
  : `Read and summarize the key practical steps from this article, then help me with follow-up questions: ${canonicalUrl}`;

const chatGptHref = `https://chatgpt.com/?q=${encodeURIComponent(aiPrompt)}`;
const claudeHref = `https://claude.ai/new?q=${encodeURIComponent(aiPrompt)}`;
const preferGoogleHref = 'https://www.google.com/preferences/source?q=chinawao.com';
const xShareHref = `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalUrl)}`;
const linkedinShareHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`;
const hnShareHref = `https://news.ycombinator.com/submitlink?u=${encodeURIComponent(canonicalUrl)}&t=${encodeURIComponent(title)}`;
---
<aside class="toc-rail supabase-rail" aria-label={isZh ? '文章导览与 AI 工具' : 'Article navigation and AI tools'}>
  <div class="toc-sticky supabase-rail-inner">
    {tags.length > 0 && (
      <div class="rail-tags" aria-label={isZh ? '文章标签' : 'Article tags'}>
        {tags.map((term) => (
          <a href={lp(tagPath(term.slug))} class="rail-tag-pill">
            {term.label}
          </a>
        ))}
      </div>
    )}

    {tocItems.length > 0 && (
      <nav class="rail-section" aria-label={isZh ? '本页目录' : 'On this page'}>
        <p class="rail-heading">{isZh ? '本页目录' : 'ON THIS PAGE'}</p>
        <ol class="toc-list">
          {tocItems.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                data-toc-link
                class:list={['toc-link', item.level === 3 && 'toc-link--sub']}
              >
                {item.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <section class="rail-section" aria-label={isZh ? 'AI 工具' : 'AI tools'}>
      <p class="rail-heading">{isZh ? 'AI 工具' : 'AI TOOLS'}</p>
      <ul class="rail-ai-list">
        <li>
          <a href={chatGptHref} target="_blank" rel="noopener noreferrer" class="rail-ai-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2.75a4.25 4.25 0 0 1 3.7 2.18 4.25 4.25 0 0 1 5.05 5.45 4.25 4.25 0 0 1-1.38 6.45 4.25 4.25 0 0 1-5.62 3.92A4.25 4.25 0 0 1 8.3 19.07a4.25 4.25 0 0 1-5.05-5.45 4.25 4.25 0 0 1 1.38-6.45A4.25 4.25 0 0 1 10.25 3.25 4.2 4.2 0 0 1 12 2.75Z" />
              <circle cx="12" cy="12" r="2.75" />
            </svg>
            <span>{isZh ? '向 ChatGPT 提问' : 'Ask ChatGPT'}</span>
          </a>
        </li>
        <li>
          <a href={claudeHref} target="_blank" rel="noopener noreferrer" class="rail-ai-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
              <path d="M12 3v18M3 12h18M5.64 5.64l12.72 12.72M18.36 5.64 5.64 18.36" />
            </svg>
            <span>{isZh ? '向 Claude 提问' : 'Ask Claude'}</span>
          </a>
        </li>
        <li>
          <button
            type="button"
            class="rail-ai-link"
            data-copy-markdown
            data-md-title={title}
            data-md-url={canonicalUrl}
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <span>{isZh ? '复制为 Markdown' : 'Copy as Markdown'}</span>
          </button>
        </li>
        <li>
          <a href={preferGoogleHref} target="_blank" rel="noopener noreferrer" class="rail-ai-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M21.35 11.1h-9.18v2.92h5.27c-.23 1.24-.93 2.29-1.98 2.99v2.48h3.2c1.87-1.72 2.95-4.26 2.95-7.27 0-.38-.03-.76-.09-1.12h-.17ZM12.17 22c2.67 0 4.91-.88 6.55-2.4l-3.2-2.48c-.89.6-2.02.95-3.35.95-2.58 0-4.76-1.74-5.54-4.08H3.32v2.56A9.89 9.89 0 0 0 12.17 22ZM6.63 13.99a5.95 5.95 0 0 1 0-3.98V7.45H3.32a9.9 9.9 0 0 0 0 9.1l3.31-2.56ZM12.17 5.93c1.45 0 2.75.5 3.78 1.48l2.83-2.83C17.07 2.99 14.84 2 12.17 2a9.89 9.89 0 0 0-8.85 5.45l3.31 2.56c.78-2.34 2.96-4.08 5.54-4.08Z" />
            </svg>
            <span>{isZh ? '设为 Google 优先来源' : 'Prefer on Google'}</span>
          </a>
        </li>
      </ul>
    </section>

    <div class="rail-socials" aria-label={isZh ? '分享到社交平台' : 'Share on social'}>
      <a href={xShareHref} target="_blank" rel="noopener noreferrer" aria-label={isZh ? '分享到 X' : 'Share on X'}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
      </a>
      <a href={linkedinShareHref} target="_blank" rel="noopener noreferrer" aria-label={isZh ? '分享到 LinkedIn' : 'Share on LinkedIn'}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z" />
        </svg>
      </a>
      <a href={hnShareHref} target="_blank" rel="noopener noreferrer" aria-label={isZh ? '分享到 Hacker News' : 'Share on Hacker News'}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3 3h18v18H3V3zm8.2 10.6V18h1.6v-4.4L16.5 6h-1.8l-2.7 5.7L9.3 6H7.5l3.7 7.6z" />
        </svg>
      </a>
    </div>
  </div>
</aside>
