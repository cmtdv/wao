---
/**
 * FilterBarBlock — Composed <search> multi-facet bar + removable active Tag chips
 */
import Select from '@ui/forms/Select.astro';
import Tag from '@ui/data-display/Tag.astro';
import Button from '@ui/actions/Button.astro';

interface Props {
  id?: string;
  class?: string;
}

const { id = 'cw-filter-demo', class: className = '' } = Astro.props;
---
<section class:list={['cw-block-filter', className]} data-cw-filter-demo>
  <search aria-label="Filter demonstration">
    <div class="finder-bar cw-filter-bar-row">
      <div class="finder-cell">
        <label for={`${id}-q`} class="finder-label">Search</label>
        <input
          id={`${id}-q`}
          type="search"
          class="finder-input"
          placeholder="Search China topics, ports, or agencies..."
          data-cw-filter-q
        />
      </div>
      <div class="finder-cell">
        <Select
          id={`${id}-pillar`}
          name="pillar"
          label="Pillar"
          bare
          options={[
            { value: 'all', label: 'All 12 Pillars' },
            { value: 'visit', label: '9. Visit China' },
            { value: 'live', label: '10. Live & Study' },
            { value: 'business', label: '11. Business' },
            { value: 'tools', label: '12. Tools & Data' },
          ]}
        />
      </div>
      <div class="finder-cell">
        <Select
          id={`${id}-status`}
          name="status"
          label="Verification"
          bare
          options={[
            { value: 'all', label: 'All statuses' },
            { value: 'verified', label: 'Verified Live' },
            { value: 'standby', label: 'WAF-Protected Standby' },
          ]}
        />
      </div>
      <div class="finder-actions">
        <Button size="sm" variant="ghost" data-cw-filter-reset>Reset</Button>
      </div>
    </div>
  </search>

  <div class="cw-filter-chips" data-cw-filter-chips aria-label="Active filter tags">
    <span class="kicker">Active filters:</span>
    <Tag label="Pillar: Visit China" value="visit" tone="editorial" removable />
    <Tag label="Verified 2026" value="verified" tone="verified" removable />
    <Tag label="English Portal" value="en" tone="neutral" removable />
  </div>
</section>
