---
export interface StatItem {
  value: string;
  label: string;
  note?: string;
}

interface Props {
  items: StatItem[];
  ariaLabel?: string;
  class?: string;
}

const { items, ariaLabel = 'Key facts and figures', class: className = '' } = Astro.props;
---
<section class:list={['cw-stats-strip', className]} aria-label={ariaLabel}>
  {items.map((item) => (
    <div class="cw-stat-cell">
      <span class="cw-stat-label">{item.label}</span>
      <span class="cw-stat-value">{item.value}</span>
      {item.note && <span class="cw-stat-note">{item.note}</span>}
    </div>
  ))}
</section>
