---
/**
 * HowItWorksBlock — Architectural 4-stage methodology band using Stepper
 */
import Stepper from '@ui/navigation/Stepper.astro';
import type { StepItem } from '@ui/navigation/Stepper.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  steps: StepItem[];
  class?: string;
}

const { eyebrow = 'Verification Workflow', title, subtitle, steps, class: className = '' } = Astro.props;
---
<section class:list={['cw-block-section cw-block-how', className]}>
  <header class="cw-block-head">
    <span class="kicker">{eyebrow}</span>
    <h3 class="cw-block-title">{title}</h3>
    {subtitle && <p class="cw-block-sub">{subtitle}</p>}
  </header>
  <Stepper steps={steps} orientation="horizontal" label={title} />
</section>
