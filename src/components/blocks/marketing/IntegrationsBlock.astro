---
/**
 * IntegrationsBlock — Connected public services, transport apps & open data APIs grid
 */
import Badge from '@ui/data-display/Badge.astro';
import Icon from '@site/Icon.astro';

export interface IntegrationItem {
  name: string;
  category: string;
  status: 'Verified' | 'Standby' | 'Native';
  description: string;
  icon: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  items: IntegrationItem[];
  class?: string;
}

const { eyebrow = 'Connected Systems', title, subtitle, items, class: className = '' } = Astro.props;

const statusTone = (s: IntegrationItem['status']) =>
  s === 'Verified' ? 'verified' : s === 'Standby' ? 'standby' : 'editorial';
---
<section class:list={['cw-block-section', className]}>
  <header class="cw-block-head">
    <span class="kicker">{eyebrow}</span>
    <h3 class="cw-block-title">{title}</h3>
    {subtitle && <p class="cw-block-sub">{subtitle}</p>}
  </header>
  <div class="cw-integrations-grid">
    {items.map((item) => (
      <article class="cw-integration-card">
        <div class="cw-integration-head">
          <span class="cw-feature-icon" aria-hidden="true">
            <Icon name={item.icon} size={18} />
          </span>
          <Badge tone={statusTone(item.status)}>{item.status}</Badge>
        </div>
        <span class="kicker">{item.category}</span>
        <h4 class="cw-integration-name">{item.name}</h4>
        <p class="cw-integration-desc">{item.description}</p>
      </article>
    ))}
  </div>
</section>
