---
/**
 * FeaturesBlock — Hairline architectural 3-column capability grid
 */
import Icon from '@site/Icon.astro';

export interface FeatureItem {
  icon: string;
  tag: string;
  title: string;
  description: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  items: FeatureItem[];
  class?: string;
}

const {
  eyebrow = 'Capabilities',
  title,
  subtitle,
  items,
  class: className = '',
} = Astro.props;
---
<section class:list={['cw-block-section', className]}>
  <header class="cw-block-head">
    <span class="kicker">{eyebrow}</span>
    <h3 class="cw-block-title">{title}</h3>
    {subtitle && <p class="cw-block-sub">{subtitle}</p>}
  </header>
  <div class="cw-features-grid">
    {items.map((item) => (
      <article class="cw-feature-card">
        <div class="cw-feature-top">
          <span class="cw-feature-icon" aria-hidden="true">
            <Icon name={item.icon} size={20} />
          </span>
          <span class="kicker">{item.tag}</span>
        </div>
        <h4 class="cw-feature-title">{item.title}</h4>
        <p class="cw-feature-desc">{item.description}</p>
        {item.href && (
          <a href={item.href} class="text-link">Inspect section &rarr;</a>
        )}
      </article>
    ))}
  </div>
</section>
