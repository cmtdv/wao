---
/**
 * TestimonialsBlock — Editorial reader & field researcher endorsements with Rating + Avatar
 */
import Avatar from '@ui/data-display/Avatar.astro';
import Rating from '@ui/data-display/Rating.astro';

export interface TestimonialItem {
  quote: string;
  author: string;
  role: string;
  location: string;
  rating?: number;
  tone?: 'palace' | 'gold' | 'ink' | 'sage';
}

interface Props {
  eyebrow?: string;
  title: string;
  items: TestimonialItem[];
  class?: string;
}

const { eyebrow = 'Field Readers', title, items, class: className = '' } = Astro.props;
---
<section class:list={['cw-block-section', className]}>
  <header class="cw-block-head">
    <span class="kicker">{eyebrow}</span>
    <h3 class="cw-block-title">{title}</h3>
  </header>
  <div class="cw-testimonials-grid">
    {items.map((item) => (
      <figure class="cw-testimonial-card">
        {item.rating && <Rating value={item.rating} readonly />}
        <blockquote class="cw-testimonial-quote">“{item.quote}”</blockquote>
        <figcaption class="cw-testimonial-author">
          <Avatar name={item.author} tone={item.tone ?? 'palace'} size="sm" />
          <div>
            <strong>{item.author}</strong>
            <span>{item.role} · {item.location}</span>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
