---
/**
 * TeamsBlock — Editorial desk & domain verification team directory
 */
import Avatar from '@ui/data-display/Avatar.astro';
import Badge from '@ui/data-display/Badge.astro';

export interface TeamMember {
  name: string;
  role: string;
  desk: string;
  bio: string;
  tone?: 'palace' | 'gold' | 'ink' | 'sage';
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  members: TeamMember[];
  class?: string;
}

const { eyebrow = 'Editorial Masthead', title, subtitle, members, class: className = '' } = Astro.props;
---
<section class:list={['cw-block-section', className]}>
  <header class="cw-block-head">
    <span class="kicker">{eyebrow}</span>
    <h3 class="cw-block-title">{title}</h3>
    {subtitle && <p class="cw-block-sub">{subtitle}</p>}
  </header>
  <div class="cw-teams-grid">
    {members.map((m) => (
      <article class="cw-team-card">
        <div class="cw-team-head">
          <Avatar name={m.name} tone={m.tone ?? 'ink'} size="lg" />
          <div>
            <Badge tone="neutral">{m.desk}</Badge>
            <h4 class="cw-team-name">{m.name}</h4>
            <p class="cw-team-role">{m.role}</p>
          </div>
        </div>
        <p class="cw-team-bio">{m.bio}</p>
      </article>
    ))}
  </div>
</section>
