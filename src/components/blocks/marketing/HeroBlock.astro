---
/**
 * HeroBlock — Editorial split/centered marketing hero block (Pro Hero equivalent)
 */
import Badge from '@ui/data-display/Badge.astro';
import Button from '@ui/actions/Button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  metrics?: { value: string; label: string }[];
  imageSrc?: string;
  imageAlt?: string;
  class?: string;
}

const {
  eyebrow = 'ChinaWao Editorial Platform',
  title,
  subtitle,
  primaryLabel = 'Explore China Atlas',
  primaryHref = '/atlas/',
  secondaryLabel = 'Browse verified tools',
  secondaryHref = '/tools/',
  metrics = [
    { value: '34', label: 'Provinces & regions' },
    { value: '100%', label: 'Source-linked facts' },
    { value: 'Zero', label: 'Commercial font debt' },
  ],
  imageSrc = '/images/river.webp',
  imageAlt = 'Karst peaks over Li River at sunrise',
  class: className = '',
} = Astro.props;
---
<section class:list={['cw-block-hero', className]}>
  <div class="cw-block-hero-copy">
    <Badge tone="editorial">{eyebrow}</Badge>
    <h2 class="cw-block-hero-title">{title}</h2>
    <p class="cw-block-hero-sub">{subtitle}</p>
    <div class="cw-block-hero-actions">
      <Button href={primaryHref} variant="primary">{primaryLabel}</Button>
      <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
    </div>
    {metrics.length > 0 && (
      <dl class="cw-block-hero-metrics">
        {metrics.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
  <figure class="cw-block-hero-media">
    <img src={imageSrc} alt={imageAlt} loading="lazy" />
  </figure>
</section>
