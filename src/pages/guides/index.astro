---
/**
 * All 32 Deep Feature Guides Index (/guides/)
 */
import BaseShell from '@layouts/BaseShell.astro';
import ResponsiveBreadcrumb from '../../components/nav/ResponsiveBreadcrumb.astro';
import Badge from '@ui/data-display/Badge.astro';
import { GUIDES, type GuideArchetype } from '@data/paradigm-e/guides';
import { PILLAR_BY_ID } from '@data/paradigm-e/pillars';
import { getLocaleFromContext, localePath } from '@i18n/ui';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (p: string) => localePath(p, locale);

const archetypes: { key: GuideArchetype; title: string; titleZh: string }[] = [
  { key: 'playbook', title: 'Step-by-Step Playbooks', titleZh: '行前与实操指南' },
  { key: 'matrix', title: 'Comparisons & Buying Guides', titleZh: '方案与场景对比' },
  { key: 'rescue', title: 'Error Rescue & Policy Logs', titleZh: '报错救火与政策动态' },
  { key: 'editorial', title: 'Food, Heritage & Living Culture', titleZh: '饮食、古建与人文' },
];
---
<BaseShell
  title={isZh ? '深度指南总览' : 'All China Guides'}
  description={isZh ? '涵盖行前准备、交通支付、留学工作、商务采购与文化饮食的实用深度指南。' : 'Practical guides covering pre-flight prep, payments, rail, living, sourcing, and Chinese culture.'}
>
  <div class="container" style="padding-bottom: var(--space-8);">
    <ResponsiveBreadcrumb
      items={[
        { label: isZh ? '首页' : 'Home', href: lp('/') },
        { label: isZh ? '深度指南' : 'Guides' },
      ]}
      mobileBackHref={lp('/')}
      mobileBackLabel={isZh ? '首页' : 'Home'}
    />

    <header style="max-width:52rem;margin-bottom:var(--space-6);">
      <h1>{isZh ? '深度指南' : 'China Guides'}</h1>
      <p class="archive-lead" style="margin-top:var(--space-2);">
        {isZh
          ? '按使用场景整理的实用指南，覆盖赴华行前、日常支付交通、留学长居、商务采购与人文探索。'
          : 'Practical guides organized by scenario—covering pre-flight prep, daily travel, long-term stay, sourcing, and culture.'}
      </p>
    </header>

    {archetypes.map((arch) => {
      const list = GUIDES.filter((g) => g.archetype === arch.key);
      return (
        <section style="margin-bottom:var(--space-7);">
          <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:var(--space-2);padding-bottom:var(--space-2);border-bottom:1.5px solid var(--rule-strong);">
            <h2 style="font-size:1.35rem;">{isZh ? arch.titleZh : arch.title}</h2>
          </div>

          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(19rem,1fr));gap:var(--space-4);margin-top:var(--space-4);">
            {list.map((g) => (
              <article class="pe-side-card" data-persona={g.persona} style="display:flex;flex-direction:column;justify-content:space-between;gap:var(--space-3);">
                <div>
                  <div style="display:flex;justify-content:space-between;gap:0.4rem;margin-bottom:0.4rem;">
                    <Badge tone="editorial">{isZh ? PILLAR_BY_ID[g.pillar].nameZh : PILLAR_BY_ID[g.pillar].name}</Badge>
                    <a href={`/guides/${g.slug}.md`} class="pe-mega-chip" style="padding:0.1rem 0.4rem;font-size:var(--text-2xs);">.md</a>
                  </div>
                  <h3 style="font-family:var(--font-display);font-size:1.12rem;line-height:1.3;">
                    <a href={lp(`/guides/${g.slug}/`)} class="text-link">
                      {isZh ? g.titleZh : g.title}
                    </a>
                  </h3>
                  <p style="font-size:var(--text-xs);color:var(--ink-secondary);margin-top:0.35rem;line-height:1.55;">
                    {isZh ? g.leadHookZh : g.leadHook}
                  </p>
                </div>
                <span style="font-family:var(--font-mono);font-size:var(--text-2xs);color:var(--ink-tertiary);">
                  {isZh ? `更新于 ${g.lastVerified}` : `Updated ${g.lastVerified}`}
                </span>
              </article>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</BaseShell>
