    <section id="ds-navigation" class="ds-section">
      <span class="kicker">{isZh ? '10 · 导航组件（胶囊轨道与下划线双形态 Tabs）' : '10 · Navigation Primitives (Pill & Underline Tabs)'}</span>
      <h2>{isZh ? '横纵标签页、分段控制器、手风琴折叠面板与步骤条' : 'Tabs (Pill & Underline), VerticalTabs, SegmentedControl, Accordion & Stepper'}</h2>
      <div class="ds-stack">
        <div class="ds-grid-2">
          <div class="ds-panel">
            <span class="ds-panel-title">{isZh ? '分段控制器与点状步骤条' : 'SegmentedControl & Dot Stepper'}</span>
            <SegmentedControl
              label={isZh ? '状态筛选' : 'Mode'}
              options={
                isZh
                  ? [
                      { value: 'all', label: '全部条目' },
                      { value: 'verified', label: '已核验' },
                      { value: 'standby', label: '备用源' },
                    ]
                  : [
                      { value: 'all', label: 'All Entries' },
                      { value: 'verified', label: 'Verified' },
                      { value: 'standby', label: 'Standby' },
                    ]
              }
            />
            <Stepper steps={howSteps} orientation="dot" label={isZh ? '核验进度' : 'Dot progress'} />
          </div>
          <div class="ds-panel">
            <span class="ds-panel-title">{isZh ? '纵向步骤条（Vertical Stepper）' : 'Vertical Stepper'}</span>
            <Stepper steps={howSteps.slice(0, 3)} orientation="vertical" label={isZh ? '抵华流程' : 'Arrival flow'} />
          </div>
        </div>

        <Tabs label={isZh ? '设计系统规范（胶囊态）' : 'Design system pillars (Pill)'} tabs={dsTabs} />
        <Tabs label={isZh ? '设计系统规范（下划线态）' : 'Design system pillars (Underline)'} variant="underline" tabs={dsTabs.map((t) => ({ ...t, id: `${t.id}-ul` }))} />
        <VerticalTabs id="ds-vtabs" label={isZh ? '出行速查纵向标签' : 'Travel reference tabs'} items={vtabItems} />
        <Accordion items={faqItems} name="ds-faq-group" />
      </div>
    </section>

    {/* 11. Overlays */}
    <section id="ds-overlays" class="ds-section">
      <span class="kicker">{isZh ? '11 · 顶层浮窗组件（Dialog · Drawer · Menu · Popover · Tooltip）' : '11 · Overlays (Modal, Drawer, DropdownMenu, PopoverCard, Tooltip)'}</span>
      <h2>{isZh ? 'coss 原生顶层模态框、滑动抽屉与锚点浮窗' : 'coss Top-Layer Dialogs, Scroll-Snap Drawer & Anchored Popovers'}</h2>
      <div class="ds-panel">
        <div class="ds-row">
          <Modal id="ds-modal-demo" title={isZh ? '确认导出核验条目' : 'Confirm Verified Entry Export'} eyebrow={isZh ? 'coss Dialog' : 'coss Dialog'} triggerLabel={isZh ? '打开模态框' : 'Open Modal'} triggerVariant="primary">
            <p>{isZh ? <>本模态框采用原生 <code>&lt;dialog closedby="any"&gt;</code> 与 coss 底栏分层结构，内置 Esc 关闭、遮罩轻点关闭与焦点自动归位。</> : <>Uses native <code>&lt;dialog closedby="any"&gt;</code> with coss muted footer bar, Escape dismissal, backdrop light-dismiss, and focus restoration.</>}</p>
            <div slot="footer">
              <form method="dialog">
                <Button type="submit" variant="ghost" size="sm">{isZh ? '取消' : 'Cancel'}</Button>
              </form>
              <Button size="sm" variant="primary" data-cw-toast-trigger={isZh ? '导出任务已加入队列。' : 'Export queued.'}>
                {isZh ? '确认导出' : 'Confirm Export'}
              </Button>
            </div>
          </Modal>

          <Drawer id="ds-drawer-demo" triggerLabel={isZh ? '打开滑动抽屉' : 'Open Swipe Drawer'} title={isZh ? '筛选抽屉' : 'Field Filter Drawer'} eyebrow={isZh ? '滑动抽屉' : 'Scroll-Snap Sheet'}>
            <p class="t-paragraph">{isZh ? <>支持左滑、点击遮罩、按 Esc 或关闭按钮收起。遮罩透明度通过原生 <code>animation-timeline: scroll()</code> 同步。</> : <>Swipe left, click the dimmed backdrop, press Escape, or click close. Backdrop opacity tracks scroll position via <code>animation-timeline: scroll()</code>.</>}</p>
            <Checkbox id="ds-drw-1" checked>{isZh ? '仅显示英文友好官方门户' : 'Show English-friendly official portals only'}</Checkbox>
            <Checkbox id="ds-drw-2">{isZh ? '包含反爬官方备用源' : 'Include WAF-Protected Standby sources'}</Checkbox>
            <Button variant="default" size="sm" data-cw-toast-trigger={isZh ? '抽屉筛选已应用。' : 'Drawer filters applied.'}>{isZh ? '应用筛选' : 'Apply Filters'}</Button>
          </Drawer>

          <DropdownMenu
            id="ds-dropdown-demo"
            triggerLabel={isZh ? '操作菜单' : 'Action Menu'}
            items={[
              { label: isZh ? '复制固定链接' : 'Copy permalink', icon: 'copy', toastMessage: isZh ? '固定链接已复制。' : 'Permalink copied.' },
              { label: isZh ? '查看区块展台' : 'View Page Blocks', icon: 'spark', href: lp('/design-system/blocks/') },
              { label: isZh ? '上报失效官方链接' : 'Report broken official URL', icon: 'mail', tone: 'danger', toastMessage: isZh ? '失效链接上报已记录。' : 'Broken link report logged.' },
            ]}
          />

          <PopoverCard id="ds-popover-demo" triggerLabel={isZh ? '打开浮窗卡片' : 'Open Popover Card'} eyebrow={isZh ? 'OKF 元数据' : 'OKF Metadata'} title={isZh ? '来源核验台账' : 'Source Verification Ledger'}>
            <p>{isZh ? <>通过 CSS 锚点定位（<code>position-area: block-end span-inline-end</code>）与边缘翻转自动定位。</> : <>Positioned with CSS Anchor Positioning (<code>position-area: block-end span-inline-end</code>) and automatic edge flip fallbacks.</>}</p>
          </PopoverCard>

          <Tooltip id="ds-tooltip-demo" label={isZh ? 'coss 原生架构说明' : 'About coss Astro Native'}>
            {isZh
              ? '零 React 水合运行时，100% 原生 Astro + 现代 Web 标准实现 coss ui 质感。'
              : 'Zero React hydration runtime — 100% native Astro + modern Web Platform APIs with coss ui surface craft.'}
          </Tooltip>
        </div>
      </div>

      <div class="ds-panel" style="margin-top: var(--space-5);">
        <span class="ds-panel-title">{isZh ? `${BASE_PRIMITIVE_COVERAGE.length} / ${BASE_PRIMITIVE_COVERAGE.length} 原生组件映射清单` : `Complete ${BASE_PRIMITIVE_COVERAGE.length} / ${BASE_PRIMITIVE_COVERAGE.length} Native Component Mapping`}</span>
        <p class="t-paragraph">
          {isZh ? (
            <>全部 coss ui 核心容器与基础交互原子均已映射为原生 Astro 组件。前往查看全部 39 类组合页面区块：<a href={lp('/design-system/blocks/')} class="text-link">/zh/design-system/blocks/ &rarr;</a></>
          ) : (
            <>Every coss ui surface and interactive primitive maps cleanly to a native Astro component. Inspect all 39 composed page blocks on <a href={lp('/design-system/blocks/')} class="text-link">/design-system/blocks/ &rarr;</a></>
          )}
        </p>
        <div class="ds-row">
          {BASE_PRIMITIVE_COVERAGE.map((row) => (
            <a href={row.anchor} class="cw-tag cw-tag--neutral">{row.category}</a>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>
