---
import Layout from '@layouts/Layout.astro';
import Icon from '@site/Icon.astro';
import Button from '@ui/actions/Button.astro';
import ButtonGroup from '@ui/actions/ButtonGroup.astro';
import CompactButton from '@ui/actions/CompactButton.astro';
import LinkButton from '@ui/actions/LinkButton.astro';
import Avatar from '@ui/data-display/Avatar.astro';
import AvatarGroup from '@ui/data-display/AvatarGroup.astro';
import Badge from '@ui/data-display/Badge.astro';
import DataTable from '@ui/data-display/DataTable.astro';
import Divider from '@ui/data-display/Divider.astro';
import Kbd from '@ui/data-display/Kbd.astro';
import ProgressBar from '@ui/data-display/ProgressBar.astro';
import ProgressCircle from '@ui/data-display/ProgressCircle.astro';
import Rating from '@ui/data-display/Rating.astro';
import Skeleton from '@ui/data-display/Skeleton.astro';
import Tag from '@ui/data-display/Tag.astro';
import Alert from '@ui/feedback/Alert.astro';
import Banner from '@ui/feedback/Banner.astro';
import NotificationCard from '@ui/feedback/NotificationCard.astro';
import Tooltip from '@ui/feedback/Tooltip.astro';
import Checkbox from '@ui/forms/Checkbox.astro';
import ColorPicker from '@ui/forms/ColorPicker.astro';
import DateInput from '@ui/forms/DateInput.astro';
import DigitInput from '@ui/forms/DigitInput.astro';
import FileUpload from '@ui/forms/FileUpload.astro';
import Input from '@ui/forms/Input.astro';
import RadioGroup from '@ui/forms/RadioGroup.astro';
import Select from '@ui/forms/Select.astro';
import Slider from '@ui/forms/Slider.astro';
import Textarea from '@ui/forms/Textarea.astro';
import Accordion, { type AccordionItem } from '@ui/navigation/Accordion.astro';
import Breadcrumb from '@ui/navigation/Breadcrumb.astro';
import SegmentedControl from '@ui/navigation/SegmentedControl.astro';
import Stepper, { type StepItem } from '@ui/navigation/Stepper.astro';
import Tabs from '@ui/navigation/Tabs.astro';
import VerticalTabs, { type VerticalTabItem } from '@ui/navigation/VerticalTabs.astro';
import Drawer from '@ui/overlays/Drawer.astro';
import DropdownMenu from '@ui/overlays/DropdownMenu.astro';
import Modal from '@ui/overlays/Modal.astro';
import PopoverCard from '@ui/overlays/PopoverCard.astro';
import Card from '@ui/coss/Card.astro';
import Collapsible from '@ui/coss/Collapsible.astro';
import Empty from '@ui/coss/Empty.astro';
import Field from '@ui/coss/Field.astro';
import Frame from '@ui/coss/Frame.astro';
import FramePanel from '@ui/coss/FramePanel.astro';
import Group from '@ui/coss/Group.astro';
import InputGroup from '@ui/coss/InputGroup.astro';
import Meter from '@ui/coss/Meter.astro';
import NumberField from '@ui/coss/NumberField.astro';
import Sheet from '@ui/coss/Sheet.astro';
import Spinner from '@ui/coss/Spinner.astro';
import Switch from '@ui/coss/Switch.astro';
import Toolbar from '@ui/coss/Toolbar.astro';
import {
  BASE_PRIMITIVE_COVERAGE,
  DS_FAQ_ITEMS,
  DS_HOW_STEPS,
  DS_VTAB_ITEMS,
} from '@data/design-system-catalog';
import { getVisaMatrixTable } from '@data/mock-portal-zh';
import { getLocaleFromContext, localePath } from '@i18n/ui';
import '@styles/specialty.css';
import '@styles/design-system.css';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);
const visaMatrix = getVisaMatrixTable(locale);

const swatches = isZh
  ? [
      { name: '纯净画布 (#FFFFFF / #141414)', token: '--background', bg: 'var(--background)' },
      { name: '浮起卡片面板', token: '--card', bg: 'var(--card)' },
      { name: '静音托盘 (Frame Tray)', token: '--muted', bg: 'var(--muted)' },
      { name: '中性主色 (#262626 / #F5F5F5)', token: '--primary', bg: 'var(--primary)' },
      { name: '唯一品牌朱砂红 (#E43216)', token: '--brand', bg: 'var(--brand)' },
      { name: '精细切边边框', token: '--border-strong', bg: 'var(--border-strong)' },
      { name: '核验翡翠绿', token: '--status-verified-ink', bg: 'var(--status-verified-ink)' },
      { name: '备用琥珀黄', token: '--status-standby-ink', bg: 'var(--status-standby-ink)' },
    ]
  : [
      { name: 'Pure Canvas (#FFFFFF / #141414)', token: '--background', bg: 'var(--background)' },
      { name: 'Elevated Card Panel', token: '--card', bg: 'var(--card)' },
      { name: 'Muted Frame Tray', token: '--muted', bg: 'var(--muted)' },
      { name: 'Neutral Primary (#262626 / #F5F5F5)', token: '--primary', bg: 'var(--primary)' },
      { name: 'Single Brand Accent (#E43216)', token: '--brand', bg: 'var(--brand)' },
      { name: 'Crisp Bevel Border', token: '--border-strong', bg: 'var(--border-strong)' },
      { name: 'Verified Emerald', token: '--status-verified-ink', bg: 'var(--status-verified-ink)' },
      { name: 'Standby Amber', token: '--status-standby-ink', bg: 'var(--status-standby-ink)' },
    ];

const dsTabs = isZh
  ? [
      {
        id: 'spec',
        label: 'coss 几何与微切边',
        heading: 'bg-clip-padding + 1px 内切微高光',
        body: '全部交互控件统一采用 10px（--radius-lg）至 16px（--radius-2xl）圆角体系、半透明精细边框与 1px 内切阴影，在纯净白（#FFFFFF）与深碳灰（#141414）双模态下严格满足 WCAG AA 对比度。',
      },
      {
        id: 'a11y',
        label: '原生 Web 平台语义',
        heading: '零 React 水合负担，100% 原生 Astro',
        body: '将 coss ui 的 54 项视觉与交互模式完整移植为原生 Astro 组件：基于 <dialog closedby="any">、Popover API、appearance: base-select、commandfor 触发器与 ARIA 实时播报。',
      },
      {
        id: 'license',
        label: '开源字体与单色克制',
        heading: '单一 #E43216 品牌强调色 + SIL OFL 字体',
        body: '全站仅保留 #E43216 作为唯一品牌强调色，每屏至多一处实心主操作按钮；字体严格自托管 DM Sans、Newsreader 与 JetBrains Mono，零商业版权负债。',
      },
    ]
  : [
      {
        id: 'spec',
        label: 'coss Bevel & Geometry',
        heading: 'bg-clip-padding + 1px Inner Bevel Craft',
        body: 'Controls share 10px (--radius-lg) to 16px (--radius-2xl) radii, crisp translucent borders, and 1px inner bevel highlights with verified WCAG AA contrast across Pure White (#FFFFFF) and Deep Neutral (#141414).',
      },
      {
        id: 'a11y',
        label: 'Zero-Hydration Native Astro',
        heading: 'Native Platform Semantics Without React Overhead',
        body: 'Ports coss ui’s 54 component patterns into zero-hydration Astro primitives powered by <dialog closedby="any">, Popover API, appearance: base-select, commandfor invokers, and ARIA live regions.',
      },
      {
        id: 'license',
        label: 'Brand Restraint & Open Fonts',
        heading: 'Single #E43216 Brand Accent + SIL OFL Fonts',
        body: 'Retains #E43216 as the sole brand accent (at most one solid primary CTA per view) paired with self-hosted DM Sans, Newsreader, and JetBrains Mono.',
      },
    ];

const faqItems: AccordionItem[] = isZh
  ? [
      {
        question: '240 小时过境免签是否允许跨省乘坐高铁？',
        answer: '允许。根据国家移民管理局现行政策，符合条件的过境旅客可在 24 个省份规定停留区域内跨省通行，并从 60 个适用口岸任一离境，前提是持有前往第三国或地区（含港澳台）的联程确定客票。',
        badge: '9.1 签证入境',
        open: true,
      },
      {
        question: '为什么部分政务平台标记为反爬拦截官方备用源？',
        answer: '部分部委及省市政务公开数据库对自动化采集开启瑞数 412、创宇 521 或动态令牌 202 防护，但在人类浏览器中可正常免费查询。ChinaWao 如实记录其状态，绝不静默丢弃官方一手数据源。',
        badge: '12.8 公开数据',
      },
      {
        question: '这套原生 Astro 版 coss ui 组件是否引入客户端框架体积？',
        answer: '零客户端 UI 框架体积。所有卡片、托盘（Frame）、输入组合（InputGroup）、步进数字框（NumberField）、侧滑抽屉（Sheet）均由原生 HTML/CSS 与轻量渐进增强脚本驱动。',
        badge: '架构规范',
      },
    ]
  : DS_FAQ_ITEMS;

const howSteps: StepItem[] = isZh
  ? [
      { title: '一手源定位', description: '锁定部委、铁路、博物馆或省市政务公开数据库原始 URL。', status: 'complete' },
      { title: '条款逐字核对', description: '直接在官方页面核验停留天数、限额、开放时间与收费标准。', status: 'complete' },
      { title: '一线实操验证', description: '以真实外籍护照场景交叉验证绑卡、进站与预约流程。', status: 'current' },
      { title: '时间戳归档发布', description: '写入 EmDash 内容库与 OKF 核验台账，附明确核验日期。', status: 'upcoming' },
    ]
  : DS_HOW_STEPS;

const vtabItems: VerticalTabItem[] = isZh
  ? [
      {
        id: 'rail',
        label: '铁路 12306 高铁购票',
        meta: '9.4 · 提前 15 天起售',
        heading: '外籍护照在线核验与刷证进站',
        body: '车票提前 15 个自然日按车站梯队分批起售。上传清晰护照资料页后，在线身份核验通常在 5–15 分钟内完成。',
        points: [
          '主要枢纽车站自助检票闸机支持直接刷外籍护照原件进站',
          '一等座与商务座同二等座同步放票',
          '开车前 48 小时以上线上免费改签一次',
        ],
      },
      {
        id: 'payments',
        label: '移动扫码支付',
        meta: '9.2 · 支付宝与微信支付',
        heading: '外卡直绑 Visa 与 Mastercard',
        body: '支付宝与微信支付均支持直接绑定境外银行卡扫商户二维码消费，无需开立中国内地银行账户。',
        points: [
          '单笔人民币 200 元及以下免收 3% 国际卡手续费',
          '单笔超过 200 元按 3% 收取国际卡组织通道费',
          '建议在出发前完成护照实名认证与首次绑卡测试',
        ],
      },
      {
        id: 'tax',
        label: '离境退税即买即退',
        meta: '9.8 · 最高实得约 9%',
        heading: '退税商店单日同店满 ¥200 即可申领',
        body: '境外旅客同日在同一退税商店购买退税物品满 200 元人民币，可申领 11% 增值税退税（扣除约 2% 代理手续费后实得约 9%）。',
        points: [
          '结账时出示护照开具《离境退税申请单》与增值税普通发票',
          '未拆封退税物品需在离境口岸接受海关核验',
          '核心商圈支持信用卡预授权市区即买即退人民币现金',
        ],
      },
    ]
  : DS_VTAB_ITEMS;
---
<Layout
  title={isZh ? '设计系统 · coss ui 原生 Astro 组件库' : 'Design System · coss ui Native Astro Kit'}
  description={
    isZh
      ? 'ChinaWao 原生 Astro 版 coss ui 设计系统——纯净白与深碳灰双模态令牌、Frame/Card 微切边容器及 56 项交互组件。'
      : 'ChinaWao coss ui (Astro Native Edition) — Pure White & Deep Neutral tokens, Frame/Card bevel surfaces, and 56 interactive primitives.'
  }
>
  <div class="container ds-shell">
    <Breadcrumb
      items={[
        { label: isZh ? '首页' : 'Home', href: lp('/') },
        { label: isZh ? '设计系统' : 'Design System' },
      ]}
      jsonLd
    />

    <header class="portal-hero">
      <div class="portal-hero-head">
        <div class="portal-hero-copy">
          <span class="kicker">{isZh ? 'coss ui · 原生 Astro 零水合组件系统' : 'coss ui · Astro Native Zero-Hydration System'}</span>
          <h1>{isZh ? '纯净中立画布与 56 项原生组件套件' : 'Crisp Neutral Surfaces & 56 Native Primitives'}</h1>
          <p class="portal-lead">
            {isZh
              ? '基于 coss ui 视觉工程规范重构的原生 Astro 组件体系：纯净白（#FFFFFF）与深碳灰（#141414）底色、bg-clip-padding 微切边阴影、Frame 静音托盘，以及全站唯一的 #E43216 品牌强调色。'
              : 'Native Astro implementation of coss ui craft: pure white (#FFFFFF) and deep neutral (#141414) surfaces, bg-clip-padding 1px inner bevels, muted Frame trays, and #E43216 as the sole brand accent.'}
          </p>
          <div class="ds-row" style="margin-top: var(--space-3);">
            <Button href={lp('/design-system/')} variant="primary" size="sm">{isZh ? 'coss 基础组件库 (56)' : 'coss Base Kit (56)'}</Button>
            <Button href={lp('/design-system/blocks/')} variant="outline" size="sm">{isZh ? '页面区块展台 (39) →' : 'Page Blocks Showcase (39) →'}</Button>
          </div>
        </div>
        <div class="portal-hero-meta">
          <div class="portal-stat-box">
            <span class="kicker">{isZh ? '组件覆盖' : 'Primitives'}</span>
            <strong>56 / 56</strong>
            <span class="portal-stat-note">{isZh ? 'coss 原生 Astro 组件' : 'coss Astro primitives'}</span>
          </div>
          <div class="portal-stat-box">
            <span class="kicker">{isZh ? '页面区块' : 'Blocks'}</span>
            <strong>39 / 39</strong>
            <span class="portal-stat-note">{isZh ? '组合区块全覆盖' : 'Composed page blocks'}</span>
          </div>
        </div>
      </div>

      <nav class="pillar-jump-bar" aria-label={isZh ? '跳转至设计系统章节' : 'Jump to design system section'}>
        <a href="#ds-tokens" class="pillar-jump-link">{isZh ? '色彩与字体令牌' : 'Tokens & Type'}</a>
        <a href="#ds-coss-surfaces" class="pillar-jump-link">{isZh ? 'coss 核心容器与控件' : 'coss Surfaces'}</a>
        <a href="#ds-actions" class="pillar-jump-link">{isZh ? '按钮体系' : 'Buttons'}</a>
        <a href="#ds-data-display" class="pillar-jump-link">{isZh ? '数据展示' : 'Data Display'}</a>
        <a href="#ds-table" class="pillar-jump-link">{isZh ? '可排序表格' : 'DataTable'}</a>
        <a href="#ds-progress" class="pillar-jump-link">{isZh ? '进度与评分' : 'Progress & Rating'}</a>
        <a href="#ds-forms" class="pillar-jump-link">{isZh ? '核心表单' : 'Core Forms'}</a>
        <a href="#ds-advanced-forms" class="pillar-jump-link">{isZh ? '高级表单' : 'Advanced Forms'}</a>
        <a href="#ds-feedback" class="pillar-jump-link">{isZh ? '状态反馈' : 'Feedback'}</a>
        <a href="#ds-navigation" class="pillar-jump-link">{isZh ? '导航结构' : 'Navigation'}</a>
        <a href="#ds-overlays" class="pillar-jump-link">{isZh ? '顶层浮窗' : 'Overlays'}</a>
      </nav>
    </header>

    {/* 1. Tokens & Local Styles */}
    <section id="ds-tokens" class="ds-section">
      <span class="kicker">{isZh ? '01 · 色彩令牌与排版梯度' : '01 · Foundations & Typography'}</span>
      <h2>{isZh ? '纯净白 / 深碳灰双模态与四阶字重梯度' : 'Pure White / Deep Neutral Palette & 4-Tier Type Hierarchy'}</h2>
      <p class="ds-lead">
        {isZh
          ? <>所有表面、文本、边框、微阴影与语义状态均通过原生 <code>light-dark()</code> 自动切换。可在右上角或页脚切换浅色/深色主题实时核验对比度。</>
          : <>All surface, foreground, border, bevel-shadow, and semantic tokens switch automatically via native <code>light-dark()</code>. Toggle Light/Dark in the header or footer to inspect both modes.</>}
      </p>

      <div class="ds-swatch-grid">
        {swatches.map((s) => (
          <div class="ds-swatch">
            <div class="ds-swatch-chip" style={`background:${s.bg};`}></div>
            <div class="ds-swatch-body">
              <strong class="ds-swatch-name">{s.name}</strong>
              <span class="ds-swatch-token">{s.token}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="ds-type-list" style="margin-top: var(--space-5);">
        <div class="ds-type-row">
          <span class="ds-swatch-token">.t-title (L1)</span>
          <p class="t-title">{isZh ? 'Newsreader 主标题 —— 240 小时过境免签全流程手册' : 'Newsreader Display Title — 240-Hour Transit Playbook'}</p>
        </div>
        <div class="ds-type-row">
          <span class="ds-swatch-token">.t-subheading (L2)</span>
          <p class="t-subheading">{isZh ? '区块副标题 · 口岸核验与联程客票规范' : 'Section Subheading · Verified Port & Ticket Rules'}</p>
        </div>
        <div class="ds-type-row">
          <span class="ds-swatch-token">.t-paragraph (L3)</span>
          <p class="t-paragraph">{isZh ? '正文排版 —— 高辨识度 DM Sans 无衬线字体，在纯白与深碳灰背景下保持清晰阅读节奏。' : 'Body copy — High-legibility DM Sans set for sustained reading on crisp white and deep neutral dark surfaces.'}</p>
        </div>
        <div class="ds-type-row">
          <span class="ds-swatch-token">.t-docs (L4)</span>
          <p class="t-docs">{isZh ? '元信息与编号 —— GB 32100-2015 · NIA 12367 · 核验于 2026-11-22' : 'Metadata & Monospace — GB 32100-2015 · NIA 12367 · Verified 2026-11-22'}</p>
        </div>
      </div>
    </section>

    {/* 2. Signature coss ui Surfaces & Primitives */}
    <section id="ds-coss-surfaces" class="ds-section">
      <span class="kicker">{isZh ? '02 · coss ui 标志性表面与组合控件（@ui/coss/*）' : '02 · Signature coss ui Surfaces & Controls (@ui/coss/*)'}</span>
      <h2>{isZh ? 'Frame 静音托盘、Card 微切边卡片、InputGroup、NumberField 与 Sheet' : 'Frame + FramePanel, Card, InputGroup, Group, NumberField, Switch, Empty & Sheet'}</h2>
      <p class="ds-lead">
        {isZh
          ? <>完整移植自官方 <code>coss.com/ui</code> 组件注册表：外层静音托盘（<code>rounded-2xl bg-muted p-1</code>）包裹内层纯白/碳黑微切边面板（<code>rounded-xl bg-clip-padding</code>）。</>
          : <>Ported directly from the official <code>coss.com/ui</code> registry: muted outer trays (<code>rounded-2xl bg-muted p-1</code>) cradling crisp elevated panels (<code>rounded-xl bg-clip-padding</code>).</>}
      </p>

      <div class="ds-grid-2">
        <Frame
          title={isZh ? '入境核验工作台托盘（Frame + FramePanel）' : 'Arrival Verification Tray (Frame + FramePanel)'}
          description={isZh ? '多块关联内嵌面板共享同一个静音托盘容器' : 'Multiple stacked panels nested cleanly inside a muted outer frame'}
        >
          <Badge slot="header-action" variant="success">{isZh ? '实时生效' : 'Live 2026'}</Badge>
          <FramePanel>
            <Field
              forId="coss-demo-search"
              label={isZh ? '组合输入框（InputGroup）' : 'InputGroup with Addons'}
              description={isZh ? '支持前置图标、内嵌快捷键与无感焦点环合并。' : 'Merges leading icon, input, and trailing shortcut keycap into one focusable control.'}
            >
              <InputGroup
                id="coss-demo-search"
                name="coss_search"
                type="search"
                placeholder={isZh ? '搜索口岸代码、高铁站或 18 位信用代码…' : 'Search port code, station, or 18-digit USCC…'}
              >
                <Icon slot="prefix" name="search" size={15} />
                <Kbd slot="suffix">⌘K</Kbd>
              </InputGroup>
            </Field>
          </FramePanel>
          <FramePanel>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:var(--space-4);align-items:end;">
              <NumberField
                id="coss-demo-stay"
                name="stay_days"
                label={isZh ? '计划停留天数（NumberField）' : 'Planned Stay Days (NumberField)'}
                value={10}
                min={1}
                max={30}
              />
              <Switch
                id="coss-demo-switch"
                name="onward_ticket"
                label={isZh ? '已出联程机票' : 'Confirmed onward ticket'}
                description={isZh ? '持有第三国确定座位客票' : 'Seat-confirmed 3rd-country ticket'}
                checked
              />
            </div>
          </FramePanel>
          <span slot="footer">{isZh ? '数据源：国家移民管理局 12367 平台' : 'Source: NIA 12367 Official Portal'}</span>
        </Frame>

        <div class="ds-stack">
          <Card
            title={isZh ? '独立微切边卡片（Card）' : 'Standalone Bevel Card'}
            description={isZh ? '内置标题、右上操作槽、主体内容与底栏区' : 'Header, action slot, body panel, and muted footer'}
          >
            <Badge slot="action" variant="info">{isZh ? '工具栏' : 'Toolbar'}</Badge>
            <div class="ds-stack">
              <div class="ds-row">
                <Group label={isZh ? '无缝拼接控件组' : 'Joined control group'}>
