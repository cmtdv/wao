---
/**
 * Official AlignUI Design System v2.0 Showcase — Branch feat/alignui-official
 * Astro 7.4.13 + React 19 + Tailwind CSS v4 + Official AlignUI 49 Free Primitives + Pro Blocks & Templates
 */
import Layout from '@layouts/Layout.astro';
import Breadcrumb from '@ui/navigation/Breadcrumb.astro';
import {
  AlignUIOfficialShowcase,
  type VisaRowItem,
} from '../../components/alignui-islands/AlignUIOfficialShowcase';
import { getLocaleFromContext, localePath } from '@i18n/ui';
import '@styles/specialty.css';
import '@styles/design-system.css';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);

const visaRows: VisaRowItem[] = isZh
  ? [
      {
        passport: '法国 / 德国 / 意大利 / 西班牙',
        unilateral: '30 天免签',
        mutual: '—',
        transit240h: '适用（24 省跨省）',
        ports: '全国 60 个口岸',
        updated: '2026-11-23',
      },
      {
        passport: '新加坡 / 马来西亚 / 泰国',
        unilateral: '—',
        mutual: '30 天互免',
        transit240h: '适用（24 省跨省）',
        ports: '全国 60 个口岸',
        updated: '2026-11-23',
      },
      {
        passport: '澳大利亚 / 新西兰 / 日本 / 韩国',
        unilateral: '30 天免签',
        mutual: '—',
        transit240h: '适用（24 省跨省）',
        ports: '全国 60 个口岸',
        updated: '2026-11-23',
      },
      {
        passport: '美国 / 英国 / 加拿大',
        unilateral: '需办签证',
        mutual: '—',
        transit240h: '适用（需第三国联程票）',
        ports: '全国 60 个口岸',
        updated: '2026-11-23',
      },
    ]
  : [
      {
        passport: 'France / Germany / Italy / Spain',
        unilateral: '30 Days Visa-Free',
        mutual: '—',
        transit240h: 'Eligible (24 Provinces)',
        ports: '60 Official Ports',
        updated: '2026-11-23',
      },
      {
        passport: 'Singapore / Malaysia / Thailand',
        unilateral: '—',
        mutual: '30 Days Mutual',
        transit240h: 'Eligible (24 Provinces)',
        ports: '60 Official Ports',
        updated: '2026-11-23',
      },
      {
        passport: 'Australia / New Zealand / Japan / Korea',
        unilateral: '30 Days Visa-Free',
        mutual: '—',
        transit240h: 'Eligible (24 Provinces)',
        ports: '60 Official Ports',
        updated: '2026-11-23',
      },
      {
        passport: 'United States / United Kingdom / Canada',
        unilateral: 'Visa Required',
        mutual: '—',
        transit240h: 'Eligible (Onward Ticket)',
        ports: '60 Official Ports',
        updated: '2026-11-23',
      },
    ];
---
<Layout
  title={isZh ? '设计系统 · 正版 AlignUI v2.0 官方组件库 (49 Free + Pro)' : 'Design System · Official AlignUI v2.0 (49 Free + Pro)'}
  description={
    isZh
      ? 'Astro 7 + React 19 + Tailwind CSS v4 驱动的正版 AlignUI v2.0 官方组件库（49 个 Free 基础组件 + 22 类 Pro 区块 + 4 套行业模板）。'
      : 'Genuine AlignUI v2.0 Design System powered by Astro 7 + React 19 + Tailwind CSS v4 (49 Free primitives + 22 Pro Blocks + 4 Pro Templates).'
  }
>
  <div class="container ds-shell">
    <Breadcrumb
      items={[
        { label: isZh ? '首页' : 'Home', href: lp('/') },
        { label: isZh ? '设计系统 · AlignUI v2.0 官方版' : 'Design System · Official AlignUI v2.0' },
      ]}
      jsonLd
    />

    <header class="portal-hero" style="margin-bottom:var(--space-6);">
      <div class="portal-hero-head">
        <div class="portal-hero-copy">
          <span class="kicker">
            {isZh
              ? 'Official AlignUI v2.0 · Astro 7.4.13 + React 19 + Tailwind CSS v4'
              : 'Official AlignUI v2.0 · Astro 7.4.13 + React 19 + Tailwind CSS v4'}
          </span>
          <h1>
            {isZh
              ? '正版 AlignUI 官方基础组件库（全部 49 个 Free 原语）'
              : 'Official AlignUI v2.0 Base Component Library (All 49 Free Primitives)'}
          </h1>
          <p>
            {isZh
              ? '采用官方标准蓝 blue-500（#335cff，白字对比度 5.10:1）、Figma 2.0 标准外观、Inter Variable + 中文 600 字重/零负字距与浅深双模式；Pro 区块与 4 套行业模板独立挂载于子展台。'
              : 'Configured with official AlignUI Blue 500 (#335cff, 5.10:1 contrast), standard Figma 2.0 appearance, Inter Variable, and dual light/dark themes.'}
          </p>
        </div>
      </div>
    </header>

    <AlignUIOfficialShowcase
      client:load
      isZh={isZh}
      visaRows={visaRows}
      blocksHref={lp('/design-system/blocks/')}
    />
  </div>
</Layout>
