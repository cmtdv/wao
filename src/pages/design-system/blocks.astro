---
import Layout from '@layouts/Layout.astro';
import Breadcrumb from '@ui/navigation/Breadcrumb.astro';
import Button from '@ui/actions/Button.astro';
import DataTable from '@ui/data-display/DataTable.astro';
import AnnouncementBlock from '@blocks/marketing/AnnouncementBlock.astro';
import HeroBlock from '@blocks/marketing/HeroBlock.astro';
import BrandSocialBlock from '@blocks/marketing/BrandSocialBlock.astro';
import FeaturesBlock from '@blocks/marketing/FeaturesBlock.astro';
import PricingBlock from '@blocks/marketing/PricingBlock.astro';
import TestimonialsBlock from '@blocks/marketing/TestimonialsBlock.astro';
import TeamsBlock from '@blocks/marketing/TeamsBlock.astro';
import CareersBlock from '@blocks/marketing/CareersBlock.astro';
import IntegrationsBlock from '@blocks/marketing/IntegrationsBlock.astro';
import CtaBlock from '@blocks/marketing/CtaBlock.astro';
import StatsStrip from '@blocks/editorial/StatsStrip.astro';
import FilterBarBlock from '@blocks/editorial/FilterBarBlock.astro';
import BlogGridBlock from '@blocks/editorial/BlogGridBlock.astro';
import HowItWorksBlock from '@blocks/editorial/HowItWorksBlock.astro';
import FaqBlock from '@blocks/editorial/FaqBlock.astro';
import NewsletterBlock from '@blocks/editorial/NewsletterBlock.astro';
import ContactBlock from '@blocks/editorial/ContactBlock.astro';
import AuthCardBlock from '@blocks/application/AuthCardBlock.astro';
import ProfileCardBlock from '@blocks/application/ProfileCardBlock.astro';
import NotificationFeedBlock from '@blocks/application/NotificationFeedBlock.astro';
import GroundPulseForm from '@blocks/application/GroundPulseForm.astro';
import {
  DS_BLOG_PREVIEW,
  DS_BRAND_SOURCES,
  DS_FAQ_ITEMS,
  DS_FEATURES,
  DS_HOW_STEPS,
  DS_INTEGRATIONS,
  DS_PRICING_TIERS,
  DS_ROLES,
  DS_TEAM,
  DS_TESTIMONIALS,
  PRO_BLOCK_COVERAGE,
} from '@data/design-system-catalog';
import { getLocaleFromContext, localePath } from '@i18n/ui';
import '@styles/specialty.css';
import '@styles/design-system.css';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);

const coverageColumns = isZh
  ? [
      { key: 'category', label: '区块类别', type: 'string' as const, rowHeader: true },
      { key: 'group', label: '所属域', type: 'string' as const },
      { key: 'path', label: 'ChinaWao 原生模块路径', type: 'string' as const },
      { key: 'status', label: '覆盖状态', type: 'string' as const },
    ]
  : [
      { key: 'category', label: 'Block Category', type: 'string' as const, rowHeader: true },
      { key: 'group', label: 'Domain', type: 'string' as const },
      { key: 'path', label: 'ChinaWao Native Module', type: 'string' as const },
      { key: 'status', label: 'Status', type: 'string' as const },
    ];

const coverageRows = PRO_BLOCK_COVERAGE.map((r) => ({
  category: r.category,
  group: r.group,
  path: r.chinaWaoPath,
  status: { text: isZh ? '100% 原生实现' : '100% Native', badgeTone: 'verified' as const },
}));
---
<Layout
  title={isZh ? '设计系统 · 39 类 Pro 区块展台' : 'Design System · 39 Pro Blocks'}
  description={
    isZh
      ? 'ChinaWao 原生构建的全部 39 类营销、编辑出版与应用交互 Pro 级页面区块完整展台。'
      : 'Complete showcase of all 39 Pro-grade Marketing, Editorial, and Application page blocks built natively for ChinaWao.'
  }
>
  <div class="container ds-shell">
    <Breadcrumb
      items={[
        { label: isZh ? '首页' : 'Home', href: lp('/') },
        { label: isZh ? '设计系统' : 'Design System', href: lp('/design-system/') },
        { label: isZh ? 'Pro 区块展台 (39)' : 'Pro Blocks (39)' },
      ]}
      jsonLd
    />

    <header class="portal-hero">
      <div class="portal-hero-head">
        <div class="portal-hero-copy">
          <span class="kicker">{isZh ? 'ChinaWao 路线 A · Pro 级页面区块库' : 'ChinaWao Route A · Pro-Grade Blocks Suite'}</span>
          <h1>{isZh ? '39 类页面区块与全量核验台账' : '39 Page Blocks & Complete Coverage Matrix'}</h1>
          <p class="portal-lead">
            {isZh ? (
              <>全部营销、编辑出版与应用交互类页面区块均以零依赖原生 Astro 组件形式构建于 <code>src/components/blocks/</code> 目录，完整适配亮暗双模态与响应式断点。</>
            ) : (
              <>Every Marketing, Editorial, and Application block category from the full system recreated cleanly as zero-dependency Astro components under <code>src/components/blocks/</code>.</>
            )}
          </p>
          <div class="ds-row" style="margin-top: var(--space-3);">
            <Button href={lp('/design-system/')} variant="secondary" size="sm">{isZh ? '← 基础组件套件 (49)' : '← Base UI Kit (49)'}</Button>
            <Button href={lp('/design-system/blocks/')} variant="primary" size="sm">{isZh ? 'Pro 区块展台 (39)' : 'Pro Blocks Showcase (39)'}</Button>
          </div>
        </div>
      </div>

      <nav class="pillar-jump-bar" aria-label={isZh ? '跳转至区块分组' : 'Jump to block group'}>
        <a href="#blk-marketing" class="pillar-jump-link">{isZh ? '营销展示' : 'Marketing'}</a>
        <a href="#blk-pricing" class="pillar-jump-link">{isZh ? '方案定价' : 'Pricing'}</a>
        <a href="#blk-proof" class="pillar-jump-link">{isZh ? '背书与团队' : 'Proof & Teams'}</a>
        <a href="#blk-editorial" class="pillar-jump-link">{isZh ? '编辑出版' : 'Editorial'}</a>
        <a href="#blk-app" class="pillar-jump-link">{isZh ? '应用交互' : 'Application'}</a>
        <a href="#blk-contact" class="pillar-jump-link">{isZh ? '联系与实测流' : 'Contact & Pulse'}</a>
        <a href="#blk-matrix" class="pillar-jump-link">{isZh ? '39/39 覆盖矩阵' : '39/39 Matrix'}</a>
      </nav>
    </header>

    {/* 1. Marketing Blocks */}
    <section id="blk-marketing" class="ds-section ds-stack">
      <span class="kicker">{isZh ? '01 · 营销展示区块（公告栏 · 首屏 · 来源墙 · 特性 · 行动号召）' : '01 · Marketing Blocks (Announcement · Hero · Brand Sources · Features · CTA)'}</span>
      <AnnouncementBlock
        text={isZh ? 'ChinaWao 2026 冬季版上线：全景中国图谱、18 个核验官方门户与 240 小时过境实操剧本。' : 'ChinaWao 2026 Winter Edition live: China Atlas, 18 Verified Official Portals & 240-Hour Transit Playbook.'}
        linkLabel={isZh ? '打开全景图谱' : 'Open Atlas'}
        linkHref={lp('/atlas/')}
      />
      <HeroBlock
        title={isZh ? '以一手核验精度，从容探索当代中国' : 'Navigate Modern China with Source-Verified Precision'}
        subtitle={isZh ? '涵盖 240 小时过境免签、12306 高铁购票、广交会源头采购与国家公开数据——基于零冗余现代 Web 标准构建。' : 'From 240-hour visa-free transit and 12306 rail booking to Canton Fair sourcing and national open data — built on zero-bloat web standards.'}
      />
      <BrandSocialBlock brands={DS_BRAND_SOURCES} />
      <FeaturesBlock
        title={isZh ? '面向一线实战的稳定架构' : 'Architected for Field Reliability'}
        subtitle={isZh ? '零视觉干扰、车站移动端高可读性、经数学校验的亮暗双模态对比度。' : 'Zero clutter, high legibility on mobile stations, and dual-mode contrast checked mathematically.'}
        items={DS_FEATURES}
      />
      <CtaBlock
        title={isZh ? '准备好规划入境行程或核验官方门户了吗？' : 'Ready to plan your arrival or verify a Chinese portal?'}
        description={isZh ? '直接进入 7 步抵华实操清单、全屏双语字卡，或浏览经核验的国家政务公开名录。' : 'Jump straight into the 7-step arrival checklist, bilingual fullscreen flashcards, or the verified government open-data directory.'}
      />
    </section>

    {/* 2. Pricing */}
    <section id="blk-pricing" class="ds-section">
      <PricingBlock
        title={isZh ? '开放知识核心 + 可选研究案头支持' : 'Open Knowledge Core with Optional Research Desk'}
        subtitle={isZh ? '支持按月 / 按年切换交互（UI 套件本地演示）。' : 'Interactive Monthly / Annual billing toggle (mock UI Kit demonstration).'}
        tiers={DS_PRICING_TIERS}
      />
    </section>

    {/* 3. Proof, Teams, Careers, Integrations */}
    <section id="blk-proof" class="ds-section ds-stack">
      <TestimonialsBlock title={isZh ? '受旅行者、采购商与研究者信赖' : 'Trusted by Travelers, Buyers & Researchers'} items={DS_TESTIMONIALS} />
      <TeamsBlock
        title={isZh ? '编辑部与一手核验案头' : 'Editorial & Verification Desk'}
        subtitle={isZh ? '每个领域案头均结合中文官方原文核验与国际读者的实操体验。' : 'Every domain desk pairs primary-language Chinese source checking with international traveler UX.'}
        members={DS_TEAM}
      />
      <IntegrationsBlock
        title={isZh ? '持续追踪的官方门户与基础设施系统' : 'Tracked Official Portals & Systems'}
        subtitle={isZh ? '直达经核验的政务与交通系统，透明标注反爬备用状态。' : 'Direct links to verified government and transport systems, with transparent WAF standby status.'}
        items={DS_INTEGRATIONS}
      />
      <CareersBlock
        title={isZh ? '开放研究奖学金与特约撰稿席位' : 'Open Fellowships & Contributor Roles'}
        subtitle={isZh ? '特约实录采写、公开数据工程与区域实地核查。' : 'Commissioned reporting, open-data engineering, and regional field checks.'}
        roles={DS_ROLES}
      />
    </section>

    {/* 4. Editorial Blocks */}
    <section id="blk-editorial" class="ds-section ds-stack">
      <span class="kicker">{isZh ? '04 · 编辑出版区块（数据带 · 筛选栏 · 志刊网格 · 核验流程 · FAQ · 订阅）' : '04 · Editorial Blocks (Stats · FilterBar · BlogGrid · HowItWorks · FAQ · Newsletter)'}</span>
      <StatsStrip
        items={
          isZh
            ? [
                { label: '省级行政区', value: '34', note: '覆盖全国省市与特区' },
                { label: '基础原子组件', value: '49 / 49', note: '100% 原生覆盖' },
                { label: 'Pro 页面区块', value: '39 / 39', note: '营销 · 编辑 · 应用' },
                { label: '商业版权字体', value: '0', note: '仅用 SIL OFL 1.1 开源字体' },
              ]
            : [
                { label: 'Provincial Regions', value: '34', note: 'Full geographic coverage' },
                { label: 'Base Primitives', value: '49 / 49', note: '100% native coverage' },
                { label: 'Pro Block Suite', value: '39 / 39', note: 'Marketing · Editorial · App' },
                { label: 'Commercial Fonts', value: '0', note: 'SIL OFL 1.1 only' },
              ]
        }
      />
      <FilterBarBlock />
      <BlogGridBlock title={isZh ? '最新一手核验实录' : 'Latest Verified Field Dispatches'} items={DS_BLOG_PREVIEW} />
      <HowItWorksBlock
        title={isZh ? '每一条 ChinaWao 事实如何完成核验' : 'How Every ChinaWao Fact Is Verified'}
        subtitle={isZh ? '从部委原文发布到一线实地复核的四阶段透明流程。' : 'Four transparent stages from ministry publication to on-the-ground verification.'}
        steps={DS_HOW_STEPS}
      />
      <FaqBlock
        title={isZh ? '编辑与技术常见问题' : 'Editorial & Technical Questions'}
        subtitle={isZh ? '点击任意条目体验原生平滑 <details> 展开效果。' : 'Click any row to inspect native smooth <details> disclosure.'}
        items={DS_FAQ_ITEMS}
        exclusiveName="blk-faq-group"
      />
      <NewsletterBlock />
    </section>

    {/* 5. Application Blocks */}
    <section id="blk-app" class="ds-section ds-stack">
      <span class="kicker">{isZh ? '05 · 应用交互区块（认证卡片与 OTP · 资料卡片 · 通知动态流）' : '05 · Application Blocks (AuthCard + OTP · ProfileCard · NotificationFeed)'}</span>
      <AuthCardBlock />
      <ProfileCardBlock />
      <NotificationFeedBlock />
    </section>

    {/* 6. Contact & Ground Pulse */}
    <section id="blk-contact" class="ds-section ds-stack">
      <ContactBlock />
      <GroundPulseForm />
    </section>

    {/* 7. Complete 39/39 Coverage Table */}
    <section id="blk-matrix" class="ds-section">
      <span class="kicker">{isZh ? '07 · 全量核验台账' : '07 · Complete Audit Ledger'}</span>
      <h2>{isZh ? '39 / 39 Pro 区块类别原生映射表' : '39 / 39 Pro Block Category Coverage'}</h2>
      <p class="ds-lead">
        {isZh ? (
          <>点击任意列头即可排序。全部 39 类区块均对应 <code>f:\chinawao-web</code> 内的原创 Astro 组件模块。</>
        ) : (
          <>Click any column header to sort the ledger. Every category resolves to an original Astro module inside <code>f:\chinawao-web</code>.</>
        )}
      </p>
      <DataTable
        id="ds-pro-matrix"
        caption={isZh ? 'ChinaWao 路线 A —— 39 类 Pro 区块原生实现映射表' : 'ChinaWao Route A — 39 Pro Block Categories Native Mapping'}
        columns={coverageColumns}
        rows={coverageRows}
        compact
      />
    </section>
  </div>
</Layout>
