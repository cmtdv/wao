---
/**
 * Mother Template 6: /tools/ — Utility Dock Hub (All 11 Tools + Fullscreen Show Cards)
 */
import BaseShell from '@layouts/BaseShell.astro';
import ResponsiveBreadcrumb from '../../components/nav/ResponsiveBreadcrumb.astro';
import Button from '@ui/actions/Button.astro';
import { UTILITY_TOOLS } from '@data/paradigm-e/pillars';
import { getLocaleFromContext, localePath } from '@i18n/ui';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (p: string) => localePath(p, locale);

const detTools = UTILITY_TOOLS.filter((t) => t.group === 'deterministic');
const microTools = UTILITY_TOOLS.filter((t) => t.group === 'micro');
---
<BaseShell
  title={isZh ? '实用工具与亮屏字卡' : 'Practical Tools & Show Cards'}
  description={isZh ? '免签测算、跨时区放票日历、离境退税、工签积分、企业信用码校验与日常换算工具。' : 'Visa checker, ticket release timezone calendar, tax refund, work permit points, USCC validator, and everyday converters.'}
  persona="safety"
>
  <div class="container" style="padding-bottom:var(--space-8);">
    <ResponsiveBreadcrumb
      items={[
        { label: isZh ? '首页' : 'Home', href: lp('/') },
        { label: isZh ? '实用工具' : 'Tools' },
      ]}
      mobileBackHref={lp('/')}
      mobileBackLabel={isZh ? '首页' : 'Home'}
    />

    <header style="max-width:52rem;margin-bottom:var(--space-6);">
      <h1>{isZh ? '实用工具与亮屏字卡' : 'Practical Tools & Show Cards'}</h1>
      <p class="archive-lead" style="margin-top:0.4rem;">
        {isZh
          ? '出行、长居与采购常用的在线测算、时区换算与亮屏出示字卡，全部在浏览器本地即时计算。'
          : 'Instant browser-side calculators, timezone converters, validators, and fullscreen show-to-local cards.'}
      </p>
    </header>

    <section style="margin-bottom:var(--space-7);">
      <h2 style="font-size:1.3rem;margin-bottom:var(--space-4);">
        {isZh ? '出行、政务与商务核验' : 'Travel, Permits & Verification'}
      </h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(19rem,1fr));gap:var(--space-4);">
        {detTools.map((tool) => (
          <article class="pe-side-card" style="display:flex;flex-direction:column;justify-content:space-between;gap:var(--space-3);">
            <div>
              <h3 style="font-family:var(--font-display);font-size:1.2rem;">
                {isZh ? tool.nameZh : tool.name}
              </h3>
              <p style="font-size:var(--text-sm);color:var(--ink-secondary);margin-top:0.35rem;line-height:1.55;">
                {isZh ? tool.shortDescZh : tool.shortDesc}
              </p>
            </div>
            <Button href={lp(tool.href)} variant="secondary" size="sm">
              {isZh ? '打开工具 →' : 'Open Tool →'}
            </Button>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2 style="font-size:1.3rem;margin-bottom:var(--space-4);">
        {isZh ? '日常换算与汉字工具' : 'Everyday Converters & Hanzi'}
      </h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(19rem,1fr));gap:var(--space-4);">
        {microTools.map((tool) => (
          <article class="pe-side-card" style="display:flex;flex-direction:column;justify-content:space-between;gap:var(--space-3);">
            <div>
              <h3 style="font-family:var(--font-display);font-size:1.2rem;">
                {isZh ? tool.nameZh : tool.name}
              </h3>
              <p style="font-size:var(--text-sm);color:var(--ink-secondary);margin-top:0.35rem;line-height:1.55;">
                {isZh ? tool.shortDescZh : tool.shortDesc}
              </p>
            </div>
            <Button href={lp(tool.href)} variant="secondary" size="sm">
              {isZh ? '打开工具 →' : 'Open Tool →'}
            </Button>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseShell>
