---
/**
 * Mother Template 1: Paradigm E Portal Home (/)
 * 6-Section Vertical Narrative Flow:
 *   1. Hero + Intent Search Box (⌘K) + 4 Single-Row Intent Shortcut Chips
 *   2. 72-Hour Pre-Flight Strip (4-Step Funnel above/at fold)
 *   3. 7:5 Split: GOV.UK Most Viewed (6 links) + Live Ground Pulse & Policy Log & eSIM Top 5
 *   4. Interactive 5-Layer China Panoramic Map + City 12-Dimension Quick Drawer
 *   5. Featured Deep Guides Strip (4 Flagship Cards across 4 Business Lines)
 *   6. Trust Bar + AI Developer MCP Strip + Live EmDash Dispatches Link
 */
import BaseShell from '@layouts/BaseShell.astro';
import ChinaLayerMap from '../components/maps/ChinaLayerMap.astro';
import Icon from '@site/Icon.astro';
import Badge from '@ui/data-display/Badge.astro';
import Button from '@ui/actions/Button.astro';
import { FEATURED_HOME_GUIDES } from '@data/paradigm-e/guides';
import { PILLAR_BY_ID } from '@data/paradigm-e/pillars';
import { LIVE_PULSE_REPORTS } from '@data/paradigm-e/collections';
import { PULSE_STATUS_LABELS, PULSE_ZH_MAP } from '@data/paradigm-e/i18n-zh';
import { getPublicPosts } from '@lib/cms';
import { postPath } from '@lib/format';
import { getLocaleFromContext, localePath } from '@i18n/ui';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (p: string) => localePath(p, locale);

const cmsPosts = await getPublicPosts({ limit: 3, locale }).catch(() => ({ entries: [] as never[] }));
const latestDispatches = cmsPosts.entries ?? [];

const mostViewedWeek = [
  { label: isZh ? '240 小时过境免签判定器与 60 开放口岸' : '240h Visa-Free Transit Checker & 60 Open Ports', href: '/tools/visa-checker/' },
  { label: isZh ? '支付宝 / 微信支付支持 Chase / Wise 外卡吗？' : 'Does Alipay / WeChat Pay take Chase & Wise cards?', href: '/compare/alipay-vs-wechat-pay/' },
  { label: isZh ? '微信账号受限/封号？红框全图解分步救火' : 'WeChat Restricted? Red-Box Step-by-Step Rescue', href: '/errors/wechat-restricted/' },
  { label: isZh ? '来华体检、看牙与国际医疗旅游实操指南' : 'China Medical & Dental Checkup Tourism Guide', href: '/guides/medical-dental-checkup/' },
  { label: isZh ? 'Google Maps 在华实测偏移与高德替代方案' : 'Does Google Maps Work in China? (GCJ-02 Explained)', href: '/in-china/google-maps/' },
  { label: isZh ? '18 位 USCC 校验器与 GSXT 供应商尽调引导台' : '18-Digit USCC Validator & GSXT Supplier Verification', href: '/compliance/uscc-gsxt-lookup/' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ChinaWao',
  url: Astro.url.origin,
  description: 'Everything About China, Decoded & Verified.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${Astro.url.origin}/search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---
<BaseShell
  title={isZh ? '全景解码与核验中国' : 'Everything About China, Decoded & Verified'}
  description={isZh ? '面向全球用户的中国实用指南与公开数据门户：240h 免签、无现金支付、深度专题、政务数据源与亮屏字卡。' : 'Everything about China, decoded & verified: 240h visa rules, cashless payments, practical guides, government open-data portals & show-to-local cards.'}
  jsonLd={jsonLd}
>
  {/* SECTION 1: HERO + INTENT SEARCH + 4 SHORTCUT CHIPS */}
  <section class="pe-home-hero" aria-labelledby="home-hero-h">
    <div class="container pe-hero-center">
      <h1 id="home-hero-h" class="pe-hero-title">
        {isZh ? '读懂中国，实用核验直达。' : 'Everything About China, Decoded & Verified.'}
      </h1>

      <button
        type="button"
        class="pe-hero-search-btn"
        commandfor="pe-cmd-dialog"
        command="show-modal"
        aria-label={isZh ? '打开全局搜索' : 'Search ChinaWao guides, tools & topics'}
      >
        <Icon name="search" size={18} />
        <span>
          {isZh
            ? '搜索："Google Maps 能用吗？" / "240h 免签" / "清河站" / "USCC"…'
            : 'Search: "Does Google Maps work?" / "240h visa" / "Shanghai" / "USCC"…'}
        </span>
        <kbd class="cw-kbd" data-pe-shortcut-label>⌘K</kbd>
      </button>

      <div class="pe-intent-row" role="navigation" aria-label={isZh ? '按需求快速进入' : 'Quick Intent Routing'}>
        <a href={lp('/guides/72h-pre-departure/')} class="pe-intent-chip">
          <strong>{isZh ? '即将赴华：72 小时准备' : 'Flying Soon: 72h Pre-Flight'}</strong>
          <span>{isZh ? '免签 · 绑外卡 · eSIM · 12306' : 'Visa · Cards · eSIM · 12306'}</span>
        </a>
        <a href={lp('/guides/official-forms-app-errors/')} class="pe-intent-chip">
          <strong>{isZh ? '已在现场：报错与字卡' : 'On the Ground: Error Rescue'}</strong>
          <span>{isZh ? '微信解封 · 表格图解 · 亮屏字卡' : 'WeChat Fix · Forms · Show Cards'}</span>
        </a>
        <a href={lp('/guides/factory-sourcing-due-diligence/')} class="pe-intent-chip">
          <strong>{isZh ? '商务采购：验厂与国标' : 'Business: Sourcing & USCC'}</strong>
          <span>{isZh ? '18 位信用码 · 广交会 · 3C 认证' : '18-Digit USCC · Canton Fair · 3C'}</span>
        </a>
        <a href={lp('/atlas/')} class="pe-intent-chip">
          <strong>{isZh ? '全景探索：读懂中国' : 'Explore: China Atlas'}</strong>
          <span>{isZh ? '34 省概况 · 主题索引 · 政务数据' : '34 Provinces · Topic Index · Open Data'}</span>
        </a>
      </div>
    </div>
  </section>

  {/* SECTION 2: 72-HOUR PRE-FLIGHT STRIP */}
  <section class="pe-preflight-band" aria-label={isZh ? '72 小时行前清单' : '72-Hour Pre-Flight Strip'}>
    <div class="container">
      <div class="pe-preflight-head">
        <strong>{isZh ? '起飞前 72 小时四步准备' : '72-Hour Pre-Flight Checklist'}</strong>
        <a href={lp('/guides/72h-pre-departure/')} class="editorial-link" style="font-size:var(--text-xs);">
          {isZh ? '查看完整行前指南 →' : 'Full 72h checklist →'}
        </a>
      </div>
      <div class="pe-preflight-steps">
        <a href={lp('/tools/visa-checker/')} class="pe-preflight-step">
          <span>{isZh ? '测 240h 免签与口岸 →' : 'Check 240h Visa-Free →'}</span>
        </a>
        <a href={lp('/guides/cashless-super-apps/')} class="pe-preflight-step">
          <span>{isZh ? '绑外卡与漫游 eSIM →' : 'Bind Foreign Card & eSIM →'}</span>
        </a>
        <a href={lp('/routes/beijing-to-shanghai/')} class="pe-preflight-step">
          <span>{isZh ? '12306 核验与防走错站 →' : '12306 & Station Traps →'}</span>
        </a>
        <a href={lp('/cards/')} class="pe-preflight-step">
          <span>{isZh ? '存过敏与打车亮屏卡 →' : 'Save Allergy & Taxi Cards →'}</span>
        </a>
      </div>
    </div>
  </section>

  {/* SECTION 3: 7:5 SPLIT — MOST VIEWED + RECENT FIELD REPORTS */}
  <section class="pe-section" aria-labelledby="home-most-viewed-h">
    <div class="container pe-split-7-5">
      <div>
        <h2 id="home-most-viewed-h">
          {isZh ? '本周常看' : 'Most Viewed This Week'}
        </h2>
        <ul class="pe-gov-list">
          {mostViewedWeek.map((item) => (
            <li>
              <a href={lp(item.href)}>
                <span>{item.label}</span>
                <Icon name="arrow" size={15} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <aside class="pe-pulse-box" aria-labelledby="home-pulse-h">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-2);">
          <h2 id="home-pulse-h" style="font-size:1.2rem;">
            {isZh ? '近期现场实测与政策动态' : 'Recent Field Reports & Policy Log'}
          </h2>
          <a href={lp('/pulse/')} class="editorial-link" style="font-size:var(--text-xs);">
            {isZh ? '全部 →' : 'All →'}
          </a>
        </div>

        <ul class="pe-pulse-list">
          {LIVE_PULSE_REPORTS.slice(0, 2).map((rep) => {
            const zhRep = PULSE_ZH_MAP[rep.id];
            return (
              <li class="pe-pulse-row">
                <Badge tone={rep.status === 'worked' ? 'verified' : rep.status === 'partial' ? 'standby' : 'danger'}>
                  {PULSE_STATUS_LABELS[locale][rep.status]}
                </Badge>
                <div>
                  <a href={lp(rep.relatedHref)} class="text-link" style="font-weight:600;">
                    {isZh && zhRep ? `${zhRep.passportOrCard} · ${zhRep.location}` : `${rep.passportOrCard} @ ${rep.location}`}
                  </a>
                  <span style="font-family:var(--font-mono);font-size:var(--text-2xs);color:var(--ink-tertiary);margin-left:0.4rem;">
                    {isZh && zhRep ? zhRep.timestamp : rep.timestamp}
                  </span>
                  <p style="font-size:var(--text-xs);color:var(--ink-secondary);margin-top:0.15rem;">
                    {isZh && zhRep ? zhRep.summary : rep.summary}
                  </p>
                </div>
              </li>
            );
          })}
          <li class="pe-pulse-row">
            <Badge tone="editorial">{isZh ? '政策' : 'Policy'}</Badge>
            <div>
              <a href={lp('/guides/policy-changelog/')} class="text-link" style="font-weight:600;">
                {isZh ? '2026-11 月度入境与商旅政策变更 →' : '2026-11 Monthly Policy Changelog →'}
              </a>
            </div>
          </li>
          <li class="pe-pulse-row">
            <Badge tone="verified">{isZh ? '榜单' : 'Top 5'}</Badge>
            <div>
              <a href={lp('/pulse/#esim-top5')} class="text-link" style="font-weight:600;">
                {isZh ? '本周实测稳定中国 eSIM 榜单 →' : 'This Week’s Most Reliable China eSIMs →'}
              </a>
            </div>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  {/* SECTION 4: INTERACTIVE CHINA MAP */}
  <section class="pe-section" aria-labelledby="home-map-h">
    <div class="container">
      <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:var(--space-3);">
        <h2 id="home-map-h">
          {isZh ? '中国城市与主题图层地图' : 'Interactive China Map'}
        </h2>
        <a href={lp('/explore/')} class="editorial-link">
          {isZh ? '按条件筛选全部内容 →' : 'Explore by Filter →'}
        </a>
      </div>

      <ChinaLayerMap locale={locale} />
    </div>
  </section>

  {/* SECTION 5: FEATURED GUIDES */}
  <section class="pe-section" aria-labelledby="home-featured-h">
    <div class="container">
      <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:var(--space-3);">
        <h2 id="home-featured-h">
          {isZh ? '精选深度指南' : 'Featured Guides'}
        </h2>
        <a href={lp('/guides/')} class="editorial-link">
          {isZh ? '浏览全部指南 →' : 'Browse All Guides →'}
        </a>
      </div>

      <div class="pe-featured-4">
        {FEATURED_HOME_GUIDES.map((g) => (
          <a href={lp(`/guides/${g.slug}/`)} class="pe-feature-card">
            <div class="pe-feature-media">
              <img src={g.heroImage ?? '/images/hero.webp'} alt={isZh ? g.titleZh : g.title} loading="lazy" />
            </div>
            <div class="pe-feature-body">
              <span class="eyebrow eyebrow--accent">
                {isZh ? PILLAR_BY_ID[g.pillar].nameZh : PILLAR_BY_ID[g.pillar].name}
              </span>
              <h3>{isZh ? g.titleZh : g.title}</h3>
              <p>{isZh ? g.leadHookZh : g.leadHook}</p>
            </div>
          </a>
        ))}
      </div>

      {/* Latest Dispatches Strip — open hairline columns alternating after 4-card visual strip */}
      {latestDispatches.length > 0 && (
        <div class="pe-dispatch-strip">
          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:var(--space-3);">
            <h2 style="font-size:1.25rem;">{isZh ? '最新深度文章' : 'Latest Dispatches'}</h2>
            <a href={lp('/posts/')} class="text-link" style="font-size:var(--text-xs);">
              {isZh ? '全部文章 →' : 'All Dispatches →'}
            </a>
          </div>
          <div class="pe-dispatch-grid">
            {latestDispatches.map((entry) => (
              <a href={lp(postPath(entry.data.slug || entry.id))} class="pe-dispatch-item">
                <strong>{entry.data.title}</strong>
                {entry.data.excerpt && (
                  <p>{entry.data.excerpt.slice(0, 110)}…</p>
                )}
              </a>
            ))}
          </div>
        </div>
      )}

      {/* SECTION 6: OPEN DATA & API BAR */}
      <div class="pe-trust-strip" role="region" aria-label={isZh ? '公开数据与接口' : 'Open Data & API'}>
        <div class="pe-trust-metrics">
          <span><strong>848</strong> {isZh ? '实测政务数据源' : 'Verified Gov Portals'}</span>
          <span>·</span>
          <span><strong>2,913</strong> {isZh ? '外文国家标准' : 'English GB Standards'}</span>
          <span>·</span>
          <span><strong>1,422</strong> {isZh ? '中华老字号' : 'Heritage Brands'}</span>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);">
          <Button href={lp('/portals/#mcp-setup')} variant="primary" size="sm">
            {isZh ? '接入数据接口' : 'Connect MCP Data'}
          </Button>
          <Button href="/llms.txt" variant="secondary" size="sm">
            llms.txt
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseShell>
