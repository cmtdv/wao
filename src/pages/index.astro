---
/**
 * ChinaWao Minimal Content Editorial MVP Homepage (/)
 * - Focused exclusively on published articles, categories/topics, tags, and full-text search
 * - Obeys 6 Visual Hierarchy Hard Constraints:
 *   1. Single primary focal point above the fold (Asymmetric Lead Story + 3-Item Rail)
 *   2. 4-tier typographic & ink hierarchy
 *   3. Unboxed hairline-divided ledgers & category bars (no nested box-in-box clutter)
 *   4. Strict spacing ratio (section >= 2x group >= 2x element)
 *   5. Alternating layout rhythms (Asymmetric 7:5 Lead -> Category Strip + 3-Col Feed -> 7:5 Topics & Tags Split)
 *   6. Restrained brand accent (single primary button in hero)
 */
import { getSiteSettings, getTaxonomyTermsWithCacheHint } from 'emdash';
import Layout from '@layouts/Layout.astro';
import AsymmetricHero from '@site/AsymmetricHero.astro';
import PostCard from '@site/PostCard.astro';
import Icon from '@site/Icon.astro';
import { getPublicPosts, publicContext } from '@lib/cms';
import { categoryPath, tagPath } from '@lib/format';
import { getLocaleFromContext, getStrings, localePath } from '@i18n/ui';
import { buildOrgPublisher } from '@lib/seo-geo';
import '../styles/home.css';
import '../styles/topic.css';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const strings = getStrings(locale);
const lp = (path: string) => localePath(path, locale);

const [settings, postsResult, catPrimary, tagPrimary] = await Promise.all([
  getSiteSettings(),
  getPublicPosts({ limit: 16, locale }),
  publicContext(() => getTaxonomyTermsWithCacheHint('category', { includeCounts: true, locale })),
  publicContext(() => getTaxonomyTermsWithCacheHint('tag', { includeCounts: true, locale })),
]);

const categoriesRes =
  catPrimary.data.length > 0 || locale === 'en'
    ? catPrimary
    : await publicContext(() => getTaxonomyTermsWithCacheHint('category', { includeCounts: true, locale: 'en' }));

const tagsRes =
  tagPrimary.data.length > 0 || locale === 'en'
    ? tagPrimary
    : await publicContext(() => getTaxonomyTermsWithCacheHint('tag', { includeCounts: true, locale: 'en' }));

if (postsResult.error) {
  return new Response('Unable to load posts', { status: 503 });
}

if (Astro.cache?.enabled) {
  Astro.cache.set(postsResult.cacheHint);
  Astro.cache.set(categoriesRes.cacheHint);
  Astro.cache.set(tagsRes.cacheHint);
}

const allPosts = postsResult.entries ?? [];
const leadPost = allPosts[0] ?? null;
const railPosts = allPosts.slice(1, 4);
const feedPosts = allPosts.slice(4, 13);

type Term = (typeof categoriesRes.data)[number];
const flatten = (items: Term[]): Term[] =>
  items.flatMap((item) => [item, ...flatten(item.children ?? [])]);
const allCategories = flatten(categoriesRes.data);
const rootCategories = categoriesRes.data.filter((term) => !term.parentId);
const allTags = (tagsRes.data ?? []).toSorted((a, b) => a.label.localeCompare(b.label, isZh ? 'zh-CN' : 'en'));

function getSubtopics(root: Term): Term[] {
  return root.children?.length
    ? root.children
    : allCategories.filter((item) => item.parentId === root.id);
}

function getTermCount(term: { count?: unknown }): number | null {
  return typeof term.count === 'number' ? term.count : null;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    buildOrgPublisher(Astro.url.origin),
    {
      '@type': 'WebSite',
      '@id': `${Astro.url.origin}/#website`,
      name: settings.title || 'ChinaWao',
      url: Astro.url.origin,
      inLanguage: ['en', 'zh-CN'],
      publisher: { '@id': `${Astro.url.origin}/#organization` },
      description: isZh
        ? '经一手信源核验的中国实用指南与深度志刊。'
        : 'Source-verified practical guides and dispatches on China.',
      potentialAction: {
        '@type': 'SearchAction',
        target: `${Astro.url.origin}/search/?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
---
<Layout
  title={isZh ? '实证志刊与实用指南' : 'Source-Verified China Guides & Dispatches'}
  description={isZh ? '面向全球读者的中国实用指南与深度实录：高铁出行、过境免签、移动支付与城市人文。' : 'Source-verified practical guides and field dispatches on China: high-speed rail, 240-hour visa-free transit, mobile payments, and cultural essays.'}
  jsonLd={jsonLd}
>
  <div id="front-edition" class="container home-shell" style="padding-top: var(--space-5); padding-bottom: var(--space-8);">
    {/* Compact Unboxed Editorial Masthead Bar */}
    <div class="edition-bar" style="margin-bottom: var(--space-5);">
      <p class="eyebrow eyebrow--accent">
        {isZh ? 'ChinaWao 实证志刊' : 'ChinaWao Journal'}
      </p>
      <p class="edition-tagline">
        {isZh
          ? '基于官方一手信源与现场实测的中国实用指南与深度报道'
          : (settings.tagline || strings.home.editionTagline)}
      </p>
      <a href={lp('/posts/')} class="editorial-link">
        <span>{isZh ? `全部文章 (${allPosts.length})` : `All articles (${allPosts.length})`}</span>
        <Icon name="arrow" size={14} />
      </a>
    </div>

    {/* SECTION 1: SINGLE PRIMARY FOCAL POINT — ASYMMETRIC LEAD STORY + FEATURED RAIL */}
    {leadPost ? (
      <AsymmetricHero
        lead={leadPost}
        railPosts={railPosts}
        railTitle={isZh ? '近期精选' : 'Recent Highlights'}
        headingLevel="h1"
      />
    ) : (
      <section class="empty-panel">
        <p class="eyebrow eyebrow--accent">{isZh ? '编辑部' : 'Editorial Desk'}</p>
        <h1>{isZh ? '暂未发布文章。' : 'No articles published yet.'}</h1>
        <p>{isZh ? '可通过本地 Markdown 脚本或 /_emdash/admin 后台发布第一篇文章。' : 'Publish your first article via Markdown CLI or /_emdash/admin.'}</p>
      </section>
    )}

    {/* SECTION 2: CATEGORY FILTER BAR + LATEST ARTICLES FEED */}
    {feedPosts.length > 0 && (
      <section class="section-block" aria-labelledby="latest-heading">
        <div class="section-header" style="margin-bottom: var(--space-4);">
          <div>
            <p class="rail-heading">{isZh ? '最新归档' : 'Latest Dispatches'}</p>
            <h2 id="latest-heading">{isZh ? '近期发布文章' : 'Recent articles'}</h2>
          </div>
          <a href={lp('/posts/')} class="editorial-link">
            <span>{isZh ? '浏览全部文章' : 'Browse full archive'}</span>
            <Icon name="arrow" size={15} />
          </a>
        </div>

        {rootCategories.length > 0 && (
          <nav class="pipe-bar" aria-label={isZh ? '按栏目浏览' : 'Browse by category'} style="margin-bottom: var(--space-5);">
            <a href={lp('/posts/')} class="pipe-link" aria-current="page">
              <span>{isZh ? '全部文章' : 'All'}</span>
            </a>
            {rootCategories.map((term) => (
              <a href={lp(categoryPath(term.slug))} class="pipe-link">
                <span>{term.label}</span>
              </a>
            ))}
            <a href={lp('/topics/')} class="pipe-link">
              <span>{isZh ? '更多栏目 →' : 'All Topics →'}</span>
            </a>
          </nav>
        )}

        <div class="post-grid">
          {feedPosts.map((post) => (
            <PostCard post={post} headingLevel="h3" />
          ))}
        </div>
      </section>
    )}

    {/* SECTION 3: ASYMMETRIC 7:5 TOPICS DIRECTORY LEDGER + TAGS & ARCHIVE SEARCH */}
    <section class="section-block" aria-labelledby="topics-directory-heading">
      <div class="pe-split-7-5">
        {/* Left 7 cols: Unboxed Hairline-Divided Categories Ledger */}
        <div>
          <div class="section-header" style="margin-bottom: var(--space-4);">
            <div>
              <p class="rail-heading">{isZh ? '分类导航' : 'Editorial Sections'}</p>
              <h2 id="topics-directory-heading">{isZh ? '按栏目探索' : 'Explore by topic'}</h2>
            </div>
            <a href={lp('/topics/')} class="editorial-link">
              <span>{isZh ? '完整栏目目录' : 'Full topics index'}</span>
              <Icon name="arrow" size={15} />
            </a>
          </div>

          <ul style="list-style:none;padding:0;margin:0;border-top:1px solid var(--border);">
            {rootCategories.map((cat) => {
              const subs = getSubtopics(cat);
              const count = getTermCount(cat);
              return (
                <li style="padding-block:var(--space-4);border-bottom:1px solid var(--border);display:grid;gap:0.45rem;">
                  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:var(--space-3);">
                    <h3 style="font-size:var(--text-lg);font-weight:600;line-height:1.3;">
                      <a href={lp(categoryPath(cat.slug))} class="text-link">
                        {cat.label}
                      </a>
                    </h3>
                    {count !== null && (
                      <span class="meta-line">
                        {isZh ? `${count} 篇` : `${count} ${count === 1 ? 'article' : 'articles'}`}
                      </span>
                    )}
                  </div>
                  {cat.description && (
                    <p style="font-size:var(--text-sm);color:var(--muted-foreground);line-height:1.55;">
                      {cat.description}
                    </p>
                  )}
                  {subs.length > 0 && (
                    <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:0.2rem;">
                      {subs.map((sub) => (
                        <a
                          href={lp(categoryPath(sub.slug))}
                          style="font-size:var(--text-xs);color:var(--muted-foreground);padding:0.15rem 0.55rem;border:1px solid var(--border);border-radius:var(--radius-xs);text-decoration:none;"
                        >
                          {sub.label}
                        </a>
                      ))}
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </div>

        {/* Right 5 cols: Quiet Tonal Panel with Search & Tags */}
        <aside class="pe-pulse-box" aria-label={isZh ? '检索与高频标签' : 'Search and popular tags'}>
          <div>
            <p class="eyebrow eyebrow--accent">{isZh ? '全文检索' : 'Archive Search'}</p>
            <h3 style="font-size:var(--text-lg);font-weight:600;margin-top:0.35rem;">
              {isZh ? '快速查找实录与攻略' : 'Find dispatches & guides'}
            </h3>
            <form action={lp('/search/')} method="get" style="display:flex;gap:0.5rem;margin-top:var(--space-3);">
              <label for="home-search-q" class="visually-hidden">{isZh ? '搜索关键词' : 'Search keyword'}</label>
              <input
                id="home-search-q"
                name="q"
                type="search"
                placeholder={isZh ? '输入关键词，如：12306、免签、退税…' : 'Search 12306, visa-free, Alipay…'}
                style="flex:1;min-width:0;height:var(--control-h-md);padding-inline:0.75rem;border:1px solid var(--control-border);border-radius:var(--control-radius);background:var(--background);color:var(--foreground);font-size:var(--text-sm);"
              />
              <button type="submit" class="btn" style="height:var(--control-h-md);padding-inline:0.9rem;">
                {isZh ? '搜索' : 'Search'}
              </button>
            </form>
          </div>

          {allTags.length > 0 && (
            <div style="margin-top:var(--space-6);padding-top:var(--space-5);border-top:1px solid var(--border);">
              <div style="display:flex;align-items:baseline;justify-content:space-between;gap:0.5rem;margin-bottom:var(--space-3);">
                <p class="eyebrow">{isZh ? '主题标签' : 'Topic Tags'}</p>
                <a href={lp('/tags/')} class="editorial-link" style="font-size:var(--text-xs);">
                  <span>{isZh ? '全部标签' : 'All tags'}</span>
                  <Icon name="arrow" size={13} />
                </a>
              </div>
              <div style="display:flex;flex-wrap:wrap;gap:0.45rem;">
                {allTags.map((tag) => {
                  const cnt = getTermCount(tag);
                  return (
                    <a
                      href={lp(tagPath(tag.slug))}
                      class="term-pill"
                      style="text-decoration:none;"
                    >
                      <span>#{tag.label}</span>
                      {cnt !== null && <span style="opacity:0.65;margin-inline-start:0.2rem;">({cnt})</span>}
                    </a>
                  );
                })}
              </div>
            </div>
          )}
        </aside>
      </div>
    </section>
  </div>
</Layout>
