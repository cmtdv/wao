---
/**
 * 5 Dynamic Primary Pillar Pages — Each renders its own completely independent, benchmark-modeled layout:
 *   /travel/   -> TravelPillarPage   (Wise × GOV.UK Step-by-Step × Japan-Guide)
 *   /live/     -> LivePillarPage     (Nomad List × Expatica × GOV.UK Visas)
 *   /business/ -> BusinessPillarPage (China Briefing × Trade.gov × Live USCC Verifier)
 *   /places/   -> PlacesPillarPage   (Lonely Planet × Michelin Guide × Atlas Obscura)
 *   /culture/  -> CulturePillarPage  (Monocle 3-Col Magazine × Eater × Mandarin Soundboard)
 *   (/atlas/ is routed via src/pages/atlas/index.astro -> AtlasPillarPage)
 */
import TravelPillarPage from '../../components/pillars/TravelPillarPage.astro';
import LivePillarPage from '../../components/pillars/LivePillarPage.astro';
import BusinessPillarPage from '../../components/pillars/BusinessPillarPage.astro';
import PlacesPillarPage from '../../components/pillars/PlacesPillarPage.astro';
import CulturePillarPage from '../../components/pillars/CulturePillarPage.astro';
import { getLocaleFromContext, localePath } from '@i18n/ui';

const rawPillar = (Astro.params.pillar || '').toLowerCase();
const locale = getLocaleFromContext(Astro);

if (rawPillar === 'visit') {
  return Astro.redirect(localePath('/travel/', locale), 301);
}

const valid = ['travel', 'live', 'business', 'places', 'culture'];
if (!valid.includes(rawPillar)) {
  return new Response('Not Found', { status: 404 });
}
---
{rawPillar === 'travel' && <TravelPillarPage />}
{rawPillar === 'live' && <LivePillarPage />}
{rawPillar === 'business' && <BusinessPillarPage />}
{rawPillar === 'places' && <PlacesPillarPage />}
{rawPillar === 'culture' && <CulturePillarPage />}
