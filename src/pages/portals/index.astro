---
/**
 * Mother Template 6: /portals/ — 848 Government Open Data Portals & ChinaWao MCP Center
 * - Top pinned One-Click Copy MCP JSON Config Card (Claude Desktop / ChatGPT / Cursor)
 * - Filterable Ministry/Provincial/Municipal registry separating HTTP 200 Direct vs WAF Standby
 */
import BaseShell from '@layouts/BaseShell.astro';
import ResponsiveBreadcrumb from '../../components/nav/ResponsiveBreadcrumb.astro';
import Badge from '@ui/data-display/Badge.astro';
import Button from '@ui/actions/Button.astro';
import { GOV_PORTALS } from '@data/paradigm-e/collections';
import { PORTAL_ACCESS_ZH, PORTAL_DOMAIN_ZH, PORTAL_LEVEL_ZH } from '@data/paradigm-e/i18n-zh';
import { getLocaleFromContext, localePath } from '@i18n/ui';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (p: string) => localePath(p, locale);

const mcpUrl = `${Astro.url.origin}/mcp`;
const mcpConfigJson = JSON.stringify(
  {
    mcpServers: {
      chinawao: {
        url: mcpUrl,
        transport: 'streamable-http',
        readOnly: true,
      },
    },
  },
  null,
  2,
);
---
<BaseShell
  title={isZh ? '政务公开数据源与 MCP 接入' : 'Government Open Data Portals & MCP'}
  description={isZh ? '汇总中国国家部委与省市公开数据门户，并提供 Claude 与 Cursor 只读 MCP 配置。' : 'Audited Chinese government open-data registry and read-only ChinaWao MCP server configuration.'}
  persona="legal"
>
  <div class="container" style="padding-bottom:var(--space-8);" data-pe-portals-root>
    <ResponsiveBreadcrumb
      items={[
        { label: isZh ? '首页' : 'Home', href: lp('/') },
        { label: isZh ? '政务数据源' : 'Gov Data' },
      ]}
      mobileBackHref={lp('/')}
      mobileBackLabel={isZh ? '首页' : 'Home'}
    />

    <header style="max-width:54rem;margin-bottom:var(--space-5);">
      <h1>
        {isZh ? '中国政务公开数据源与 MCP 接入' : 'China Government Open Data & MCP'}
      </h1>
      <p class="archive-lead" style="margin-top:0.4rem;">
        {isZh
          ? '收录提供免费公开数据查询或下载的国家部委与省市政府平台，并标注官网直连与需页面验证入口。'
          : 'Official ministry and municipal open-data registries offering free public lookup or downloads, plus read-only MCP access for AI assistants.'}
      </p>
    </header>

    {/* Top Pinned MCP One-Click Configuration Card */}
    <section id="mcp-setup" class="pe-mcp-card" aria-labelledby="mcp-card-h">
      <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--space-3);margin-bottom:var(--space-4);">
        <h2 id="mcp-card-h" style="font-size:1.3rem;">
          {isZh ? 'MCP 服务接入配置（Claude / Cursor / ChatGPT）' : 'Connect ChinaWao MCP Server (Claude / Cursor / ChatGPT)'}
        </h2>
        <div style="display:flex;flex-wrap:wrap;gap:0.45rem;">
          <Button variant="primary" size="sm" data-pe-copy={mcpConfigJson} data-pe-copy-toast={isZh ? '已复制 MCP 配置' : 'Copied MCP JSON config'}>
            {isZh ? '复制配置 JSON' : 'Copy MCP JSON'}
          </Button>
          <Button href="/.well-known/mcp/server-card.json" variant="secondary" size="sm">
            server-card.json
          </Button>
          <Button href="/llms.txt" variant="ghost" size="sm">
            llms.txt
          </Button>
        </div>
      </div>

      <div class="pe-dual-desk" style="margin:0;">
        <pre class="pe-code-pre"><code>{mcpConfigJson}</code></pre>
        <div style="display:grid;gap:0.5rem;align-content:start;">
          <span class="pe-mega-col-title">{isZh ? '只读查询接口' : 'Read-Only Tools'}</span>
          <ul style="list-style:none;padding:0;margin:0;display:grid;gap:0.45rem;font-size:var(--text-xs);">
            <li><code>search_chinawao</code> — {isZh ? '跨全站指南与城市词条检索事实与链接' : 'Search guides and city entries with canonical URLs'}</li>
            <li><code>get_guide</code> — {isZh ? '按路径返回纯净 Markdown 文本' : 'Return clean Markdown for any guide'}</li>
            <li><code>check_visa_240h</code> — {isZh ? '查询 30 天免签与 240h 过境规则' : 'Check 30-day visa-free and 240h transit rules'}</li>
            <li><code>list_gov_portals</code> — {isZh ? '按层级与领域筛选官方政务数据源' : 'Filter ministry and municipal open-data portals'}</li>
          </ul>
        </div>
      </div>
    </section>

    {/* Filterable Portal Directory Table */}
    <section aria-labelledby="portals-table-h">
      <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--space-3);margin-bottom:var(--space-4);">
        <h2 id="portals-table-h" style="font-size:1.3rem;">
          {isZh ? '部委与省市公开数据源名录' : 'Ministry & Municipal Open Data Directory'}
        </h2>
      </div>

      <div style="display:flex;flex-wrap:wrap;gap:var(--space-3);margin-bottom:var(--space-4);">
        <input
          type="search"
          class="cw-input"
          placeholder={isZh ? '搜索部委、省市或领域（如 企信网、统计局、上海）…' : 'Filter by ministry, region, or domain…'}
          style="min-width:16rem;flex:1;"
          data-pe-portal-search
        />
        <select class="cw-select" aria-label={isZh ? '按行政层级筛选' : 'Filter by level'} data-pe-portal-level>
          <option value="all">{isZh ? '全部层级' : 'All Levels'}</option>
          <option value="Ministry">{isZh ? '国家部委' : 'Ministry'}</option>
          <option value="Provincial">{isZh ? '省级政府' : 'Provincial'}</option>
          <option value="Municipal">{isZh ? '市级政府' : 'Municipal'}</option>
        </select>
        <select class="cw-select" aria-label={isZh ? '按访问方式筛选' : 'Filter by access mode'} data-pe-portal-access>
          <option value="all">{isZh ? '全部访问方式' : 'All Access Modes'}</option>
          <option value="direct-200">{isZh ? '官网直连' : 'Direct Access'}</option>
          <option value="waf-standby">{isZh ? '需官网交互验证' : 'Interactive Official Check'}</option>
        </select>
      </div>

      <div class="cw-table-wrap" tabindex="0" role="region" aria-labelledby="portals-table-h">
        <table class="cw-table">
          <thead>
            <tr>
              <th scope="col">{isZh ? '官方平台' : 'Official Portal'}</th>
              <th scope="col">{isZh ? '层级与地域' : 'Level & Region'}</th>
              <th scope="col">{isZh ? '数据领域' : 'Domain'}</th>
              <th scope="col">{isZh ? '访问方式' : 'Access Mode'}</th>
              <th scope="col">{isZh ? '入口' : 'Links'}</th>
            </tr>
          </thead>
          <tbody>
            {GOV_PORTALS.map((p) => (
              <tr
                data-pe-portal-row
                data-level={p.level}
                data-access={p.access}
                data-search={`${p.name} ${p.chineseName} ${p.region} ${p.domain} ${p.accessDetail}`.toLowerCase()}
              >
                <th scope="row">
                  <strong>{isZh ? p.chineseName : p.name}</strong>
                  {!isZh && <div style="font-size:var(--text-xs);color:var(--ink-secondary);font-weight:400;">{p.chineseName}</div>}
                </th>
                <td>{isZh ? (PORTAL_LEVEL_ZH[p.level] ?? p.level) : p.level} · {p.region}</td>
                <td>{isZh ? (PORTAL_DOMAIN_ZH[p.domain] ?? p.domain) : p.domain}</td>
                <td>
                  <Badge tone={p.access === 'direct-200' ? 'verified' : 'standby'}>
                    {isZh
                      ? (PORTAL_ACCESS_ZH[p.accessDetail] ?? p.accessDetail)
                      : (p.access === 'direct-200' ? 'Direct Access' : 'Official Site Check')}
                  </Badge>
                </td>
                <td>
                  <div style="display:flex;flex-wrap:wrap;gap:0.45rem;">
                    <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-link">{isZh ? '官网 ↗' : 'Official ↗'}</a>
                    {p.guideHref && <a href={lp(p.guideHref)} class="text-link">{isZh ? '指南 →' : 'Guide →'}</a>}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseShell>
