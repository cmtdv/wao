---
/**
 * Mother Template 7: /explore/ — Multi-Facet Dynamic Explorer (Paradigm C Engine)
 * - 5 Orthogonal Facet Chip Groups: Space / Season / Kind / Audience & Constraints / Trust
 * - SEO Crawl-Budget Hygiene: Dynamic chip state writes strictly to URL #fragment (#space=310000&constraints=foreign-card)
 *   while <link rel="canonical"> stays pinned to /explore/
 */
import BaseShell from '@layouts/BaseShell.astro';
import ResponsiveBreadcrumb from '../../components/nav/ResponsiveBreadcrumb.astro';
import Badge from '@ui/data-display/Badge.astro';
import Button from '@ui/actions/Button.astro';
import { EXPLORER_FACETS, EXPLORER_ITEMS } from '@data/paradigm-e/collections';
import { EXPLORER_FACET_ZH, EXPLORER_SUMMARY_ZH } from '@data/paradigm-e/i18n-zh';
import { getLocaleFromContext, localePath } from '@i18n/ui';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (p: string) => localePath(p, locale);
const canonicalUrl = `${Astro.url.origin}${lp('/explore/')}`;
const fLabel = (value: string, fallback: string) => (isZh ? (EXPLORER_FACET_ZH[value] ?? fallback) : fallback);
---
<BaseShell
  title={isZh ? '多维内容筛选' : 'Explore China by Filter'}
  description={isZh ? '按城市、季节、类型和出行条件筛选指南、字卡与实用工具。' : 'Filter ChinaWao guides, cities, attractions, rescue pages, and kits by location, season, and travel constraints.'}
  canonical={canonicalUrl}
  persona="analyst"
>
  <div class="container" style="padding-bottom:var(--space-8);" data-pe-explorer>
    <ResponsiveBreadcrumb
      items={[
        { label: isZh ? '首页' : 'Home', href: lp('/') },
        { label: isZh ? '多维筛选' : 'Explore' },
      ]}
      mobileBackHref={lp('/')}
      mobileBackLabel={isZh ? '首页' : 'Home'}
    />

    <header style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:var(--space-4);margin-bottom:var(--space-5);">
      <div style="max-width:46rem;">
        <h1>{isZh ? '多维内容筛选' : 'Explore China'}</h1>
        <p class="archive-lead" style="margin-top:0.35rem;">
          {isZh
            ? '按城市、季节和出行条件组合筛选指南、城市、景点与实用工具。'
            : 'Filter guides, cities, attractions, and tools by location, season, and travel needs.'}
        </p>
      </div>
      <Button variant="secondary" size="sm" data-pe-explorer-reset>
        {isZh ? '重置筛选' : 'Reset'}
      </Button>
    </header>

    {/* Facet Chip Groups */}
    <section class="pe-side-card" style="margin-bottom:var(--space-6);display:grid;gap:var(--space-2);" aria-label={isZh ? '筛选条件' : 'Filters'}>
      <div>
        <span class="pe-mega-col-title" style="margin-bottom:0.25rem;border:0;padding:0;">
          {isZh ? '地区与口岸' : 'Location & 240h Zone'}
        </span>
        <div class="pe-facet-group">
          {EXPLORER_FACETS.space.map((f) => (
            <button type="button" class="pe-facet-chip" aria-pressed="false" data-pe-facet-group="space" data-pe-facet-value={f.value}>
              {fLabel(f.value, f.label)}
            </button>
          ))}
        </div>
      </div>

      <div>
        <span class="pe-mega-col-title" style="margin-bottom:0.25rem;border:0;padding:0;">
          {isZh ? '出行季节' : 'Season'}
        </span>
        <div class="pe-facet-group">
          {EXPLORER_FACETS.season.map((f) => (
            <button type="button" class="pe-facet-chip" aria-pressed="false" data-pe-facet-group="season" data-pe-facet-value={f.value}>
              {fLabel(f.value, f.label)}
            </button>
          ))}
        </div>
      </div>

      <div>
        <span class="pe-mega-col-title" style="margin-bottom:0.25rem;border:0;padding:0;">
          {isZh ? '内容类型' : 'Content Type'}
        </span>
        <div class="pe-facet-group">
          {EXPLORER_FACETS.kind.map((f) => (
            <button type="button" class="pe-facet-chip" aria-pressed="false" data-pe-facet-group="kind" data-pe-facet-value={f.value}>
              {fLabel(f.value, f.label)}
            </button>
          ))}
        </div>
      </div>

      <div>
        <span class="pe-mega-col-title" style="margin-bottom:0.25rem;border:0;padding:0;">
          {isZh ? '适用条件' : 'Travel Needs'}
        </span>
        <div class="pe-facet-group">
          {EXPLORER_FACETS.constraints.map((f) => (
            <button type="button" class="pe-facet-chip" aria-pressed="false" data-pe-facet-group="constraints" data-pe-facet-value={f.value}>
              {fLabel(f.value, f.label)}
            </button>
          ))}
        </div>
      </div>

      <div>
        <span class="pe-mega-col-title" style="margin-bottom:0.25rem;border:0;padding:0;">
          {isZh ? '核验方式' : 'Verification'}
        </span>
        <div class="pe-facet-group">
          {EXPLORER_FACETS.trust.map((f) => (
            <button type="button" class="pe-facet-chip" aria-pressed="false" data-pe-facet-group="trust" data-pe-facet-value={f.value}>
              {fLabel(f.value, f.label)}
            </button>
          ))}
        </div>
      </div>
    </section>

    {/* Dynamic Filtered Result Grid */}
    <section style="display:grid;grid-template-columns:repeat(auto-fill,minmax(19rem,1fr));gap:var(--space-4);" aria-live="polite">
      {EXPLORER_ITEMS.map((item) => (
        <article
          class="pe-side-card"
          data-pe-explorer-card
          data-space={item.space.join(',')}
          data-season={item.season.join(',')}
          data-kind={item.kind}
          data-constraints={item.constraints.join(',')}
          data-trust={item.trust}
          style="display:flex;flex-direction:column;justify-content:space-between;gap:var(--space-3);"
        >
          <div>
            <div style="display:flex;justify-content:space-between;gap:0.4rem;margin-bottom:0.4rem;">
              <Badge tone="editorial">{fLabel(item.kind, item.kind)}</Badge>
              <Badge tone={item.trust === 'tier-a' ? 'verified' : 'standby'}>
                {item.trust === 'tier-a' ? (isZh ? '官方信源' : 'Official Source') : (isZh ? '本周实测' : 'Field Verified')}
              </Badge>
            </div>
            <h2 style="font-family:var(--font-display);font-size:1.15rem;line-height:1.3;">
              <a href={lp(item.href)} class="text-link">
                {isZh ? item.titleZh : item.title}
              </a>
            </h2>
            <p style="font-size:var(--text-xs);color:var(--ink-secondary);margin-top:0.35rem;line-height:1.55;">
              {isZh ? (EXPLORER_SUMMARY_ZH[item.id] ?? item.summary) : item.summary}
            </p>
          </div>
          <div class="pe-mega-chips">
            {item.constraints.slice(0, 3).map((c) => (
              <span class="pe-mega-chip" style="padding:0.15rem 0.45rem;font-size:var(--text-2xs);">{fLabel(c, c)}</span>
            ))}
          </div>
        </article>
      ))}
    </section>

    <div class="pe-side-card" data-pe-explorer-empty hidden style="text-align:center;padding:var(--space-7);">
      <h2>{isZh ? '当前条件暂无匹配内容' : 'No matching items for these filters'}</h2>
      <p style="color:var(--ink-secondary);margin-block:0.4rem var(--space-4);font-size:var(--text-sm);">
        {isZh ? '可减少筛选条件，或直接查看常见人群专题。' : 'Try clearing a filter, or browse popular scenario guides below.'}
      </p>
      <div class="pe-mega-chips" style="justify-content:center;">
        <a href={lp('/for/solo-female/')} class="pe-mega-chip">{isZh ? '女性独行中国' : 'Solo Female Travelers'}</a>
        <a href={lp('/for/peanut-allergy/')} class="pe-mega-chip">{isZh ? '花生与坚果过敏' : 'Peanut & Nut Allergies'}</a>
        <a href={lp('/for/remote-sourcing/')} class="pe-mega-chip">{isZh ? '远程验厂采购' : 'Remote China Sourcing'}</a>
      </div>
    </div>
  </div>
</BaseShell>
