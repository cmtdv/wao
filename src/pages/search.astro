---
import { getTaxonomyTermsWithCacheHint, search } from 'emdash';
import Layout from '@layouts/Layout.astro';
import Icon from '@site/Icon.astro';
import Pagination from '@site/Pagination.astro';
import { publicContext, queryPage } from '@lib/cms';
import { categoryPath, cleanSearchQuery, pagePath, postPath, tagPath } from '@lib/format';
import { getLocaleFromContext, localePath } from '@i18n/ui';
import '../styles/search.css';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (path: string) => localePath(path, locale);

const q = cleanSearchQuery(Astro.url.searchParams.get('q'));
const cursor = Astro.url.searchParams.get('cursor') || undefined;

const [{ result: results, invalidCursor }, catsRes, tagsRes] = await Promise.all([
  queryPage(async () =>
    q
      ? publicContext(() =>
          search(q, {
            collections: ['posts', 'pages'],
            status: 'published',
            locale,
            limit: 30,
            cursor,
          }),
        )
      : { items: [], nextCursor: undefined },
  ),
  !q
    ? publicContext(() => getTaxonomyTermsWithCacheHint('category', { includeCounts: false, locale })).catch(() => ({ data: [] as never[] }))
    : Promise.resolve({ data: [] as never[] }),
  !q
    ? publicContext(() => getTaxonomyTermsWithCacheHint('tag', { includeCounts: false, locale })).catch(() => ({ data: [] as never[] }))
    : Promise.resolve({ data: [] as never[] }),
]);

if (invalidCursor) {
  return Astro.redirect(`${lp('/search/')}?${new URLSearchParams({ q })}`, 302);
}

if (!results) {
  return new Response('Search is temporarily unavailable. Please try again later.', {
    status: 503,
  });
}

const rootCats = (catsRes.data ?? []).filter((t) => !t.parentId);
const popularTags = (tagsRes.data ?? []).slice(0, 12);
---
<Layout
  title={q ? (isZh ? `搜索：${q}` : `Search: ${q}`) : (isZh ? '全文检索' : 'Search')}
  description={isZh ? '全文检索 ChinaWao 已发布的全部文章与编辑部页面。' : 'Search published articles and pages.'}
>
  <div class="container">
    <div class="search-shell">
      <header class="search-header">
        <h1>{isZh ? '全文检索' : 'Search'}</h1>
        <p class="archive-lead">
          {isZh ? '检索全部已发布的文章标题、正文与说明页面。' : 'Full-text search across all published articles and editorial pages.'}
        </p>
      </header>

      <search>
        <form action={lp('/search/')} method="get" class="search-form-bar">
          <label for="search-query" class="visually-hidden">{isZh ? '搜索文章与页面' : 'Search posts and pages'}</label>
          <Icon name="search" size={18} />
          <input
            id="search-query"
            name="q"
            type="search"
            value={q}
            placeholder={isZh ? '输入关键词，如：12306、过境免签、退税、上海…' : 'Search 12306, visa-free transit, Shanghai…'}
            maxlength="200"
            autofocus={!q}
          />
          <button type="submit" class="btn btn--primary">
            <span>{isZh ? '搜索' : 'Search'}</span>
          </button>
        </form>
      </search>

      {q && (
        <p class="search-summary">
          {isZh
            ? `找到 ${results.items.length} 条与「${q}」相关的结果`
            : `${results.items.length} ${results.items.length === 1 ? 'result' : 'results'} for “${q}”`}
        </p>
      )}

      {results.items.length > 0 ? (
        <div class="search-results">
          {results.items.map((item) => {
            const href = lp(
              item.collection === 'pages'
                ? pagePath(item.slug || item.id)
                : postPath(item.slug || item.id),
            );
            return (
              <article class="search-item">
                <div class="search-item-body">
                  <span class="meta-line">
                    {item.collection === 'pages'
                      ? (isZh ? '页面' : 'Page')
                      : (isZh ? '文章' : 'Article')}
                  </span>
                  <h2>
                    <a href={href}>{item.title}</a>
                  </h2>
                </div>
                <a href={href} class="icon-btn" aria-label={item.title}>
                  <Icon name="arrow" size={18} />
                </a>
              </article>
            );
          })}
        </div>
      ) : q ? (
        <div class="empty-panel">
          <h2>{isZh ? '未找到匹配的文章或页面。' : 'No matching articles found.'}</h2>
          <p>{isZh ? '可尝试更简短的关键词，或直接浏览全部文章。' : 'Try a broader keyword or browse all articles.'}</p>
          <div class="empty-actions">
            <a href={lp('/posts/')} class="btn">{isZh ? '全部文章' : 'All articles'}</a>
          </div>
        </div>
      ) : (rootCats.length > 0 || popularTags.length > 0) && (
        <div class="search-suggestions">
          {rootCats.length > 0 && (
            <div>
              <p class="search-suggest-label">{isZh ? '按栏目浏览' : 'Browse by topic'}</p>
              <div class="term-list">
                {rootCats.map((cat) => (
                  <a href={lp(categoryPath(cat.slug))} class="term-pill">{cat.label}</a>
                ))}
              </div>
            </div>
          )}
          {popularTags.length > 0 && (
            <div>
              <p class="search-suggest-label">{isZh ? '常用标签' : 'Popular tags'}</p>
              <div class="term-list">
                {popularTags.map((tag) => (
                  <a href={lp(tagPath(tag.slug))} class="term-pill">#{tag.label}</a>
                ))}
              </div>
            </div>
          )}
        </div>
      )}

      {q && (
        <Pagination
          basePath="/search/"
          hasCursor={Boolean(cursor)}
          nextCursor={results.nextCursor}
          query={{ q }}
        />
      )}
    </div>
  </div>
</Layout>
