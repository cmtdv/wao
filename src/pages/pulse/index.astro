---
/**
 * Mother Template 6: /pulse/ — Live Ground Pulse Field Reports & Weekly eSIM Top 5
 */
import BaseShell from '@layouts/BaseShell.astro';
import ResponsiveBreadcrumb from '../../components/nav/ResponsiveBreadcrumb.astro';
import GroundPulseForm from '@blocks/application/GroundPulseForm.astro';
import Badge from '@ui/data-display/Badge.astro';
import DataTable from '@ui/data-display/DataTable.astro';
import { LIVE_PULSE_REPORTS, WEEKLY_ESIM_TOP5 } from '@data/paradigm-e/collections';
import { ESIM_TOP5_ZH, PULSE_STATUS_LABELS, PULSE_ZH_MAP } from '@data/paradigm-e/i18n-zh';
import { getLocaleFromContext, localePath } from '@i18n/ui';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (p: string) => localePath(p, locale);
const esimRows = isZh ? ESIM_TOP5_ZH : WEEKLY_ESIM_TOP5;
---
<BaseShell
  title={isZh ? '现场实测动态' : 'Live Field Reports & Benchmarks'}
  description={isZh ? '访客近期实测的 240h 口岸、外卡刷卡、eSIM 稳定性与 12306 现场反馈。' : 'Recent traveler field reports on 240h visa ports, foreign card payments, eSIM rankings, and rail e-gates.'}
  persona="safety"
>
  <div class="container" style="padding-bottom:var(--space-8);max-width:64rem;">
    <ResponsiveBreadcrumb
      items={[
        { label: isZh ? '首页' : 'Home', href: lp('/') },
        { label: isZh ? '现场实测' : 'Field Reports' },
      ]}
      mobileBackHref={lp('/')}
      mobileBackLabel={isZh ? '首页' : 'Home'}
    />

    <header style="margin-bottom:var(--space-6);">
      <h1>{isZh ? '现场实测动态与榜单' : 'Live Field Reports & Benchmarks'}</h1>
      <p class="archive-lead" style="margin-top:0.4rem;">
        {isZh
          ? '查看近期各口岸通关、外卡支付与漫游 eSIM 的实测反馈，或快速提交你的最新体验。'
          : 'See what worked recently at Shanghai PVG, Chengdu Metro, and Railway 12306—or share your own field check.'}
      </p>
    </header>

    {/* Live Stream Timeline — unboxed hairline rows contrasting with DataTable below */}
    <section style="margin-bottom:var(--space-8);" aria-label={isZh ? '近期实测' : 'Recent field reports'}>
      {LIVE_PULSE_REPORTS.map((r) => {
        const zhR = PULSE_ZH_MAP[r.id];
        return (
          <article class="pe-editorial-row" style="display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:var(--space-3);">
            <div style="flex:1;min-width:16rem;">
              <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.45rem;margin-bottom:0.35rem;">
                <Badge tone={r.status === 'worked' ? 'verified' : r.status === 'partial' ? 'standby' : 'danger'}>
                  {PULSE_STATUS_LABELS[locale][r.status]}
                </Badge>
                <Badge tone="editorial">{isZh && zhR ? zhR.category : r.category}</Badge>
                <span style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--ink-secondary);">
                  {isZh && zhR ? `${zhR.passportOrCard} · ${zhR.location}` : `${r.passportOrCard} @ ${r.location}`}
                </span>
              </div>
              <p style="font-size:var(--text-base);color:var(--ink-primary);">
                {isZh && zhR ? zhR.summary : r.summary}
              </p>
            </div>
            <div style="text-align:end;font-family:var(--font-mono);font-size:var(--text-xs);color:var(--ink-tertiary);">
              <div>{isZh && zhR ? zhR.timestamp : r.timestamp}</div>
              <a href={lp(r.relatedHref)} class="text-link" style="display:inline-block;margin-top:0.35rem;">
                {isZh ? '相关指南 →' : 'Related Guide →'}
              </a>
            </div>
          </article>
        );
      })}
    </section>

    {/* Weekly Most Stable China eSIM Top 5 */}
    <section id="esim-top5" style="margin-bottom:var(--space-7);" aria-labelledby="esim-top5-h">
      <h2 id="esim-top5-h" style="margin-bottom:var(--space-3);">
        {isZh ? '本周实测稳定中国 eSIM 榜单' : 'This Week’s Most Reliable China eSIMs'}
      </h2>
      <DataTable
        id="pulse-esim-top5"
        caption={isZh ? '本周中国 eSIM 实测稳定性排行' : 'Weekly China eSIM Field Stability Ranking'}
        columns={[
          { key: 'rank', label: '#', rowHeader: true, sortable: false },
          { key: 'provider', label: isZh ? 'eSIM 方案' : 'Provider', sortable: false },
          { key: 'breakout', label: isZh ? '出口路由' : 'Breakout', sortable: false },
          { key: 'priceRef', label: isZh ? '参考价格' : 'Ref Price', sortable: false },
          { key: 'stability', label: isZh ? '本周实测可用率' : 'Field Stability', sortable: false },
        ]}
        rows={esimRows.map((row) => ({
          rank: row.rank,
          provider: row.provider,
          breakout: row.breakout,
          priceRef: row.priceRef,
          stability: { text: row.stability, badgeTone: 'verified' },
        }))}
      />
    </section>

    {/* Reuse Route A GroundPulseForm */}
    <section id="submit-pulse">
      <GroundPulseForm idPrefix="live-pulse" />
    </section>
  </div>
</BaseShell>
