---
import { getTaxonomyTermsWithCacheHint } from 'emdash';
import Layout from '@layouts/Layout.astro';
import PostCard from '@site/PostCard.astro';
import Pagination from '@site/Pagination.astro';
import Icon from '@site/Icon.astro';
import NewsletterBlock from '@site/NewsletterForm.astro';
import { getPublicPosts, publicContext, queryPage } from '@lib/cms';
import { cleanSearchQuery } from '@lib/format';
import { getLocaleFromContext, getStrings, localePath } from '@i18n/ui';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const strings = getStrings(locale);
const lp = (path: string) => localePath(path, locale);

const cursor = Astro.url.searchParams.get('cursor') || undefined;
const initialQ = cleanSearchQuery(Astro.url.searchParams.get('q'));
const initialTopic = Astro.url.searchParams.get('topic') || '';
const initialTag = Astro.url.searchParams.get('tag') || '';

const [{ result, invalidCursor }, categoriesRes, tagsRes] = await Promise.all([
  queryPage(() => getPublicPosts({ limit: 24, cursor, locale })),
  publicContext(() => getTaxonomyTermsWithCacheHint('category', { includeCounts: false, locale })),
  publicContext(() => getTaxonomyTermsWithCacheHint('tag', { includeCounts: false, locale })),
]);

if (invalidCursor) {
  return Astro.redirect(lp('/posts/'), 302);
}

if (!result || result.error) {
  return new Response('The article archive is temporarily unavailable.', { status: 503 });
}

if (Astro.cache?.enabled) {
  Astro.cache.set(result.cacheHint);
  Astro.cache.set(categoriesRes.cacheHint);
  Astro.cache.set(tagsRes.cacheHint);
}

type Term = (typeof categoriesRes.data)[number];
const flatten = (items: Term[]): Term[] =>
  items.flatMap((item) => [item, ...flatten(item.children ?? [])]);
const allCategories = flatten(categoriesRes.data);
const allTags = tagsRes.data.toSorted((a, b) => a.label.localeCompare(b.label, isZh ? 'zh-CN' : 'en'));
---
<Layout title={strings.posts.title} description={strings.posts.lead}>
  <div class="container archive-shell">
    <header class="archive-header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={lp('/')}>{isZh ? '首页' : 'Home'}</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">{isZh ? '全部文章' : 'Articles'}</span>
      </nav>
      <h1>{isZh ? '全部文章' : 'All articles'}</h1>
      <p class="archive-lead">{strings.posts.lead}</p>
    </header>

    <search aria-label={isZh ? '筛选文章' : 'Filter articles'}>
      <form class="finder-bar" action={lp('/posts/')} method="get" data-journal-finder>
        <div class="finder-field finder-field--search">
          <Icon name="search" size={16} />
          <label for="finder-q" class="visually-hidden">{isZh ? '按关键词筛选' : 'Filter by keyword'}</label>
          <input
            id="finder-q"
            name="q"
            type="search"
            value={initialQ}
            placeholder={isZh ? '筛选标题或摘要，如：12306、上海、茶、免签…' : 'Filter by keyword, e.g. 12306, Shanghai, tea…'}
            maxlength="120"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="none"
            spellcheck="false"
          />
        </div>

        <div class="finder-field finder-field--topic">
          <label for="finder-topic" class="visually-hidden">{isZh ? '按栏目筛选' : 'Filter by topic'}</label>
          <select id="finder-topic" name="topic" class="cw-select cw-select--bare">
            <option value="">{isZh ? '全部栏目' : 'All Topics'}</option>
            {allCategories.map((cat) => (
              <option value={cat.slug} selected={cat.slug === initialTopic}>
                {cat.parentId ? `— ${cat.label}` : cat.label}
              </option>
            ))}
          </select>
        </div>

        <div class="finder-field finder-field--tag">
          <label for="finder-tag" class="visually-hidden">{isZh ? '按标签筛选' : 'Filter by tag'}</label>
          <select id="finder-tag" name="tag" class="cw-select cw-select--bare">
            <option value="">{isZh ? '全部标签' : 'All Tags'}</option>
            {allTags.map((tag) => (
              <option value={tag.slug} selected={tag.slug === initialTag}>
                #{tag.label}
              </option>
            ))}
          </select>
        </div>

        <div class="finder-actions">
          <button type="button" class="finder-clear" data-finder-clear hidden>
            {isZh ? '清除' : 'Clear'}
          </button>
        </div>
      </form>
    </search>

    <div class="finder-status">
      <span data-finder-count>
        {isZh
          ? `共 ${result.entries.length} 篇文章`
          : `${result.entries.length} ${result.entries.length === 1 ? 'article' : 'articles'}`}
      </span>
    </div>

    {result.entries.length > 0 ? (
      <>
        <div class="post-grid">
          {result.entries.map((post) => (
            <PostCard post={post} />
          ))}
        </div>

        <div class="empty-panel" data-finder-empty hidden>
          <h2>{isZh ? '当前筛选条件下暂无匹配文章。' : 'No matching articles in this view.'}</h2>
          <p>{isZh ? '可清除上方筛选条件，或使用顶部搜索（⌘K）检索全文。' : 'Clear a filter above or use search (⌘K) across the full archive.'}</p>
          <div class="empty-actions">
            <a href={lp('/posts/')} class="btn">{isZh ? '重置筛选' : 'Reset filters'}</a>
          </div>
        </div>
      </>
    ) : (
      <div class="empty-panel">
        <h2>{isZh ? '本页暂无已发布文章。' : 'No published articles yet.'}</h2>
        <p>{isZh ? '请稍后回来查看或返回首页。' : 'Check back soon or return to the front page.'}</p>
      </div>
    )}

    <Pagination
      basePath="/posts/"
      hasCursor={Boolean(cursor)}
      nextCursor={result.nextCursor}
    />

    <div style="margin-top: var(--space-7);">
      <NewsletterBlock id="posts-newsletter-email" />
    </div>
  </div>
</Layout>
