---
import { decodeSlug, getSeoMeta, getTaxonomyTermsWithCacheHint } from 'emdash';
import { Image, PortableText } from 'emdash/ui';
import Layout from '@layouts/Layout.astro';
import PostCard from '@site/PostCard.astro';
import TableOfContents from '@site/TableOfContents.astro';
import Alert from '@ui/feedback/Alert.astro';
import { getPublicPost, getPublicPosts, publicContext } from '@lib/cms';
import { categoryPath, tagPath } from '@lib/format';
import { estimateReadingMinutes, extractToc } from '@lib/portable-text';
import { buildOrgPublisher } from '@lib/seo-geo';
import { formatLocalizedDate, formatReadTime, getLocaleFromContext, getStrings, localePath } from '@i18n/ui';
import '../../styles/article.css';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const strings = getStrings(locale);
const lp = (path: string) => localePath(path, locale);

const slug = decodeSlug(Astro.params.slug);
if (!slug) return new Response(null, { status: 404 });

const [result, catTreeRes] = await Promise.all([
  getPublicPost(slug, locale).catch(() => null),
  publicContext(() => getTaxonomyTermsWithCacheHint('category', { includeCounts: false, locale })).catch(() => null),
]);

if (!result || result.error) {
  return new Response('This article is temporarily unavailable.', { status: 503 });
}

const post = result.entry;
if (!post || post.data.status !== 'published') {
  return new Response(null, { status: 404 });
}

const isFallbackEnglish = isZh && result.fallbackLocale === 'en';

if (Astro.cache?.enabled) {
  Astro.cache.set(result.cacheHint);
  if (catTreeRes?.cacheHint) Astro.cache.set(catTreeRes.cacheHint);
}

const seo = getSeoMeta(post, {
  siteUrl: Astro.url.origin,
  path: Astro.locals.originalPathname ?? Astro.url.pathname,
});

// Resolve real parent -> child category hierarchy for Breadcrumb
type CatTreeTerm = NonNullable<typeof catTreeRes>['data'][number];
const flattenCats = (items: CatTreeTerm[]): CatTreeTerm[] =>
  items.flatMap((item) => [item, ...flattenCats(item.children ?? [])]);
const allTreeCats = catTreeRes ? flattenCats(catTreeRes.data) : [];
const catById = new Map(allTreeCats.map((c) => [c.id, c]));
const catBySlug = new Map(allTreeCats.map((c) => [c.slug, c]));

const rawCategories = post.data.terms?.category ?? [];
const tags = post.data.terms?.tag ?? [];

let breadcrumbCats: { slug: string; label: string }[] = [];
if (rawCategories.length > 0) {
  const leaf =
    rawCategories.find((c) => Boolean(catBySlug.get(c.slug)?.parentId)) ??
    rawCategories[0];
  const chain: { slug: string; label: string }[] = [];
  const visited = new Set<string>();
  let cursorTerm = catBySlug.get(leaf.slug);
  while (cursorTerm && !visited.has(cursorTerm.id)) {
    visited.add(cursorTerm.id);
    chain.unshift({ slug: cursorTerm.slug, label: cursorTerm.label });
    cursorTerm = cursorTerm.parentId ? catById.get(cursorTerm.parentId) : undefined;
  }
  breadcrumbCats = chain.length > 0 ? chain : [{ slug: leaf.slug, label: leaf.label }];
}

const primaryCategory = breadcrumbCats.at(-1) ?? rawCategories[0];

// Native EmDash 1.5 Bylines (reads real author avatar & displayName when assigned in /_emdash/admin)
const rawBylines = (post.data as unknown as {
  bylines?: Array<{
    displayName?: string;
    avatarStorageKey?: string | null;
    avatarAlt?: string | null;
    websiteUrl?: string | null;
  }>;
}).bylines;
const primaryByline = rawBylines?.[0];
const authorName = primaryByline?.displayName || (isZh ? 'ChinaWao 编辑部' : 'ChinaWao Editorial');
const authorAvatarSrc = primaryByline?.avatarStorageKey
  ? `/_emdash/api/media/file/${primaryByline.avatarStorageKey}`
  : null;
const authorInitial = authorName.trim().charAt(0).toUpperCase() || 'C';
const authorHref = primaryByline?.websiteUrl || lp('/pages/editorial-standards');
const isExternalAuthorLink = /^https?:\/\//i.test(authorHref);

const pubDate = post.data.publishedAt;
const updDate = post.data.updatedAt;
const isUpdated =
  Boolean(pubDate && updDate) &&
  pubDate!.toISOString().slice(0, 10) !== updDate!.toISOString().slice(0, 10);
const displayDate = formatLocalizedDate(isUpdated ? updDate : pubDate, locale);
const displayDateIso = (isUpdated ? updDate : pubDate)?.toISOString();

const readingMinutes = estimateReadingMinutes(post.data.content);
const estimatedSeconds = Math.max(45, (readingMinutes ?? 1) * 60);
const formatAudioTime = (sec: number) => {
  const m = Math.floor(sec / 60);
  const s = Math.floor(sec % 60);
  return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
};
const tocItems = extractToc(post.data.content);
const hasToc = tocItems.length > 0;

// Fetch up to 3 related/recent dispatches (preferring primary category)
const relatedResult = await getPublicPosts({
  limit: 4,
  locale,
  ...(primaryCategory ? { where: { category: primaryCategory.slug } } : {}),
}).catch(() => null);

let relatedPosts = (relatedResult?.entries ?? []).filter((entry) => entry.id !== post.id).slice(0, 3);
if (relatedPosts.length === 0 && primaryCategory) {
  const fallbackResult = await getPublicPosts({ limit: 4, locale }).catch(() => null);
  relatedPosts = (fallbackResult?.entries ?? []).filter((entry) => entry.id !== post.id).slice(0, 3);
}

const canonicalUrl = seo.canonical ?? `${Astro.url.origin}${lp(`/posts/${slug}`)}`;
const breadcrumbItems = [
  { name: isZh ? '首页' : 'Home', item: `${Astro.url.origin}${lp('/')}` },
  ...(breadcrumbCats.length > 0
    ? breadcrumbCats.map((c) => ({
        name: c.label,
        item: `${Astro.url.origin}${lp(categoryPath(c.slug))}`,
      }))
    : [{ name: isZh ? '全部文章' : 'Articles', item: `${Astro.url.origin}${lp('/posts/')}` }]),
  { name: post.data.title, item: canonicalUrl },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    buildOrgPublisher(Astro.url.origin),
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbItems.map((b, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: b.name,
        item: b.item,
      })),
    },
    {
      '@type': 'Article',
      '@id': `${canonicalUrl}#article`,
      headline: post.data.title,
      description: seo.description ?? post.data.excerpt ?? '',
      inLanguage: isZh ? 'zh-CN' : 'en',
      mainEntityOfPage: canonicalUrl,
      ...(pubDate ? { datePublished: pubDate.toISOString() } : {}),
      ...(updDate ? { dateModified: updDate.toISOString() } : {}),
      ...(primaryCategory ? { articleSection: primaryCategory.label } : {}),
      ...(tags.length > 0 ? { keywords: tags.map((t) => t.label).join(', ') } : {}),
      author: {
        '@type': primaryByline ? 'Person' : 'Organization',
        name: authorName,
        url: isExternalAuthorLink ? authorHref : `${Astro.url.origin}${authorHref}`,
      },
      publisher: { '@id': `${Astro.url.origin}/#organization` },
    },
  ],
};
---
<Layout
  title={seo.title ?? post.data.title}
  description={seo.description ?? post.data.excerpt ?? ''}
  pageTitle={seo.ogTitle}
  image={seo.ogImage}
  canonical={seo.canonical}
  robots={seo.robots}
  type="article"
  publishedTime={pubDate?.toISOString() ?? null}
  modifiedTime={updDate?.toISOString() ?? null}
  content={{ collection: 'posts', id: post.data.id, slug }}
  jsonLd={jsonLd}
>
  <div class="reading-progress" aria-hidden="true"></div>

  <div class="container">
    <div class:list={['article-shell', !hasToc && 'article-shell--single']}>
      <div class:list={['article-grid', hasToc && 'article-grid--with-toc']}>
        <article class="article-main">
          <header class="article-header">
            <nav class="breadcrumb" aria-label="Breadcrumb">
              <a href={lp('/')}>{isZh ? '首页' : 'Home'}</a>
              {breadcrumbCats.length > 0 ? (
                breadcrumbCats.map((cat) => (
                  <>
                    <span class="breadcrumb-sep" aria-hidden="true">/</span>
                    <a href={lp(categoryPath(cat.slug))}>{cat.label}</a>
                  </>
                ))
              ) : (
                <>
                  <span class="breadcrumb-sep" aria-hidden="true">/</span>
                  <a href={lp('/posts/')}>{isZh ? '全部文章' : 'Articles'}</a>
                </>
              )}
            </nav>

            {isFallbackEnglish && (
              <div style="margin-bottom: var(--space-4);">
                <Alert tone="info" title={strings.posts.fallbackNoticeTitle}>
                  {strings.posts.fallbackNoticeBody}
                </Alert>
              </div>
            )}

            <h1>{post.data.title}</h1>

            {post.data.excerpt && <p class="article-dek">{post.data.excerpt}</p>}

            <div class="article-byline-row">
              <div class="article-byline">
                <a
                  href={authorHref}
                  class="byline-author"
                  target={isExternalAuthorLink ? '_blank' : undefined}
                  rel={isExternalAuthorLink ? 'noopener noreferrer' : undefined}
                >
                  {authorAvatarSrc ? (
                    <img
                      src={authorAvatarSrc}
                      alt={primaryByline?.avatarAlt || authorName}
                      class="byline-avatar"
                      width="24"
                      height="24"
                      loading="eager"
                    />
                  ) : (
                    <span class="byline-avatar byline-avatar--fallback" aria-hidden="true">
                      {authorInitial}
                    </span>
                  )}
                  <span>{authorName}</span>
                </a>
                {displayDate && (
                  <>
                    <span class="byline-sep" aria-hidden="true">·</span>
                    <time datetime={displayDateIso}>
                      {isUpdated
                        ? (isZh ? `更新于 ${displayDate}` : `Updated ${displayDate}`)
                        : displayDate}
                    </time>
                  </>
                )}
                {readingMinutes && (
                  <>
                    <span class="byline-sep" aria-hidden="true">·</span>
                    <span>{formatReadTime(readingMinutes, locale)}</span>
                  </>
                )}
              </div>

              <div class="article-utility-strip" role="group" aria-label={isZh ? '文章操作' : 'Article actions'}>
                <button
                  type="button"
                  class="article-util-btn"
                  data-article-share
                  data-share-title={post.data.title}
                  data-share-url={canonicalUrl}
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
                    <polyline points="16 6 12 2 8 6" />
                    <line x1="12" y1="2" x2="12" y2="15" />
                  </svg>
                  <span>{isZh ? '分享' : 'Share'}</span>
                </button>
                <span class="article-util-sep" aria-hidden="true"></span>
                <button
                  type="button"
                  class="article-util-btn"
                  aria-pressed="false"
                  data-article-save
                  data-save-slug={slug}
                  data-save-title={post.data.title}
                  data-save-url={canonicalUrl}
                >
                  <svg class="icon-bookmark" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                  </svg>
                  <span data-save-label>{isZh ? '收藏' : 'Save'}</span>
                </button>
              </div>
            </div>
          </header>

          {/* Dual-Mode Article Audio Player (MP3 <audio> or automatic Web Speech fallback) */}
          <div
            class="article-audio-bar"
            role="region"
            aria-label={isZh ? '语音朗读本文' : 'Listen to this article'}
            data-article-audio
            data-audio-lang={isZh ? 'zh-CN' : 'en-US'}
            data-audio-est-sec={String(estimatedSeconds)}
          >
            <button
              type="button"
              class="audio-play-btn"
              aria-label={isZh ? '播放本文语音朗读' : 'Play article audio'}
              data-audio-toggle
            >
              <svg class="icon-play" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="6 4 20 12 6 20 6 4" />
              </svg>
              <svg class="icon-pause" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <rect x="6" y="4" width="4" height="16" rx="1" />
                <rect x="14" y="4" width="4" height="16" rx="1" />
              </svg>
            </button>

            <div class="audio-center">
              <div class="audio-label-row">
                <span class="audio-heading" data-audio-status>
                  {isZh ? '朗读本文' : 'Listen to this article'}
                </span>
                <span class="audio-time">
                  <span data-audio-current>00:00</span>
                  <span> / </span>
                  <span data-audio-duration>{formatAudioTime(estimatedSeconds)}</span>
                </span>
              </div>
              <div class="audio-track" aria-hidden="true">
                <div class="audio-progress" data-audio-progress style="width: 0%;"></div>
              </div>
            </div>

            <div class="audio-controls">
              <button
                type="button"
                class="audio-speed-btn"
                aria-label={isZh ? '切换朗读倍速' : 'Change playback speed'}
                data-audio-speed
              >
                1x
              </button>
              <button
                type="button"
                class="audio-stop-btn"
                aria-label={isZh ? '停止朗读' : 'Stop audio'}
                data-audio-stop
                hidden
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <rect x="5" y="5" width="14" height="14" rx="2" />
                </svg>
              </button>
            </div>
          </div>

          {post.data.featured_image && (
            <figure class="article-figure">
              <div class="article-figure-frame">
                <Image
                  image={post.data.featured_image}
                  sizes="(max-width: 960px) 100vw, 720px"
                  priority
                  placeholder={false}
                />
              </div>
              {post.data.featured_image.caption && (
                <figcaption>{post.data.featured_image.caption}</figcaption>
              )}
            </figure>
          )}

          <TableOfContents items={tocItems} variant="mobile" />

          <div class="prose" data-article-prose>
            {post.data.content?.length ? (
              <PortableText value={post.data.content} />
            ) : (
              <p>{isZh ? '该文章暂未发布正文内容。' : 'This article has no body content yet.'}</p>
            )}
          </div>

          <footer class="article-footer">
            {tags.length > 0 ? (
              <div class="term-list" aria-label={isZh ? '文章标签' : 'Article tags'}>
                {tags.map((term) => (
                  <a href={lp(tagPath(term.slug))} class="term-pill">#{term.label}</a>
                ))}
              </div>
            ) : <span />}

            <div class="article-footer-actions">
              <a href={lp('/pages/corrections-updates')} class="article-action-btn">
                {isZh ? '反馈规则变动' : 'Report update'}
              </a>
            </div>
          </footer>
        </article>

        <TableOfContents items={tocItems} variant="desktop" />
      </div>

      {relatedPosts.length > 0 && (
        <section class="related-section" aria-labelledby="related-heading">
          <div class="related-header">
            <h2 id="related-heading">{isZh ? '延伸阅读' : 'Further reading'}</h2>
          </div>
          <div class="post-grid">
            {relatedPosts.map((entry) => (
              <PostCard post={entry} headingLevel="h3" showExcerpt={false} />
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>
