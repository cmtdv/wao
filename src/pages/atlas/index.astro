---
/**
 * Mother Template 2: /atlas/ (Pillar 06 of 6) + Integrated v3.2 6×59 Master Taxonomy Index (#topic-index)
 */
import PillarHubLayout from '@layouts/PillarHubLayout.astro';
import Icon from '@site/Icon.astro';
import { PILLAR_BY_ID } from '@data/paradigm-e/pillars';
import { V32_PILLARS } from '@data/taxonomy-v32';
import { getLocaleFromContext, localePath } from '@i18n/ui';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (p: string) => localePath(p, locale);
---
<PillarHubLayout pillar={PILLAR_BY_ID.atlas}>
  {/* Complete v3.2 6×59 Master Taxonomy Index */}
  <section id="topic-index" class="v32-section-block" aria-labelledby="topic-index-h">
    <h2 id="topic-index-h">
      {isZh ? '全站 6 主柱 × 59 二级栏目全景索引（v3.2）' : 'Complete 6 Pillars × 59 Hubs Index (v3.2)'}
    </h2>
    <p class="v32-section-sub">
      {isZh
        ? '实时检索全部 59 个标准二级枢纽，点击直达对应栏目着陆页。'
        : 'Filter all 59 canonical v3.2 secondary hubs by keyword or code.'}
    </p>

    <search class="atlas-toolbar" style="margin-block:var(--space-2);">
      <label class="atlas-search" aria-label={isZh ? '筛选栏目' : 'Filter hubs'}>
        <Icon name="search" size={16} />
        <input
          type="search"
          data-atlas-filter
          placeholder={isZh ? '按关键词或编码筛选（如 T1、签证、支付、广交会、高铁、茶）…' : 'Filter by keyword or code (e.g. T1, visa, rail, Canton Fair, tea)…'}
          autocomplete="off"
        />
      </label>
    </search>

    <div style="display:grid;gap:var(--space-3);">
      {V32_PILLARS.map((tp) => (
        <details class="journey-step" data-atlas-pillar={tp.id} open={tp.id === 'travel' || tp.id === 'atlas'}>
          <summary>
            <span class="journey-step-head">
              <span class="journey-step-title">
                {tp.idx} · {isZh ? tp.navZh : tp.navEn}（{tp.children.length}）
              </span>
            </span>
          </summary>
          <div class="journey-step-body">
            <div class="pe-mega-chips">
              {tp.children.map((topic) => (
                <a
                  href={lp(topic.hubPath)}
                  class="pe-mega-chip"
                  data-atlas-topic
                  data-search={`${topic.code} ${topic.slug} ${topic.navEn} ${topic.navZh} ${topic.scopeZh} ${tp.navEn} ${tp.navZh}`.toLowerCase()}
                >
                  {topic.code} · {isZh ? topic.navZh : topic.navEn}
                </a>
              ))}
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>
</PillarHubLayout>
