---
/**
 * Mother Template 2: /atlas/ (Pillar 06 of 6) + Integrated v3.2 6×59 Master Taxonomy Index (#topic-index)
 */
import PillarHubLayout from '@layouts/PillarHubLayout.astro';
import Icon from '@site/Icon.astro';
import { PILLAR_BY_ID } from '@data/paradigm-e/pillars';
import { V32_PILLARS } from '@data/taxonomy-v32';
import { getLocaleFromContext, localePath } from '@i18n/ui';

const locale = getLocaleFromContext(Astro);
const isZh = locale === 'zh';
const lp = (p: string) => localePath(p, locale);
---
<PillarHubLayout pillar={PILLAR_BY_ID.atlas}>
  {/* Complete Master Topic Index */}
  <section id="topic-index" class="v32-section-block" aria-labelledby="topic-index-h">
    <h2 id="topic-index-h">
      {isZh ? '全站主题索引' : 'All Topics Directory'}
    </h2>

    <search class="atlas-toolbar" style="margin-block:var(--space-2);">
      <label class="atlas-search" aria-label={isZh ? '筛选主题' : 'Filter topics'}>
        <Icon name="search" size={16} />
        <input
          type="search"
          data-atlas-filter
          placeholder={isZh ? '按关键词筛选（如 签证、支付、广交会、高铁、茶）…' : 'Filter by keyword (e.g. visa, rail, Canton Fair, tea)…'}
          autocomplete="off"
        />
      </label>
    </search>

    <div style="display:grid;gap:var(--space-3);">
      {V32_PILLARS.map((tp) => (
        <details class="journey-step" data-atlas-pillar={tp.id} open={tp.id === 'travel' || tp.id === 'atlas'}>
          <summary>
            <span class="journey-step-head">
              <span class="journey-step-title">
                {isZh ? tp.navZh : tp.navEn}
              </span>
            </span>
          </summary>
          <div class="journey-step-body">
            <div class="pe-mega-chips">
              {tp.children.map((topic) => (
                <a
                  href={lp(topic.hubPath)}
                  class="pe-mega-chip"
                  data-atlas-topic
                  data-search={`${topic.slug} ${topic.navEn} ${topic.navZh} ${topic.scopeZh} ${tp.navEn} ${tp.navZh}`.toLowerCase()}
                >
                  {isZh ? topic.navZh : topic.navEn}
                </a>
              ))}
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>
</PillarHubLayout>
